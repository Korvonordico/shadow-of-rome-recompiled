+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+
+// sor: films at their own rate, in step with their sound. The game asks for a picture every 2nd vblank (at 50 Hz 3
+// every 5: classMOVIE_TASK::task_move, 0x308CA0), so it shows 30.00 pictures a second of its clock; every film on the
+// disc is 29.97 pictures a second and its sound lasts pictures / 29.97 seconds at 48000 samples a second. The sound
+// is made on the game's clock in real nanoseconds (iop_spu2.cpp), so the pictures ran 0.1% ahead of it (0.4 s at the
+// end of the longest film), and 1% with VSYNC in step on a 181.6 Hz screen (the clock at 181.6 / 3 = 60.53 Hz:
+// 4.4 s). While a film plays the game's clock now runs at the film's own rate (EeScheduler.cpp asks
+// sorFilmVblankNs), and each picture is checked against the samples the SPU has made since the film's first one: if
+// the two still part by more than 1.5 pictures (the game stopped, the sound waited) one picture is shown again or
+// left out. SOR_FILM_PACE=0: as before (the drift is still measured and written in the film's log line).
+extern std::atomic<uint64_t> g_sorSpuFatti;     // ps2xIOP iop_spu2.cpp: samples the SPU has made so far
+extern std::atomic<uint32_t> g_sorStreamSector; // CD.cpp: where the last CD stream started (the film's sector)
+extern std::atomic<uint32_t> g_sorVblankUs;     // EeScheduler.cpp: the game's own vblank (60 or 50 Hz)
+static std::atomic<int64_t> g_sorFilmPictureNs{0}; // the film on screen: its picture period (0: no film)
+static std::atomic<int64_t> g_sorFilmUltimoNs{0};  // when its last picture was handed over (steady clock)
+
+static int64_t sorFilmAdessoNs()
+{
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static bool sorFilmPaceOn()
+{
+    static const bool on = !(std::getenv("SOR_FILM_PACE") && std::getenv("SOR_FILM_PACE")[0] == '0');
+    return on;
+}
+
+// The vblank period that shows a film of this picture period at its own rate: the game shows 30 pictures every 60
+// vblanks (60 Hz) or every 50 (50 Hz). 0 if it makes no sense.
+static int64_t sorFilmVblankFor(int64_t pictureNs, uint32_t nominalUs)
+{
+    if (pictureNs <= 0 || nominalUs == 0u)
+        return 0;
+    const int64_t hz = (1000000 + static_cast<int64_t>(nominalUs) / 2) / static_cast<int64_t>(nominalUs); // 60 or 50
+    const int64_t ns = pictureNs * 30 / hz;
+    const int64_t own = static_cast<int64_t>(nominalUs) * 1000;
+    return ns > own / 2 && ns < own * 2 ? ns : 0;
+}
+
+// EeScheduler.cpp, at each vblank: while a film plays (its last picture less than 250 ms ago), the period that shows
+// it at its own rate (16.683 ms at 60 Hz, 20.02 ms at 50 for 29.97 films); 0: the game's usual one.
+int64_t sorFilmVblankNs(uint32_t nominalUs)
+{
+    if (!sorFilmPaceOn())
+        return 0;
+    const int64_t picture = g_sorFilmPictureNs.load(std::memory_order_relaxed);
+    const int64_t ultimo = g_sorFilmUltimoNs.load(std::memory_order_relaxed);
+    if (picture <= 0 || ultimo == 0 || sorFilmAdessoNs() - ultimo > 250000000)
+        return 0;
+    return sorFilmVblankFor(picture, nominalUs);
+}
 
