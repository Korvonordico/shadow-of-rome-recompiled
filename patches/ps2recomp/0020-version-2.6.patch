diff --git a/ps2xRuntime/include/runtime/sor_times.h b/ps2xRuntime/include/runtime/sor_times.h
new file mode 100755
index 0000000..f19d93d
--- /dev/null
+++ b/ps2xRuntime/include/runtime/sor_times.h
@@ -0,0 +1,112 @@
+// Where the game's time goes (the author, 10/11/2026: "make it as optimized as possible without losing quality").
+// A Scope placed at the top of a function adds the time spent inside it to one part: VU1 (the microprograms that turn
+// models into triangles, interpreted while playing), VIF1 (unpacking the data around them), GIF (the GS packets,
+// handed to sor-gs.dll), IOP (sound, disc and pad processor). Time is EXCLUSIVE: a part called from inside another
+// (VU1 inside VIF1, GIF inside VU1) is counted only in its own part. Every 5 s one "[sor-time]" line goes to the log,
+// in milliseconds per second of play: 1000 is a whole thread. What is missing up to 1000 on the game thread is the
+// translated game code plus the waiting for the next picture.
+// Only with SOR_TEMPI (tests): two clock reads per section, about 430,000 sections a second, cost roughly 3% of the
+// VIF thread (an estimate). Without it a Scope only checks one flag (10/11/2026).
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace sor_times
+{
+enum Part
+{
+    VU1 = 0,
+    VIF1,
+    GIF,
+    IOP,
+    PART_COUNT
+};
+
+inline std::atomic<int64_t> g_ns[PART_COUNT];    // exclusive nanoseconds of each part since the last line
+inline std::atomic<int64_t> g_calls[PART_COUNT]; // calls of each part since the last line
+inline std::atomic<int64_t> g_lastLine{0};       // steady clock of the last line (0: not started yet)
+inline std::atomic<int64_t> g_total_ns[PART_COUNT];    // the same, never reset (the VIF spikes, ps2_memory.cpp)
+inline std::atomic<int64_t> g_total_calls[PART_COUNT];
+inline const bool g_on = std::getenv("SOR_TEMPI") != nullptr; // the measure is on (tests only)
+
+inline int64_t now()
+{
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+struct Stack
+{
+    static constexpr int kDepth = 32;
+    int64_t children[kDepth];
+    int depth = 0;
+};
+inline thread_local Stack t_stack;
+
+inline void maybePrint(int64_t at)
+{
+    int64_t last = g_lastLine.load(std::memory_order_relaxed);
+    if (last == 0)
+    {
+        g_lastLine.compare_exchange_strong(last, at);
+        return;
+    }
+    const int64_t span = at - last;
+    if (span < 5000000000LL || !g_lastLine.compare_exchange_strong(last, at))
+        return;
+    const double seconds = span / 1e9;
+    double ms[PART_COUNT];
+    long long calls[PART_COUNT];
+    for (int i = 0; i < PART_COUNT; ++i)
+    {
+        ms[i] = g_ns[i].exchange(0) / 1e6 / seconds;
+        calls[i] = g_calls[i].exchange(0);
+    }
+    std::printf("[sor-time] last %.1f s, ms per second (1000 = a whole thread): vu1 %.0f (%lld runs), vif1 %.0f, "
+                "gif %.0f (%lld packets), iop %.0f; the rest of the game thread is game code + waiting\n",
+                seconds, ms[VU1], calls[VU1], ms[VIF1], ms[GIF], calls[GIF], ms[IOP]);
+    std::fflush(stdout);
+}
+
+class Scope
+{
+public:
+    explicit Scope(Part part) : m_part(part), m_start(g_on ? now() : 0)
+    {
+        if (!g_on)
+            return;
+        Stack &s = t_stack;
+        if (s.depth < Stack::kDepth)
+            s.children[s.depth] = 0;
+        ++s.depth;
+    }
+    ~Scope()
+    {
+        if (!g_on)
+            return;
+        const int64_t end = now();
+        const int64_t all = end - m_start;
+        Stack &s = t_stack;
+        --s.depth;
+        const int64_t children = s.depth < Stack::kDepth ? s.children[s.depth] : 0;
+        g_ns[m_part].fetch_add(all - children, std::memory_order_relaxed);
+        g_calls[m_part].fetch_add(1, std::memory_order_relaxed);
+        g_total_ns[m_part].fetch_add(all - children, std::memory_order_relaxed);
+        g_total_calls[m_part].fetch_add(1, std::memory_order_relaxed);
+        if (s.depth > 0 && s.depth - 1 < Stack::kDepth)
+            s.children[s.depth - 1] += all;
+        maybePrint(end);
+    }
+    Scope(const Scope &) = delete;
+    Scope &operator=(const Scope &) = delete;
+
+private:
+    Part m_part;
+    int64_t m_start;
+};
+} // namespace sor_times
diff --git a/ps2xRuntime/include/runtime/sor_vu1_host.h b/ps2xRuntime/include/runtime/sor_vu1_host.h
new file mode 100755
index 0000000..16f7253
--- /dev/null
+++ b/ps2xRuntime/include/runtime/sor_vu1_host.h
@@ -0,0 +1,40 @@
+// sor: a second VU1 engine outside the runtime, chosen with SOR_VU1 (pc/sor_vu1.cpp: PCSX2's microVU through
+// sor-vu.dll). Nothing is set by default: the runtime's own VU1 (VU1Interpreter and its fast path) runs as always.
+//
+// "pcsx2" mode: codeMem/dataMem are the host's VU1 micro and data memory (16 KB each, fixed for the life of the
+// process). PS2Memory::initialize() uses them instead of allocating its own and never frees them, and every MSCAL/MSCNT
+// runs on the host (run). MPG reports what it changed (codeWritten).
+// "confronto" (compare) mode: our VU1 drives the game; around some of its programs the runtime calls compareBefore
+// (before ours runs: true = compare this one, the host copies the starting state) and compareAfter (ours' result and
+// the GIF PATH1 packets ours sent, copied through g_sorVu1CopiaPacchetti).
+//
+// All hooks are called on the thread that runs the VIF1 command (the VIF thread, or the game thread).
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+struct VU1State;
+
+struct SorVu1Host
+{
+    uint8_t *codeMem = nullptr;
+    uint8_t *dataMem = nullptr;
+    // MSCAL (startPcBytes = byte address in micro memory) or MSCNT (startPcBytes = 0xFFFFFFFF). fbrst = VU0 FBRST as
+    // our VU1 reads it (bits 10/11 enable the D/T stop). Returns the VPU_STAT D/T bits (0x200 / 0x400) after the run.
+    uint32_t (*run)(uint32_t startPcBytes, uint32_t top, uint32_t itop, uint32_t fbrst, uint64_t codeGeneration) = nullptr;
+    // MPG changed micro memory bytes [offset, offset + bytes); codeGeneration is PS2Memory's VU1 code generation after
+    // the write. EE stores into micro memory only bump the generation (the host compares it at the next run).
+    void (*codeWritten)(uint32_t offset, uint32_t bytes, uint64_t codeGeneration) = nullptr;
+    // Compare mode (see above). startPcBytes 0xFFFFFFFF = MSCNT (ours continues at state.pc).
+    bool (*compareBefore)(const VU1State &state, const uint8_t *code, const uint8_t *data, uint64_t codeGeneration,
+                          uint32_t startPcBytes, uint32_t top, uint32_t itop, uint32_t fbrst) = nullptr;
+    void (*compareAfter)(const VU1State &state, const uint8_t *data,
+                         const std::vector<std::vector<uint8_t>> &packets) = nullptr;
+};
+
+// Before PS2Runtime::initialize() (PS2Memory takes the host's memory there). Defined in ps2_memory.cpp.
+void sorSetVu1Host(const SorVu1Host &host);
+const SorVu1Host &sorVu1Host();
+// While set on a thread, every GIF PATH1 packet submitted on that thread is also copied here (compare mode).
+extern thread_local std::vector<std::vector<uint8_t>> *g_sorVu1CopiaPacchetti;
