+// sor: fast UNPACK (10/11/2026, the author: "as optimized as possible without losing quality").
+// The generic loop (now sor_unpack::generic, unchanged) decided format, mask, mode and address again for every
+// single vector, with two divisions each time: in the busiest places the VIF1 part took a quarter of the VIF
+// thread. Here those decisions are taken once per UNPACK and every format has its own loop (fastLoop).
+// The result must be identical to the generic loop, bit for bit. With SOR_UNPACKVERIFICA=1 (tests) the first 64
+// commands of every kind and then one in 256 are run with both, the generic one on a copy, and compared; a difference
+// is written in the log ("[sor-unpack] DIFFERENCE") and the generic result is kept. Every 5 s one "[sor-unpack]" line
+// counts them.
+namespace sor_unpack
+{
+struct Cmd
+{
+    uint32_t vn = 0u, vl = 0u;
+    bool maskEnable = false;
+    bool zeroExtend = false;
+    uint32_t writeVectorCount = 0u;
+    uint32_t sourceVectorCount = 0u;
+    uint32_t bytesPerVector = 0u;
+    uint32_t cl = 1u, wl = 1u;
+    uint32_t vuAddr = 0u;
+    uint32_t mask = 0u;
+    uint32_t mode = 0u;
+    const uint32_t *col = nullptr;
+};
+
+static_assert(PS2_VU1_DATA_SIZE == 0x4000u, "fastLoop writes (address & 0x3FF) * 16 without the size check");
+
+// The old loop, word for word (vif1_regs -> c / row, m_vu1Data -> vu).
+static void generic(const Cmd &c, const uint8_t *srcBase, uint8_t *vu, uint32_t *row)
+{
+    const uint8_t vn = static_cast<uint8_t>(c.vn);
+    const uint8_t vl = static_cast<uint8_t>(c.vl);
+    const bool maskEnable = c.maskEnable;
+    const int components = vn + 1;
+    const uint32_t bytesPerVector = c.bytesPerVector;
+    const uint32_t writeVectorCount = c.writeVectorCount;
+    const uint32_t cl = c.cl;
+    const uint32_t wl = c.wl;
+    const uint32_t sourceVectorCount = c.sourceVectorCount;
+    const uint32_t vuAddr = c.vuAddr;
+    const bool zeroExtend = c.zeroExtend;
+    uint32_t srcIndex = 0u;
+    for (uint32_t writeIndex = 0; writeIndex < writeVectorCount; ++writeIndex)
+    {
+        const uint32_t cyclePos = writeIndex % wl;
+        const bool sourceAvailable = (cl >= wl) || (cyclePos < cl);
+
+        uint32_t destVec = 0;
+        if (cl >= wl)
+        {
+            destVec = (vuAddr + (writeIndex / wl) * cl + cyclePos) & 0x3FFu;
+        }
+        else
+        {
+            destVec = (vuAddr + writeIndex) & 0x3FFu;
+        }
+
+        uint32_t destOff = destVec * 16u;
+        if (destOff + 16u > PS2_VU1_DATA_SIZE)
+        {
+            if (sourceAvailable && srcIndex < sourceVectorCount)
+                ++srcIndex;
+            continue;
+        }
+
+        uint32_t lanes[4] = {0u, 0u, 0u, 0u};
+        std::memcpy(lanes, vu + destOff, sizeof(lanes));
+        uint32_t decompressed[4] = {lanes[0], lanes[1], lanes[2], lanes[3]};
+        bool decoded = false;
+
+        const uint8_t *srcVec = nullptr;
+        if (sourceAvailable && srcIndex < sourceVectorCount)
+        {
+            srcVec = srcBase + srcIndex * bytesPerVector;
+            ++srcIndex;
+            decoded = true;
+        }
+
+        auto extend16 = [&](uint16_t raw) -> uint32_t
+        {
+            if (zeroExtend)
+                return static_cast<uint32_t>(raw);
+            return static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(raw)));
+        };
+
+        auto extend8 = [&](uint8_t raw) -> uint32_t
+        {
+            if (zeroExtend)
+                return static_cast<uint32_t>(raw);
+            return static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(raw)));
+        };
+
+        bool handledFormat = true;
+        if (!decoded)
+        {
+            handledFormat = false;
+        }
+        else if (vl == 0u)
+        {
+            if (components == 1)
+            {
+                uint32_t scalar = 0;
+                std::memcpy(&scalar, srcVec, sizeof(scalar));
+                decompressed[0] = scalar;
+                decompressed[1] = scalar;
+                decompressed[2] = scalar;
+                decompressed[3] = scalar;
+            }
+            else
+            {
+                const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                for (uint32_t c = 0; c < limit; ++c)
+                {
+                    uint32_t scalar = 0;
+                    std::memcpy(&scalar, srcVec + c * 4u, sizeof(scalar));
+                    decompressed[c] = scalar;
+                }
+            }
+        }
+        else if (vl == 1u)
+        {
+            if (components == 1)
+            {
+                uint16_t raw = 0;
+                std::memcpy(&raw, srcVec, sizeof(raw));
+                const uint32_t scalar = extend16(raw);
+                decompressed[0] = scalar;
+                decompressed[1] = scalar;
+                decompressed[2] = scalar;
+                decompressed[3] = scalar;
+            }
+            else
+            {
+                const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                for (uint32_t c = 0; c < limit; ++c)
+                {
+                    uint16_t raw = 0;
+                    std::memcpy(&raw, srcVec + c * 2u, sizeof(raw));
+                    decompressed[c] = extend16(raw);
+                }
+            }
+        }
+        else if (vl == 2u)
+        {
+            if (components == 1)
+            {
+                const uint32_t scalar = extend8(srcVec[0]);
+                decompressed[0] = scalar;
+                decompressed[1] = scalar;
+                decompressed[2] = scalar;
+                decompressed[3] = scalar;
+            }
+            else
+            {
+                const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                for (uint32_t c = 0; c < limit; ++c)
+                {
+                    decompressed[c] = extend8(srcVec[c]);
+                }
+            }
+        }
+        else if (vl == 3u && vn == 3u)
+        {
+            // V4-5: packed color-like format in a single 16-bit value.
+            uint16_t packed = 0;
+            std::memcpy(&packed, srcVec, sizeof(packed));
+            // sor: sulla console 5 bit diventano 8 (<<3) e il bit alto vale 0x80. Il microcodice dei
+            // personaggi usa questi valori come pesi delle ossa (x 1/248): piu' piccoli li deformava.
+            decompressed[0] = (packed & 0x1Fu) << 3;
+            decompressed[1] = ((packed >> 5) & 0x1Fu) << 3;
+            decompressed[2] = ((packed >> 10) & 0x1Fu) << 3;
+            decompressed[3] = ((packed >> 15) & 0x01u) << 7;
+        }
+        else
+        {
+            handledFormat = false;
+        }
+
+        // Unknown compressed format fallback: preserve legacy raw-copy behavior.
+        if (!handledFormat && decoded && !maskEnable && (c.mode == 0u || c.mode == 3u))
+        {
+            uint32_t copyBytes = (bytesPerVector < 16u) ? bytesPerVector : 16u;
+            std::memcpy(vu + destOff, srcVec, copyBytes);
+            continue;
+        }
+
+        const bool canAdd = (vl != 3u || vn != 3u);
+        const uint32_t mode = c.mode & 3u;
+        const uint32_t colIdx = (cyclePos > 3u) ? 3u : cyclePos;
+        const uint32_t maskCycle = (cyclePos > 3u) ? 3u : cyclePos;
+
+        for (uint32_t field = 0u; field < 4u; ++field)
+        {
+            uint32_t maskSpec = 0u;
+            if (maskEnable)
+            {
+                const uint32_t shift = ((maskCycle * 4u) + field) * 2u;
+                maskSpec = (c.mask >> shift) & 0x3u;
+            }
+
+            // In fill-write cycles with suspended source reads, treat raw-data selections as row-fill.
+            if (!decoded && maskSpec == 0u)
+                maskSpec = 1u;
+
+            uint32_t writeVal = lanes[field];
+            if (maskSpec == 0u)
+            {
+                if (handledFormat)
+                {
+                    writeVal = decompressed[field];
+                    if (canAdd && (mode == 1u || mode == 2u))
+                    {
+                        writeVal = writeVal + row[field];
+                        if (mode == 2u)
+                            row[field] = writeVal;
+                    }
+                }
+            }
+            else if (maskSpec == 1u)
+            {
+                writeVal = row[field];
+            }
+            else if (maskSpec == 2u)
+            {
+                writeVal = c.col[colIdx];
+            }
+            else
+            {
+                continue; // write-protect
+            }
+
+            lanes[field] = writeVal;
+        }
+
+        std::memcpy(vu + destOff, lanes, sizeof(lanes));
+    }
+
+}
+
+template <uint32_t VN, uint32_t VL>
+static inline void decode(const uint8_t *s, bool zeroExtend, uint32_t *d)
+{
+    if constexpr (VL == 0u)
+    {
+        if constexpr (VN == 0u)
+        {
+            uint32_t v;
+            std::memcpy(&v, s, 4u);
+            d[0] = v;
+            d[1] = v;
+            d[2] = v;
+            d[3] = v;
+        }
+        else
+            std::memcpy(d, s, (VN + 1u) * 4u);
+    }
+    else if constexpr (VL == 1u)
+    {
+        auto ext = [zeroExtend](const uint8_t *p) -> uint32_t
+        {
+            uint16_t r;
+            std::memcpy(&r, p, 2u);
+            return zeroExtend ? static_cast<uint32_t>(r) : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(r)));
+        };
+        if constexpr (VN == 0u)
+        {
+            const uint32_t v = ext(s);
+            d[0] = v;
+            d[1] = v;
+            d[2] = v;
+            d[3] = v;
+        }
+        else
+            for (uint32_t i = 0u; i <= VN; ++i)
+                d[i] = ext(s + i * 2u);
+    }
+    else if constexpr (VL == 2u)
+    {
+        auto ext = [zeroExtend](uint8_t r) -> uint32_t
+        {
+            return zeroExtend ? static_cast<uint32_t>(r) : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(r)));
+        };
+        if constexpr (VN == 0u)
+        {
+            const uint32_t v = ext(s[0]);
+            d[0] = v;
+            d[1] = v;
+            d[2] = v;
+            d[3] = v;
+        }
+        else
+            for (uint32_t i = 0u; i <= VN; ++i)
+                d[i] = ext(s[i]);
+    }
+    else
+    {
+        // V4-5, same as the generic loop: 5 bits become 8 (<<3), the top bit is worth 0x80.
+        uint16_t p;
+        std::memcpy(&p, s, 2u);
+        d[0] = (p & 0x1Fu) << 3;
+        d[1] = ((p >> 5) & 0x1Fu) << 3;
+        d[2] = ((p >> 10) & 0x1Fu) << 3;
+        d[3] = ((p >> 15) & 0x01u) << 7;
+    }
+}
+
+constexpr uint32_t vectorBytes(uint32_t vn, uint32_t vl)
+{
+    return (vl == 3u && vn == 3u) ? 2u : (vn + 1u) * (vl == 0u ? 4u : vl == 1u ? 2u : 1u);
+}
+
+template <uint32_t VN, uint32_t VL>
+static void fastLoop(const Cmd &c, const uint8_t *src, uint8_t *vu, uint32_t *row)
+{
+    constexpr bool kV45 = (VL == 3u && VN == 3u);
+    constexpr uint32_t kBpv = vectorBytes(VN, VL);
+    const uint32_t cl = c.cl, wl = c.wl, vuAddr = c.vuAddr;
+    const uint32_t count = c.writeVectorCount, sourceCount = c.sourceVectorCount;
+    const uint32_t mode = c.mode & 3u;
+    const bool add = !kV45 && (mode == 1u || mode == 2u);
+    const bool simple = !c.maskEnable && !add;
+    const bool blocks = cl >= wl; // cl >= wl: blocks of wl vectors every cl; otherwise fill cycles
+    uint32_t srcIndex = 0u, cyclePos = 0u, blockBase = 0u;
+    for (uint32_t w = 0u; w < count; ++w)
+    {
+        const uint32_t destVec = (vuAddr + (blocks ? blockBase + cyclePos : w)) & 0x3FFu;
+        const bool sourceAvailable = blocks || cyclePos < cl;
+        uint8_t *dst = vu + destVec * 16u;
+        const bool decoded = sourceAvailable && srcIndex < sourceCount;
+        if (decoded && simple)
+        {
+            uint32_t d[4];
+            if constexpr (VN == 1u || VN == 2u) // V2 and V3 keep the old z/w (or w)
+                std::memcpy(d, dst, 16u);
+            decode<VN, VL>(src + srcIndex * kBpv, c.zeroExtend, d);
+            std::memcpy(dst, d, 16u);
+            ++srcIndex;
+        }
+        else
+        {
+            uint32_t lanes[4];
+            std::memcpy(lanes, dst, 16u);
+            uint32_t d[4] = {lanes[0], lanes[1], lanes[2], lanes[3]};
+            if (decoded)
+            {
+                decode<VN, VL>(src + srcIndex * kBpv, c.zeroExtend, d);
+                ++srcIndex;
+            }
+            const uint32_t mc = cyclePos > 3u ? 3u : cyclePos;
+            for (uint32_t f = 0u; f < 4u; ++f)
+            {
+                uint32_t ms = c.maskEnable ? (c.mask >> ((mc * 4u + f) * 2u)) & 3u : 0u;
+                if (!decoded && ms == 0u)
+                    ms = 1u;
+                uint32_t v = lanes[f];
+                if (ms == 0u)
+                {
+                    v = d[f];
+                    if (add)
+                    {
+                        v += row[f];
+                        if (mode == 2u)
+                            row[f] = v;
+                    }
+                }
+                else if (ms == 1u)
+                    v = row[f];
+                else if (ms == 2u)
+                    v = c.col[mc];
+                else
+                    continue; // write-protect
+                lanes[f] = v;
+            }
+            std::memcpy(dst, lanes, 16u);
+        }
+        if (++cyclePos == wl)
+        {
+            cyclePos = 0u;
+            blockBase += cl;
+        }
+    }
+}
+
+static bool fast(const Cmd &c, const uint8_t *src, uint8_t *vu, uint32_t *row)
+{
+    if (c.vn > 3u || c.vl > 3u || c.bytesPerVector != vectorBytes(c.vn, c.vl))
+        return false;
+    switch (c.vl * 4u + c.vn)
+    {
+    case 0u: fastLoop<0u, 0u>(c, src, vu, row); return true;
+    case 1u: fastLoop<1u, 0u>(c, src, vu, row); return true;
+    case 2u: fastLoop<2u, 0u>(c, src, vu, row); return true;
+    case 3u: fastLoop<3u, 0u>(c, src, vu, row); return true;
+    case 4u: fastLoop<0u, 1u>(c, src, vu, row); return true;
+    case 5u: fastLoop<1u, 1u>(c, src, vu, row); return true;
+    case 6u: fastLoop<2u, 1u>(c, src, vu, row); return true;
+    case 7u: fastLoop<3u, 1u>(c, src, vu, row); return true;
+    case 8u: fastLoop<0u, 2u>(c, src, vu, row); return true;
+    case 9u: fastLoop<1u, 2u>(c, src, vu, row); return true;
+    case 10u: fastLoop<2u, 2u>(c, src, vu, row); return true;
+    case 11u: fastLoop<3u, 2u>(c, src, vu, row); return true;
+    case 15u: fastLoop<3u, 3u>(c, src, vu, row); return true;
+    default: return false; // vl 3 with vn 0-2: not real formats, the generic loop keeps its old raw copy
+    }
+}
+
+static std::atomic<uint64_t> s_fast{0}, s_generic{0}, s_checked{0}, s_differences{0}, s_allDifferences{0};
+static std::atomic<uint64_t> s_commands{0};
+static std::atomic<uint32_t> s_kind[512];
+static std::atomic<int64_t> s_lastLine{0};
+
+static void printKind(const Cmd &c, uint32_t kind, bool handled)
+{
+    static const char *const kSize[4] = {"32", "16", "8", "5"};
+    char name[16];
+    if (c.vn == 0u)
+        std::snprintf(name, sizeof(name), "S-%s", kSize[c.vl & 3u]);
+    else
+        std::snprintf(name, sizeof(name), "V%u-%s", c.vn + 1u, kSize[c.vl & 3u]);
+    std::printf("[sor-unpack] new kind %u: %s%s, mode %u, cl %u wl %u, %s\n", kind, name,
+                c.maskEnable ? " with mask" : "", c.mode & 3u, c.cl, c.wl, handled ? "fast way" : "generic way");
+    std::fflush(stdout);
+}
+
+static void maybePrint()
+{
+    const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            std::chrono::steady_clock::now().time_since_epoch())
+                            .count();
+    int64_t last = s_lastLine.load(std::memory_order_relaxed);
+    if (last == 0)
+    {
+        s_lastLine.compare_exchange_strong(last, now);
+        return;
+    }
+    if (now - last < 5000000000LL || !s_lastLine.compare_exchange_strong(last, now))
+        return;
+    std::printf("[sor-unpack] last %.1f s: %llu fast, %llu generic, %llu checked against the old way, %llu differences "
+                "(since the start %llu)\n",
+                (now - last) / 1e9, static_cast<unsigned long long>(s_fast.exchange(0)),
+                static_cast<unsigned long long>(s_generic.exchange(0)), static_cast<unsigned long long>(s_checked.exchange(0)),
+                static_cast<unsigned long long>(s_differences.exchange(0)),
+                static_cast<unsigned long long>(s_allDifferences.load()));
+    std::fflush(stdout);
+}
+
+static void run(const Cmd &c, const uint8_t *src, uint8_t *vu, uint32_t *row)
+{
+    // The comparison with the old way costs time: only with SOR_UNPACKVERIFICA=1 (tests). Without it the fast way runs
+    // alone (10/11/2026: 0 differences in about 170,000 commands compared while playing and in 325,219 random ones
+    // outside the game).
+    static const bool s_check = []
+    {
+        const char *e = std::getenv("SOR_UNPACKVERIFICA");
+        return e && e[0] == '1';
+    }();
+    if (!s_check)
+    {
+        if (!fast(c, src, vu, row))
+            generic(c, src, vu, row);
+        return;
+    }
+    const uint32_t clKind = c.cl == c.wl ? 0u : (c.cl > c.wl ? 1u : 2u);
+    const uint32_t kind = (c.vn & 3u) | ((c.vl & 3u) << 2) | (c.maskEnable ? 16u : 0u) | ((c.mode & 3u) << 5) | (clKind << 7);
+    const uint32_t seen = s_kind[kind].fetch_add(1u, std::memory_order_relaxed);
+    const uint64_t number = s_commands.fetch_add(1u, std::memory_order_relaxed);
+    const bool handled = c.vn <= 3u && c.vl <= 3u && !(c.vl == 3u && c.vn != 3u);
+    if (seen == 0u)
+        printKind(c, kind, handled);
+    if ((number & 1023u) == 0u)
+        maybePrint();
+
+    if (!handled)
+    {
+        generic(c, src, vu, row);
+        s_generic.fetch_add(1u, std::memory_order_relaxed);
+        return;
+    }
+    if (seen < 64u || (number & 255u) == 0u)
+    {
+        static thread_local uint8_t s_copy[PS2_VU1_DATA_SIZE];
+        uint32_t rowCopy[4];
+        std::memcpy(s_copy, vu, PS2_VU1_DATA_SIZE);
+        std::memcpy(rowCopy, row, sizeof(rowCopy));
+        generic(c, src, s_copy, rowCopy);
+        const bool done = fast(c, src, vu, row);
+        s_checked.fetch_add(1u, std::memory_order_relaxed);
+        if (!done || std::memcmp(s_copy, vu, PS2_VU1_DATA_SIZE) != 0 || std::memcmp(rowCopy, row, sizeof(rowCopy)) != 0)
+        {
+            const uint64_t all = s_allDifferences.fetch_add(1u, std::memory_order_relaxed);
+            s_differences.fetch_add(1u, std::memory_order_relaxed);
+            if (all < 8u)
+            {
+                uint32_t at = 0u;
+                while (at < PS2_VU1_DATA_SIZE && s_copy[at] == vu[at])
+                    ++at;
+                std::printf("[sor-unpack] DIFFERENCE kind %u (vn %u vl %u mask %u mode %u cl %u wl %u num %u addr 0x%x): "
+                            "first different byte %u%s, the old way's result is kept\n",
+                            kind, c.vn, c.vl, c.maskEnable ? 1u : 0u, c.mode, c.cl, c.wl, c.writeVectorCount, c.vuAddr, at,
+                            done ? "" : " (fast way refused)");
+                std::fflush(stdout);
+            }
+            std::memcpy(vu, s_copy, PS2_VU1_DATA_SIZE);
+            std::memcpy(row, rowCopy, sizeof(rowCopy));
+        }
+        s_fast.fetch_add(1u, std::memory_order_relaxed);
+        return;
+    }
+    if (!fast(c, src, vu, row))
+    {
+        generic(c, src, vu, row);
+        s_generic.fetch_add(1u, std::memory_order_relaxed);
+        return;
+    }
+    s_fast.fetch_add(1u, std::memory_order_relaxed);
+}
