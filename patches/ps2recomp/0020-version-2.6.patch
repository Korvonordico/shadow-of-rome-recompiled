+// sor: the same queue without the skip rule, for the smooth audio (pc/sor_audio.cpp, SOR_AUDIO_STRETCH): there the
+// queue is kept near its target by playing a little slower or faster instead. coppie == nullptr: the frames are
+// dropped (the oldest).
+size_t sorSpu2PrendiLiscio(int16_t *coppie, size_t n)
+{
+    const size_t f = g_fondo.load(std::memory_order_relaxed);
+    const size_t quanti = std::min(n, g_testa.load(std::memory_order_acquire) - f);
+    if (coppie)
+        for (size_t i = 0; i < quanti; ++i)
+        {
+            coppie[i * 2u] = g_coda[((f + i) & (kCoda - 1u)) * 2u];
+            coppie[i * 2u + 1u] = g_coda[((f + i) & (kCoda - 1u)) * 2u + 1u];
+        }
+    g_fondo.store(f + quanti, std::memory_order_release);
+    return quanti;
+}
 
