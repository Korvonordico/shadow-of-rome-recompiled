+// sor (14/11/2026): VU FTOI saturates: +2^31 and more give 0x7FFFFFFF, as on the PS2 (PCSX2 does the same). SSE
+// gives 0x80000000 there, so a far point (Vu0_rot_trans_pers_NClip: near the camera plane) jumped to the other
+// side of the screen and stretched the polygon (arena 105, the crowd).
+inline __m128i ps2_vftoi(__m128 s)
+{
+    const __m128i r = _mm_cvttps_epi32(s);
+    const __m128i over = _mm_castps_si128(_mm_cmpge_ps(s, _mm_set1_ps(2147483648.0f)));
+    return _mm_xor_si128(r, over);
+}
 #define PS2_VBLEND(a, b, mask) PS2_BLENDV_PS((__m128)(a), (__m128)(b), (__m128)(mask))
 
