+// sor: test remote control "vram" (pc/sor_prove.cpp): at the next vblank the whole GS memory goes to <SOR_FOTO>_vramN.bin,
+// the same moment a PCSX2 GS dump saves as its start state (strumenti/acqua2/vramcmp.py compares the two)
+std::atomic<bool> g_sorVramChiesta{false};
+
 void GS::sorVblank()
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     sorGpuMirrorVblank(m_privRegs);
+    if (m_backend && g_sorVramChiesta.exchange(false))
+    {
+        static unsigned s_n = 0;
+        std::vector<uint8_t> mem;
+        m_backend->SnapshotVram(mem); // the band renderer finishes its queue first
+        const char *pre = std::getenv("SOR_FOTO");
+        char nome[300];
+        std::snprintf(nome, sizeof(nome), "%s_vram%u.bin", pre ? pre : "gs", ++s_n);
+        FILE *f = std::fopen(nome, "wb");
+        if (f)
+        {
+            std::fwrite(mem.data(), 1, mem.size(), f);
+            std::fclose(f);
+        }
+        std::printf("[sor] vram: %zu bytes in %s%s\n", mem.size(), nome, f ? "" : " (NOT written)");
+        std::fflush(stdout);
+    }
     if (m_backend)
         m_backend->SegnaVblank();
 }
