+// sor (sor-sfarfallio, 16/11/2026): the game's drawing chain (VIF1, one per frame, through its ordering table) always
+// ends on the END tag of the table. In area 088, after area 081, every other chain stopped instead on a REFE tag in the
+// middle (16238 tags instead of 17550): everything after it (the rest of the shadows, the HUD, the fog, menus and text)
+// was never drawn on those frames, which is the flicker. A VIF1 chain that ends on a REFE is counted here (the black
+// box reads g_sorCateneTagliate) and reported at most every 5 s with the tags read just before it.
+std::atomic<uint64_t> g_sorCateneTagliate{0};
+std::atomic<uint64_t> g_sorCateneVif1{0};
+static void sorControllaCatena(uint32_t head, int tags, size_t bytes, uint32_t lastId, uint64_t lastHi,
+                               const uint32_t *addr, const uint64_t *tag)
+{
+    g_sorCateneVif1.fetch_add(1u, std::memory_order_relaxed);
+    if (lastId != 0u)
+        return;
+    const uint64_t cut = g_sorCateneTagliate.fetch_add(1u, std::memory_order_relaxed) + 1u;
+    static std::chrono::steady_clock::time_point s_last{};
+    static uint64_t s_chainsThen = 0u, s_cutThen = 0u;
+    const auto now = std::chrono::steady_clock::now();
+    if (s_cutThen != 0u && now - s_last < std::chrono::seconds(5))
+        return;
+    const uint64_t chains = g_sorCateneVif1.load(std::memory_order_relaxed);
+    std::printf("[sor-catena] VIF1 drawing chain cut short: %llu of the last %llu chains (%llu in all); this one from %x, %d tags, "
+                "%zu bytes, stopped on a REFE tag at %x (%016llx %016llx); tags before it: %x %016llx, %x %016llx, %x %016llx\n",
+                static_cast<unsigned long long>(cut - s_cutThen), static_cast<unsigned long long>(chains - s_chainsThen),
+                static_cast<unsigned long long>(cut), head, tags, bytes, addr[0], static_cast<unsigned long long>(tag[0]),
+                static_cast<unsigned long long>(lastHi), addr[1], static_cast<unsigned long long>(tag[1]), addr[2],
+                static_cast<unsigned long long>(tag[2]), addr[3], static_cast<unsigned long long>(tag[3]));
+    std::fflush(stdout);
+    s_last = now;
+    s_chainsThen = chains;
+    s_cutThen = cut;
+}
