+    uint32_t IopSpu2::indiceRiverbero(const Core &core, uint32_t base, int32_t scarto) const
+    {
+        const uint32_t inizio = core.esa & 0x3FFFFFu;
+        const uint32_t fine = (core.eea & 0x3FFFFFu) | 0xFFFFu;
+        const uint32_t x = (static_cast<uint32_t>(m_ciclo >> 1u) + base + static_cast<uint32_t>(scarto)) % (fine - inizio + 1u);
+        return (x + inizio) & (kRamParole - 1u);
+    }
+
+    // Il riverbero del chip: lo stesso calcolo di PCSX2 (V_Core::DoReverb). A ogni campione lavora un canale solo, a turno.
+    // Non c'e' l'interruzione sulla memoria del riverbero.
+    void IopSpu2::riverbero(int c, int32_t inL, int32_t inR, int32_t &fuoriL, int32_t &fuoriR)
+    {
+        Core &core = m_core[static_cast<size_t>(c)];
+        fuoriL = fuoriR = 0;
+        if (core.esa >= core.eea)
+            return;
+        const uint32_t b = static_cast<uint32_t>(c) << 10u;
+        const uint32_t bv = static_cast<uint32_t>(c) * 0x28u;
+        const bool acceso = (reg(0x19Au + b) & 0x80u) != 0u;
+        const int32_t evolL = volumeFisso(reg(0x764u + bv)), evolR = volumeFisso(reg(0x766u + bv));
+        if (!acceso && evolL == 0 && evolR == 0)
+            return;
+        const auto reg32 = [&](uint32_t o) { return (static_cast<uint32_t>(reg(o + b)) << 16u) | reg(o + 2u + b); };
+        const auto coef = [&](uint32_t o) { return static_cast<int32_t>(static_cast<int16_t>(reg(o + bv))); };
+        const auto ram = [&](uint32_t i) { return static_cast<int32_t>(static_cast<int16_t>(m_ram[i])); };
+
+        const uint32_t pos = core.riverbPos;
+        core.riverbGiu[0][pos] = core.riverbGiu[0][pos | 64u] = static_cast<int16_t>(sat16(inL));
+        core.riverbGiu[1][pos] = core.riverbGiu[1][pos | 64u] = static_cast<int16_t>(sat16(inR));
+
+        const int R = static_cast<int>(m_ciclo & 1u);
+        const uint32_t sameSrc = indiceRiverbero(core, reg32(R ? 0x308u : 0x304u), 0);
+        const uint32_t sameDst = indiceRiverbero(core, reg32(R ? 0x2F0u : 0x2ECu), 0);
+        const uint32_t samePrv = indiceRiverbero(core, reg32(R ? 0x2F0u : 0x2ECu), -1);
+        const uint32_t diffSrc = indiceRiverbero(core, reg32(R ? 0x324u : 0x328u), 0);
+        const uint32_t diffDst = indiceRiverbero(core, reg32(R ? 0x310u : 0x30Cu), 0);
+        const uint32_t diffPrv = indiceRiverbero(core, reg32(R ? 0x310u : 0x30Cu), -1);
+        const uint32_t comb1 = indiceRiverbero(core, reg32(R ? 0x2F8u : 0x2F4u), 0);
+        const uint32_t comb2 = indiceRiverbero(core, reg32(R ? 0x300u : 0x2FCu), 0);
+        const uint32_t comb3 = indiceRiverbero(core, reg32(R ? 0x318u : 0x314u), 0);
+        const uint32_t comb4 = indiceRiverbero(core, reg32(R ? 0x320u : 0x31Cu), 0);
+        const uint32_t apf1Dst = indiceRiverbero(core, reg32(R ? 0x330u : 0x32Cu), 0);
+        const uint32_t apf2Dst = indiceRiverbero(core, reg32(R ? 0x338u : 0x334u), 0);
+        const uint32_t apf1Src = indiceRiverbero(core, reg32(R ? 0x330u : 0x32Cu) - reg32(0x2E4u), 0);
+        const uint32_t apf2Src = indiceRiverbero(core, reg32(R ? 0x338u : 0x334u) - reg32(0x2E8u), 0);
+
+        const int16_t *giu = core.riverbGiu[R] + ((pos - kRiverbTap) & 63u);
+        int32_t ingresso = 0;
+        for (int i = 0; i < kRiverbTap; ++i)
+            ingresso += giu[i] * kFiltroGiu[i];
+        ingresso = mul15(coef(R ? 0x786u : 0x784u), sat16(ingresso >> 15));
+
+        const int32_t vIir = coef(0x774u), vMuro = coef(0x77Eu), vApf1 = coef(0x780u), vApf2 = coef(0x782u);
+        const int32_t same = mul15(vIir, ingresso + mul15(vMuro, ram(sameSrc)) - ram(samePrv)) + ram(samePrv);
+        const int32_t diff = mul15(vIir, ingresso + mul15(vMuro, ram(diffSrc)) - ram(diffPrv)) + ram(diffPrv);
+        int32_t fuori = mul15(coef(0x776u), ram(comb1)) + mul15(coef(0x778u), ram(comb2)) + mul15(coef(0x77Au), ram(comb3)) + mul15(coef(0x77Cu), ram(comb4));
+        const int32_t apf1 = fuori - mul15(vApf1, ram(apf1Src));
+        fuori = ram(apf1Src) + mul15(vApf1, apf1);
+        const int32_t apf2 = fuori - mul15(vApf2, ram(apf2Src));
+        fuori = ram(apf2Src) + mul15(vApf2, apf2);
+
+        if (acceso)
+        {
+            m_ram[sameDst] = static_cast<uint16_t>(sat16(same));
+            m_ram[diffDst] = static_cast<uint16_t>(sat16(diff));
+            m_ram[apf1Dst] = static_cast<uint16_t>(sat16(apf1));
+            m_ram[apf2Dst] = static_cast<uint16_t>(sat16(apf2));
+        }
+
+        const int16_t uscita = static_cast<int16_t>(sat16(fuori));
+        core.riverbSu[R][pos] = core.riverbSu[R][pos | 64u] = uscita;
+        core.riverbSu[1 - R][pos] = core.riverbSu[1 - R][pos | 64u] = 0;
+        core.riverbPos = (pos + 1u) & 63u;
+
+        const uint32_t da = (core.riverbPos - kRiverbTap) & 63u;
+        int32_t sl = 0, sr = 0;
+        for (int i = 0; i < kRiverbTap; ++i)
+        {
+            sl += core.riverbSu[0][da + static_cast<uint32_t>(i)] * kFiltroSu[i];
+            sr += core.riverbSu[1][da + static_cast<uint32_t>(i)] * kFiltroSu[i];
+        }
+        fuoriL = mul15(sat16(sl >> 15), evolL);
+        fuoriR = mul15(sat16(sr >> 15), evolR);
+    }
