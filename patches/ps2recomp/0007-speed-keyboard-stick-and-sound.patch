+    // Chiude il segmento in corso con l'operazione data.
+    void chiudi(Tipo tipo, Extra *e)
+    {
+        parti();
+        Segmento &s = segmenti[segOra & (kSegmenti - 1u)];
+        s.chiusura = tipo;
+        s.extra = e;
+        s.primFine = primOra;
+        s.statoFine = statoOra;
+        const uint32_t prossimo = segOra + 1u;
+        segmenti[prossimo & (kSegmenti - 1u)].clutPrimo = clutOra;
+        segChiusi.store(prossimo, std::memory_order_release);
+        segOra = prossimo;
+        primNelSegmento = 0u;
+        aspetta([&]()
+                { return segOra - segFatti.load(std::memory_order_acquire) < kSegmenti - 1u; }, g_sorGsAttesaUs);
+        if (dormono.load(std::memory_order_acquire) != 0u)
+            svegliati.notify_all();
+        disegnateAlto.azzera();
+        disegnateBasso.azzera();
+        letteAlto.azzera();
+        letteBasso.azzera();
+        ++g_sorGsBarriere;
+    }
+
+    void svuota()
+    {
+        if (!partiti)
+            return;
+        ++g_sorGsSvuota;
+        if (primNelSegmento != 0u)
+            chiudi(Tipo::Nessuna, nullptr);
+        aspetta([&]()
+                { return segFatti.load(std::memory_order_acquire) == segOra; }, g_sorGsAttesaUs);
+    }
+
+    void mettiPrimitiva(const GSPrimitiveBatch &b, bool daFoto)
+    {
+        parti();
+        if (primNelSegmento >= kMaxPrimSegmento)
+        {
+            chiudi(Tipo::Nessuna, nullptr);
+        }
+        aspetta([&]()
+                { return primOra - primLibere.load(std::memory_order_acquire) < kPrimitive - 1u; }, g_sorGsAttesaUs);
+        const GSDrawState &st = b.state;
+        const GSContext &c = st.context;
+        const int ofy = c.xyoffset.ofy >> 4;
+        float y0, y1;
+        if (st.prim.type == GS_PRIM_POINT)
+            y0 = y1 = b.vertices[0].y;
+        else if (st.prim.type == GS_PRIM_SPRITE)
+        {
+            y0 = std::min(b.vertices[0].y, b.vertices[1].y);
+            y1 = std::max(b.vertices[0].y, b.vertices[1].y);
+        }
+        else
+        {
+            y0 = std::min({b.vertices[0].y, b.vertices[1].y, b.vertices[2].y});
+            y1 = std::max({b.vertices[0].y, b.vertices[1].y, b.vertices[2].y});
+        }
+        const int ya = std::max<int>(static_cast<int>(std::floor(y0)) - ofy - 1, c.scissor.y0);
+        const int yb = std::min<int>(static_cast<int>(std::ceil(y1)) - ofy + 1, c.scissor.y1);
+        if (ya > yb)
+            return;
+        Primitiva &p = primitive[primOra & (kPrimitive - 1u)];
+        p.stato = statoOra;
+        p.clut = clutOra;
+        p.foto = daFoto;
+        p.v[0] = b.vertices[0];
+        p.v[1] = b.vertices[1];
+        p.v[2] = b.vertices[2];
+        Segmento &s = segmenti[segOra & (kSegmenti - 1u)];
+        const uint32_t ba = static_cast<uint32_t>(ya) / kRigheBanda;
+        const uint32_t bb = std::min<uint32_t>(static_cast<uint32_t>(yb) / kRigheBanda, kBande - 1u);
+        for (uint32_t i = ba; i <= bb; ++i)
+        {
+            std::vector<uint32_t> &l = s.liste[i];
+            if (l.empty())
+                s.bandeUsate[s.nBande++] = i;
+            l.push_back(primOra);
+        }
+        ++primOra;
+        ++primNelSegmento;
+    }
