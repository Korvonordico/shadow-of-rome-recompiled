+    template <PixelStorageMode P>
+    const typename PixelStorageTraits<P>::PageLookupTableT &tabella()
+    {
+        if constexpr (P == C32 || P == C24 || P == P8H || P == P4HL || P == P4HH)
+            return PageTableC32;
+        else if constexpr (P == Z32 || P == Z24)
+            return PageTableZ32;
+        else if constexpr (P == C16)
+            return PageTableC16;
+        else if constexpr (P == C16S)
+            return PageTableC16S;
+        else if constexpr (P == Z16)
+            return PageTableZ16;
+        else if constexpr (P == Z16S)
+            return PageTableZ16S;
+        else if constexpr (P == P8)
+            return PageTableP8;
+        else
+            return PageTableP4;
+    }
