+GSBande::GSBande() : d(std::make_unique<Dentro>()) {}
+GSBande::~GSBande() = default;
+
+void GSBande::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    d->svuota();
+    d->vram = vram;
+    d->vramSize = vramSize;
+    d->cpu.Initialize(vram, vramSize);
+}
+
+void GSBande::Reset()
+{
+    if (d->partiti)
+    {
+        d->chiudi(Tipo::Azzera, new Extra());
+        d->svuota();
+    }
+    else
+        d->cpu.Reset();
+    d->cbp[0] = d->cbp[1] = 0u;
+}
+
+void GSBande::Submit(const GSPrimitiveBatch &batch)
+{
+    if (batch.vertexCount == 0u)
+        return;
+    ++g_sorGsPrim;
+    const GSPrimType tipo = batch.state.prim.type;
+    if (tipo == GS_PRIM_LINE || tipo == GS_PRIM_LINESTRIP)
+    {
+        // Le linee passano per pixel di bande diverse: restano al codice originale, da sole.
+        Extra *e = new Extra();
+        e->batch = batch;
+        e->flush = d->flushAtteso;
+        d->flushAtteso = false;
+        d->chiudi(Tipo::Lento, e);
+        return;
+    }
+    if (d->statoNuovo || !statiUguali(d->ultimoStato, batch.state))
+    {
+        d->statoNuovo = false;
+        d->ultimoStato = batch.state;
+        // Il posto nella coda degli stati: non uno che i thread stanno ancora leggendo.
+        const uint32_t prossimo = d->statoOra + 1u;
+        if (d->partiti)
+        {
+            if (prossimo - d->statiLiberi.load(std::memory_order_acquire) >= kStati - 1u && d->primNelSegmento != 0u)
+            {
+                d->chiudi(Tipo::Nessuna, nullptr);
+            }
+            d->aspetta([&]()
+                       { return prossimo - d->statiLiberi.load(std::memory_order_acquire) < kStati - 1u; }, g_sorGsAttesaUs);
+        }
+        d->statoOra = prossimo;
+        d->stati[prossimo & (kStati - 1u)] = batch.state;
+    }
+    Dentro::Zone z;
+    d->zoneDi(batch, z);
+    if (z.vuota)
+        return;
+    bool daFoto = false;
+    if (batch.state.prim.tme)
+    {
+        static const bool s_tuttoSolo = std::getenv("SOR_GSTUTTOSOLO") != nullptr;
+        if (s_tuttoSolo)
+        {
+            // Solo per confronto: ogni primitiva con texture da sola, con la copia della pagina.
+            Extra *e = new Extra();
+            e->batch = batch;
+            e->flush = d->flushAtteso || !d->serieSola;
+            d->flushAtteso = false;
+            d->chiudi(Tipo::VeloceSolo, e);
+            d->serieSola = true;
+            return;
+        }
+        const bool sovrapposta = Dentro::toccano(z.leggeAlto, z.scriveAlto) || Dentro::toccano(z.leggeBasso, z.scriveBasso);
+        if (!z.suSeStessa && sovrapposta)
+        {
+            // Legge dove sta scrivendo. Sul GS vero legge la sua copia della texture, che cambia solo con TEXFLUSH
+            // o quando un'altra primitiva legge una texture: qui legge da una foto delle stesse pagine. Gli effetti
+            // sui canali (16 bit sopra 32 bit) contano su questo.
+            if (d->flushAtteso || !d->serieSola)
+                d->fotoPagine.azzera();
+            d->flushAtteso = false;
+            d->serieSola = true;
+            Pagine mancanti;
+            bool manca = false;
+            for (int i = 0; i < 8; ++i)
+            {
+                mancanti.bit[i] = z.leggeLarga.bit[i] & ~d->fotoPagine.bit[i];
+                manca = manca || mancanti.bit[i] != 0u;
+                d->fotoPagine.bit[i] |= z.leggeLarga.bit[i];
+            }
+            if (manca)
+            {
+                Extra *e = new Extra();
+                e->pagine = mancanti;
+                d->chiudi(Tipo::Foto, e);
+            }
+            dumpPrim(batch, manca ? 'F' : 'S');
+            daFoto = true;
+        }
+        else
+        {
+            d->serieSola = false;
+            // Legge quello che una primitiva di questo segmento ha appena scritto: prima deve essere finita.
+            if (Dentro::toccano(z.leggeAlto, d->disegnateAlto) || Dentro::toccano(z.leggeBasso, d->disegnateBasso))
+                d->chiudi(Tipo::Nessuna, nullptr);
+        }
+    }
+    // Scrive dove una primitiva di questo segmento legge: le bande non tengono l'ordine fra loro.
+    if (Dentro::toccano(z.scriveAlto, d->letteAlto) || Dentro::toccano(z.scriveBasso, d->letteBasso))
+        d->chiudi(Tipo::Nessuna, nullptr);
+    if (!daFoto)
+        dumpPrim(batch, 'B');
+    Dentro::aggiungi(d->disegnateAlto, z.scriveAlto);
+    Dentro::aggiungi(d->disegnateBasso, z.scriveBasso);
+    if (!daFoto)
+    {
+        Dentro::aggiungi(d->letteAlto, z.leggeAlto);
+        Dentro::aggiungi(d->letteBasso, z.leggeBasso);
+    }
+    d->mettiPrimitiva(batch, daFoto);
+}
+
+void GSBande::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    if (!paletta(tex0.psm))
+        return;
+    // Le stesse condizioni di GSCpuBackend::LoadClut, per non chiudere il segmento se non c'e' niente da fare.
+    switch (tex0.cld)
+    {
+    case 1u:
+        break;
+    case 2u:
+        d->cbp[0] = tex0.cbp;
+        break;
+    case 3u:
+        d->cbp[1] = tex0.cbp;
+        break;
+    case 4u:
+        if (d->cbp[0] == tex0.cbp)
+            return;
+        d->cbp[0] = tex0.cbp;
+        break;
+    case 5u:
+        if (d->cbp[1] == tex0.cbp)
+            return;
+        d->cbp[1] = tex0.cbp;
+        break;
+    default:
+        return;
+    }
+    dumpEvento("clut", tex0.cbp, tex0.cld);
+    // La CLUT si legge dalla VRAM: se quella zona e' stata appena disegnata, prima si chiude il segmento.
+    if (d->disegnateAlto.vale(tex0.cbp / 32u) || d->disegnateBasso.vale(tex0.cbp / 32u))
+        d->chiudi(Tipo::Nessuna, nullptr);
+    d->parti();
+    Segmento &s = d->segmenti[d->segOra & (kSegmenti - 1u)];
+    if (s.carichi.size() >= kClut / 2u)
+        d->chiudi(Tipo::Nessuna, nullptr);
+    d->segmenti[d->segOra & (kSegmenti - 1u)].carichi.push_back({tex0, texclut});
+    d->serieSola = false;
+    ++d->clutOra;
+}
+
+void GSBande::BeginTransfer(const GSTransferCommand &command)
+{
+    dumpEvento("trasferimento", 0, 0);
+    Extra *e = new Extra();
+    e->trasferimento = command;
+    d->chiudi(Tipo::Trasferimento, e);
+}
+
+void GSBande::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || sizeBytes == 0u)
+        return;
+    Extra *e = new Extra();
+    e->dati.assign(data, data + sizeBytes);
+    d->chiudi(Tipo::Immagine, e);
+}
+
+void GSBande::Flush() {}
+void GSBande::TextureFlush()
+{
+    dumpEvento("texflush", 0, 0);
+    d->flushAtteso = true;
+}
+void GSBande::Sync(GSSyncReason) {}
+
+void GSBande::SegnaVblank()
+{
+    if (!d->partiti)
+        return;
+    dumpVblank();
+    d->chiudi(Tipo::Copia, new Extra());
+    ++d->copieChieste;
+    // Il gioco non deve correre piu' di due fotogrammi davanti al disegno.
+    d->aspetta([&]()
+               { return d->copieChieste - d->copieFatte.load(std::memory_order_acquire) <= 2u; }, g_sorGsVblankUs);
+}
+
+PresentationFrame GSBande::Present(const GSPresentationRequest &request)
+{
+    int indice = -1;
+    {
+        std::lock_guard<std::mutex> lock(d->mutexCopie);
+        indice = d->copiaUltima;
+        d->copiaInLettura = indice;
+    }
+    thread_local GSCpuBackend conversione;
+    PresentationFrame frame;
+    if (indice >= 0)
+    {
+        conversione.Initialize(d->copie[indice].get(), d->vramSize);
+        frame = conversione.PresentaDaMemoria(request);
+    }
+    else
+    {
+        frame = d->cpu.Present(request);
+    }
+    std::lock_guard<std::mutex> lock(d->mutexCopie);
+    d->copiaInLettura = -1;
+    return frame;
+}
+
+bool GSBande::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    Extra *e = new Extra();
+    e->contesto = context;
+    e->rgba = rgba;
+    d->chiudi(Tipo::Pulizia, e);
+    return true;
+}
