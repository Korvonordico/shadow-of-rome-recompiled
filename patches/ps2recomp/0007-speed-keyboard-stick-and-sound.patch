+    // Un insieme di pagine di VRAM (512 da 8 KB).
+    struct Pagine
+    {
+        uint64_t bit[8] = {};
+        void azzera() { std::memset(bit, 0, sizeof(bit)); }
+        void segna(uint32_t p)
+        {
+            p &= 511u;
+            bit[p >> 6] |= 1ull << (p & 63u);
+        }
+        bool vale(uint32_t p) const
+        {
+            p &= 511u;
+            return (bit[p >> 6] >> (p & 63u)) & 1u;
+        }
+    };
