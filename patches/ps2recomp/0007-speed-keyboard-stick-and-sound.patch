+    constexpr uint32_t kMascheraVram32 = static_cast<uint32_t>(MEMORY_SIZE - 4u);
+
+    inline uint32_t fondi(const Uscita &U, uint32_t rgba, uint32_t a, uint32_t dest)
+    {
