@@ -0,0 +1,1340 @@
+// sor: esecuzione veloce dei microprogrammi VU1.
+//
+// L'interprete di ps2_vu1_core.cpp simula ogni ciclo della macchina (circa 140 ns a ciclo): troppo per
+// i 2-3 milioni di cicli a fotogramma di Shadow of Rome. Qui ogni microprogramma raggiungibile da un
+// punto d'ingresso viene tradotto una volta in una lista di operazioni (un puntatore a funzione con
+// gli operandi gia' risolti) e poi eseguito in sequenza.
+//
+// Perche' si puo' fare senza simulare i cicli: la VU1 ferma da sola un'istruzione che legge un registro
+// non ancora pronto, quindi per VF, VI e ACC l'ordine sequenziale da' lo stesso risultato (dentro una
+// coppia le due istruzioni leggono i valori di prima). Restano visibili i tempi solo per Q, CLIP e MAC,
+// che non fermano chi li legge: per quelli i cicli si calcolano qui durante la traduzione, con le stesse
+// regole dell'interprete, e il valore diventa visibile nel punto giusto della lista.
+//
+// Quello che non si sa tradurre con certezza (JR, BAL, EFU, flag di stato, bit D/T, Q letto subito dopo
+// un salto mentre la divisione e' in corso...) fa tornare tutto il programma all'interprete.
+// SOR_VU1VERIFICA=1 esegue ogni programma con tutti e due e scrive le differenze nel registro.
+#include "runtime/ps2_vu1.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/ps2_memory.h"
+#include "ps2_vu1_detail.h"
+
+#include <smmintrin.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+extern uint64_t g_sorVu1Cicli, g_sorVu1Run;
+uint64_t g_sorVu1Lenti = 0; // programmi eseguiti dall'interprete (per SOR_TEMPI)
+
+namespace
+{
+    struct Ctx;
+    struct Op;
+    using Fn = const Op *(*)(Ctx &, const Op *);
+
+    struct Op
+    {
+        Fn fn = nullptr;
+        float *d = nullptr;
+        const float *s = nullptr;
+        const float *t = nullptr;
+        int32_t imm = 0;
+        uint16_t a = 0, b = 0;
+        uint8_t dest = 0, bc = 0, flag = 0, slot = 0;
+    };
+
+    struct Ctx
+    {
+        VU1State *st = nullptr;
+        uint8_t *dati = nullptr;
+        uint32_t mascheraDati = 0;
+        const Op *ops = nullptr;
+        VU1Interpreter *vu = nullptr;
+        float ombra[4]{};
+        float qAttesa = 0.0f;
+        uint32_t clipLavoro = 0;
+        uint32_t clipAttesa[8]{};
+        uint32_t macAttesa[16]{};
+        int32_t viVecchio = 0;
+        bool preso = false;
+        uint64_t salti = 0;
+        uint64_t cicli = 0;
+    };
+
+    const __m128i kAbs = _mm_set1_epi32(0x7FFFFFFF);
+    const __m128i kSegno = _mm_set1_epi32(static_cast<int>(0x80000000u));
+    const __m128i kMax = _mm_set1_epi32(0x7F7FFFFF);
+    const __m128i kEsp = _mm_set1_epi32(0x7F800000);
+    const __m128 kMaschere[16] = {
+#define M(d) _mm_castsi128_ps(_mm_set_epi32((d) & 1 ? -1 : 0, (d) & 2 ? -1 : 0, (d) & 4 ? -1 : 0, (d) & 8 ? -1 : 0))
+        M(0), M(1), M(2), M(3), M(4), M(5), M(6), M(7), M(8), M(9), M(10), M(11), M(12), M(13), M(14), M(15)
+#undef M
+    };
+
+    // Inf e NaN diventano il massimo con lo stesso segno, come normalizeOperand (i denormali li azzera DAZ).
+    inline __m128 limita(__m128 x)
+    {
+        const __m128i i = _mm_castps_si128(x);
+        const __m128i m = _mm_min_epu32(_mm_and_si128(i, kAbs), kMax);
+        return _mm_castsi128_ps(_mm_or_si128(m, _mm_and_si128(i, kSegno)));
+    }
+    // Come limita, ma azzera anche i denormali (per le operazioni che non fanno calcoli: MAX, MINI, ABS).
+    inline __m128 limitaTutto(__m128 x)
+    {
+        const __m128i i = _mm_castps_si128(limita(x));
+        const __m128i z = _mm_cmpeq_epi32(_mm_and_si128(i, kEsp), _mm_setzero_si128());
+        return _mm_castsi128_ps(_mm_or_si128(_mm_andnot_si128(z, i), _mm_and_si128(i, kSegno)));
+    }
+    inline float scalare(float v)
+    {
+        uint32_t b;
+        std::memcpy(&b, &v, 4);
+        const uint32_t e = (b >> 23) & 0xFFu;
+        if (e == 0u)
+            b &= 0x80000000u;
+        else if (e == 0xFFu)
+            b = (b & 0x80000000u) | 0x7F7FFFFFu;
+        std::memcpy(&v, &b, 4);
+        return v;
+    }
+    inline void scrivi(float *d, __m128 r, uint8_t dest)
+    {
+        if (dest != 0xF)
+        {
+            const __m128 m = kMaschere[dest];
+            r = _mm_or_ps(_mm_and_ps(m, r), _mm_andnot_ps(m, _mm_loadu_ps(d)));
+        }
+        _mm_storeu_ps(d, r);
+    }
+
+    constexpr uint8_t kInvertiLane[16] = {0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15};
+    // MAC del risultato (solo se il programma legge i flag). Underflow esatto non si distingue dallo zero.
+    inline void segnaMac(Ctx &c, const Op *o, __m128 r)
+    {
+        const uint32_t z = kInvertiLane[_mm_movemask_ps(_mm_cmpeq_ps(r, _mm_setzero_ps()))] & o->dest;
+        const uint32_t s = kInvertiLane[_mm_movemask_ps(r)] & o->dest;
+        const __m128i abs = _mm_and_si128(_mm_castps_si128(r), kAbs);
+        const uint32_t v = kInvertiLane[_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(abs, kMax)))] & o->dest;
+        c.macAttesa[o->slot] = z | (s << 4) | (v << 12);
+    }
+
+    enum Tipo { ADD, SUB, MUL, MADD, MSUB };
+    enum Sorg { BC_X, BC_Y, BC_Z, BC_W, VEC, Q, I };
+
+    template <int T, int S, bool A>
+    const Op *fmac(Ctx &c, const Op *o)
+    {
+        const __m128 vs = limita(_mm_loadu_ps(o->s));
+        __m128 vt;
+        if constexpr (S == Q)
+            vt = _mm_set1_ps(c.st->q);
+        else if constexpr (S == I)
+            vt = _mm_set1_ps(c.st->i);
+        else if constexpr (S == VEC)
+            vt = limita(_mm_loadu_ps(o->t));
+        else
+        {
+            const __m128 x = limita(_mm_loadu_ps(o->t));
+            vt = _mm_shuffle_ps(x, x, _MM_SHUFFLE(S, S, S, S));
+        }
+        __m128 r;
+        if constexpr (T == ADD)
+            r = _mm_add_ps(vs, vt);
+        else if constexpr (T == SUB)
+            r = _mm_sub_ps(vs, vt);
+        else if constexpr (T == MUL)
+            r = _mm_mul_ps(vs, vt);
+        else if constexpr (T == MADD)
+            r = _mm_add_ps(limita(_mm_loadu_ps(c.st->acc)), _mm_mul_ps(vs, vt));
+        else
+            r = _mm_sub_ps(limita(_mm_loadu_ps(c.st->acc)), _mm_mul_ps(vs, vt));
+        if (o->flag)
+            segnaMac(c, o, r);
+        scrivi(A ? c.st->acc : o->d, r, o->dest);
+        return o + 1;
+    }
+
+    template <bool SOTTRAI, bool A>
+    const Op *opm(Ctx &c, const Op *o)
+    {
+        const __m128 vs = limita(_mm_loadu_ps(o->s));
+        const __m128 vt = limita(_mm_loadu_ps(o->t));
+        __m128 p = _mm_mul_ps(_mm_shuffle_ps(vs, vs, _MM_SHUFFLE(3, 0, 2, 1)), _mm_shuffle_ps(vt, vt, _MM_SHUFFLE(3, 1, 0, 2)));
+        __m128 r = SOTTRAI ? _mm_sub_ps(limita(_mm_loadu_ps(c.st->acc)), p) : p;
+        r = _mm_and_ps(r, kMaschere[0xE]);
+        if (o->flag)
+            segnaMac(c, o, r);
+        scrivi(A ? c.st->acc : o->d, r, o->dest);
+        return o + 1;
+    }
+
+    template <bool MASSIMO, int S>
+    const Op *maxmin(Ctx &c, const Op *o)
+    {
+        const __m128 vs = limitaTutto(_mm_loadu_ps(o->s));
+        __m128 vt;
+        if constexpr (S == I)
+            vt = _mm_set1_ps(c.st->i);
+        else if constexpr (S == VEC)
+            vt = limitaTutto(_mm_loadu_ps(o->t));
+        else
+        {
+            const __m128 x = limitaTutto(_mm_loadu_ps(o->t));
+            vt = _mm_shuffle_ps(x, x, _MM_SHUFFLE(S, S, S, S));
+        }
+        scrivi(o->d, MASSIMO ? _mm_max_ps(vs, vt) : _mm_min_ps(vs, vt), o->dest);
+        return o + 1;
+    }
+
+    const Op *fnAbs(Ctx &, const Op *o)
+    {
+        scrivi(o->d, _mm_castsi128_ps(_mm_and_si128(_mm_castps_si128(limitaTutto(_mm_loadu_ps(o->s))), kAbs)), o->dest);
+        return o + 1;
+    }
+
+    template <int SCALA>
+    const Op *fnItof(Ctx &, const Op *o)
+    {
+        __m128 r = _mm_cvtepi32_ps(_mm_loadu_si128(reinterpret_cast<const __m128i *>(o->s)));
+        if constexpr (SCALA != 0)
+            r = _mm_mul_ps(r, _mm_set1_ps(1.0f / static_cast<float>(1 << SCALA)));
+        scrivi(o->d, r, o->dest);
+        return o + 1;
+    }
+
+    template <int SCALA>
+    const Op *fnFtoi(Ctx &, const Op *o)
+    {
+        __m128 x = limitaTutto(_mm_loadu_ps(o->s));
+        if constexpr (SCALA != 0)
+            x = _mm_mul_ps(x, _mm_set1_ps(static_cast<float>(1 << SCALA)));
+        const __m128i troppo = _mm_castps_si128(_mm_cmpge_ps(x, _mm_set1_ps(2147483648.0f)));
+        __m128i i = _mm_cvttps_epi32(x);
+        i = _mm_or_si128(_mm_andnot_si128(troppo, i), _mm_and_si128(troppo, _mm_set1_epi32(0x7FFFFFFF)));
+        scrivi(o->d, _mm_castsi128_ps(i), o->dest);
+        return o + 1;
+    }
