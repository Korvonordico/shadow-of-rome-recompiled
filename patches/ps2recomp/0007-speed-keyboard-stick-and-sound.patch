+    void aspetta(C &&condizione, uint64_t &doveUs)
+    {
+        if (condizione())
+            return;
+        Cronometro cr(doveUs);
+        int giri = 0;
+        while (!condizione())
+        {
+            if (++giri < 2000)
+                _mm_pause();
