+    template <int T, bool A>
+    Fn sceltaFmac(int s)
+    {
+        switch (s)
+        {
+        case BC_X: return fmac<T, BC_X, A>;
+        case BC_Y: return fmac<T, BC_Y, A>;
+        case BC_Z: return fmac<T, BC_Z, A>;
+        case BC_W: return fmac<T, BC_W, A>;
+        case VEC: return fmac<T, VEC, A>;
+        case Q: return fmac<T, Q, A>;
+        default: return fmac<T, I, A>;
+        }
+    }
+    Fn fnFmacPer(int tipo, int sorg, bool acc)
+    {
+        switch (tipo)
+        {
+        case ADD: return acc ? sceltaFmac<ADD, true>(sorg) : sceltaFmac<ADD, false>(sorg);
+        case SUB: return acc ? sceltaFmac<SUB, true>(sorg) : sceltaFmac<SUB, false>(sorg);
+        case MUL: return acc ? sceltaFmac<MUL, true>(sorg) : sceltaFmac<MUL, false>(sorg);
+        case MADD: return acc ? sceltaFmac<MADD, true>(sorg) : sceltaFmac<MADD, false>(sorg);
+        default: return acc ? sceltaFmac<MSUB, true>(sorg) : sceltaFmac<MSUB, false>(sorg);
+        }
+    }
+    template <bool MASSIMO>
+    Fn fnMaxPer(int s)
+    {
+        switch (s)
+        {
+        case BC_X: return maxmin<MASSIMO, BC_X>;
+        case BC_Y: return maxmin<MASSIMO, BC_Y>;
+        case BC_Z: return maxmin<MASSIMO, BC_Z>;
+        case BC_W: return maxmin<MASSIMO, BC_W>;
+        case VEC: return maxmin<MASSIMO, VEC>;
+        default: return maxmin<MASSIMO, I>;
+        }
