+void VU1Interpreter::sorVerifica(uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize, GS &gs, PS2Memory *memory, uint32_t maxCycles)
+{
+    static long s_uguali = 0, s_diversi = 0, s_scritte = 0;
+    const VU1State prima = m_state;
+    const uint64_t cicloPrima = m_cycle;
+    std::vector<uint8_t> datiPrima(vuData, vuData + dataSize);
+    std::vector<std::vector<uint8_t>> pacchettiLenti, pacchettiVeloci;
+
+    m_sorDentroVerifica = true;
+    m_sorCattura = &pacchettiLenti;
+    run(vuCode, codeSize, vuData, dataSize, gs, memory, maxCycles);
+    const VU1State lento = m_state;
+    std::vector<uint8_t> datiLenti(vuData, vuData + dataSize);
+
+    m_state = prima;
+    m_cycle = cicloPrima;
+    std::memcpy(vuData, datiPrima.data(), dataSize);
+    resetScheduler();
+    m_sorCattura = &pacchettiVeloci;
+    const bool veloce = sorEseguiVeloce(vuCode, codeSize, vuData, dataSize, memory);
+    m_sorCattura = nullptr;
+    m_sorDentroVerifica = false;
+
+    if (!veloce)
+    {
+        m_state = lento;
+        std::memcpy(vuData, datiLenti.data(), dataSize);
+        pacchettiVeloci.swap(pacchettiLenti);
+    }
+    else
+    {
+        bool diverso = false;
+        const auto scrivi = [&](const char *testo, int a, uint32_t x, uint32_t y)
+        {
+            diverso = true;
+            if (++s_scritte <= 120)
+                std::printf("[sor] VU1 DIFFERENZA ingresso 0x%x: %s %d: interprete %08x, veloce %08x\n", prima.pc, testo, a, x, y);
+        };
+        const auto bits = [](float f)
+        {
+            uint32_t b;
+            std::memcpy(&b, &f, 4);
+            return b;
+        };
+        for (int r = 1; r < 32; ++r)
+            for (int c = 0; c < 4; ++c)
+                if (bits(lento.vf[r][c]) != bits(m_state.vf[r][c]))
+                    scrivi("vf", r * 10 + c, bits(lento.vf[r][c]), bits(m_state.vf[r][c]));
+        for (int r = 1; r < 16; ++r)
+            if (lento.vi[r] != m_state.vi[r])
+                scrivi("vi", r, static_cast<uint32_t>(lento.vi[r]), static_cast<uint32_t>(m_state.vi[r]));
+        for (int c = 0; c < 4; ++c)
+            if (bits(lento.acc[c]) != bits(m_state.acc[c]))
+                scrivi("acc", c, bits(lento.acc[c]), bits(m_state.acc[c]));
+        if (bits(lento.q) != bits(m_state.q))
+            scrivi("q", 0, bits(lento.q), bits(m_state.q));
+        if (bits(lento.i) != bits(m_state.i))
+            scrivi("i", 0, bits(lento.i), bits(m_state.i));
+        if (lento.clip != m_state.clip)
+            scrivi("clip", 0, lento.clip, m_state.clip);
+        if (lento.pc != m_state.pc)
+            scrivi("pc", 0, lento.pc, m_state.pc);
+        for (uint32_t a = 0; a + 4u <= dataSize; a += 4u)
+            if (std::memcmp(vuData + a, datiLenti.data() + a, 4) != 0)
+            {
+                uint32_t x, y;
+                std::memcpy(&x, datiLenti.data() + a, 4);
+                std::memcpy(&y, vuData + a, 4);
+                scrivi("dati", static_cast<int>(a), x, y);
+                break;
+            }
+        if (pacchettiLenti != pacchettiVeloci)
+            scrivi("pacchetti", static_cast<int>(pacchettiVeloci.size()), static_cast<uint32_t>(pacchettiLenti.size()), static_cast<uint32_t>(pacchettiLenti.empty() || pacchettiVeloci.empty() ? 0u : (pacchettiLenti[0] != pacchettiVeloci[0])));
+        // Il vero stato resta quello dell'interprete: la prova non deve guastare il gioco.
+        m_state = lento;
+        std::memcpy(vuData, datiLenti.data(), dataSize);
+        pacchettiVeloci.swap(pacchettiLenti);
+        (diverso ? s_diversi : s_uguali)++;
+        if ((s_uguali + s_diversi) % 2000 == 0)
+            std::printf("[sor] VU1 verifica: %ld programmi uguali, %ld diversi\n", s_uguali, s_diversi);
+        if (diverso || (s_uguali + s_diversi) % 2000 == 0)
+            std::fflush(stdout);
+    }
+    for (const std::vector<uint8_t> &p : pacchettiVeloci)
+    {
+        if (memory)
+            memory->submitGifPacket(GifPathId::Path1, p.data(), static_cast<uint32_t>(p.size()));
+        else
+            gs.processGIFPacket(p.data(), static_cast<uint32_t>(p.size()));
+    }
+}
