+    std::unique_ptr<uint8_t[]> foto;
+    std::mutex mutexCopie;
+    int copiaUltima = -1;
+    int copiaInLettura = -1;
+    std::atomic<uint64_t> copieFatte{0u};
+    uint64_t copieChieste = 0u;
+
+    Dentro()
+    {
+        unsigned n = std::thread::hardware_concurrency();
+        n = n > 2u ? n - 2u : 1u;
+        nThread = std::min<uint32_t>(n, 4u);
+        if (const char *e = std::getenv("SOR_GSTHREAD"))
+            nThread = std::min<uint32_t>(static_cast<uint32_t>(std::max(1, std::atoi(e))), kMaxThread);
+    }
+
+    void parti()
+    {
+        if (partiti)
+            return;
+        partiti = true;
+        std::printf("[sor] GS: disegno su %u thread\n", nThread);
+        std::fflush(stdout);
+        for (uint32_t i = 0; i < nThread; ++i)
