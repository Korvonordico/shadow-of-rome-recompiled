+    inline float normRisultato(float v)
+    {
+        uint32_t b;
+        std::memcpy(&b, &v, 4);
+        const uint32_t e = (b >> 23) & 0xFFu;
+        if (e == 0u)
+            b &= 0x80000000u;
+        else if (e == 0xFFu)
+            b = (b & 0x80000000u) | 0x7F7FFFFFu;
+        std::memcpy(&v, &b, 4);
+        return v;
+    }
+    const Op *fnDiv(Ctx &c, const Op *o)
+    {
+        const float num = scalare(o->s[o->a]);
+        const float den = scalare(o->t[o->b]);
+        float r;
+        if (den == 0.0f)
+            r = std::signbit(num) != std::signbit(den) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max();
+        else
+            r = num / den;
+        c.qAttesa = normRisultato(r);
+        return o + 1;
+    }
+    const Op *fnSqrt(Ctx &c, const Op *o)
+    {
