+struct GSBande::Dentro
+{
+    GSCpuBackend cpu;
+    uint8_t *vram = nullptr;
+    uint32_t vramSize = 0u;
+    uint32_t nThread = 1u;
+
+    std::unique_ptr<Primitiva[]> primitive = std::make_unique<Primitiva[]>(kPrimitive);
+    std::unique_ptr<GSDrawState[]> stati = std::make_unique<GSDrawState[]>(kStati);
