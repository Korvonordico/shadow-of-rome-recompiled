+void GSCpuBackend::DisegnaVeloceSolo(const GSPrimitiveBatch &batch, bool flush)
+{
+    if (!m_statoSolo)
+        m_statoSolo = new GSVeloceStato();
+    if (flush)
+        m_texturePageCache.Invalidate();
+    GSVeloceStato &S = *m_statoSolo;
+    S.cache = &m_texturePageCache;
+    DisegnaVeloce(batch.state, batch.vertices.data(), 0u, S, 0, 1 << 20, m_clut.data(), m_clutVersione.load(std::memory_order_relaxed));
+}
+
+GSVeloceStato *GSCpuBackend::NuovoStatoVeloce()
+{
+    return new GSVeloceStato();
+}
+
+// sor: SOR_GSCONFRONTO=1. Ogni primitiva viene disegnata dal codice originale su una copia della VRAM e
+// da quello veloce sulla VRAM vera; si contano i pixel diversi per tipo di primitiva, poi la copia si riallinea.
+void GSCpuBackend::ConfrontaConVecchio(const GSPrimitiveBatch &batch)
+{
+    static GSVeloceStato *s_stato = new GSVeloceStato();
+    static uint64_t s_seq = 0;
+    struct Voce
+    {
+        uint64_t prim = 0, pixel = 0, diversi = 0, diversiZ = 0;
+        int x = 0, y = 0;
+        uint32_t a = 0, b = 0;
+    };
+    static std::map<uint32_t, Voce> s_voci;
+    static uint64_t s_tot = 0;
+    if (m_vramCopia.size() != m_vramSize)
+    {
+        m_vramCopia.assign(m_vram, m_vram + m_vramSize);
+    }
+    const GSDrawState &st = batch.state;
+    const GSContext &c = st.context;
+
+    uint8_t *vera = m_vram;
+    m_vram = m_vramCopia.data();
+    m_texturePageCache.Invalidate();
+    DrawPrimitive(batch);
+    m_vram = vera;
+    static GSMem::TexturePageCache s_cachePagina;
+    s_cachePagina.Invalidate();
+    // SOR_GSCONFRONTO=2: prova anche la via rapida degli sprite, che non usa la copia della pagina.
+    static const bool s_senzaCopia = std::getenv("SOR_GSCONFRONTO") && std::getenv("SOR_GSCONFRONTO")[0] == '2';
+    s_stato->cache = s_senzaCopia ? nullptr : &s_cachePagina;
+    DisegnaVeloce(st, batch.vertices.data(), ++s_seq, *s_stato, 0, 1 << 20, m_clut.data(), m_clutVersione.load(std::memory_order_relaxed));
+
+    const uint32_t chiave = static_cast<uint32_t>(st.prim.type) | (st.prim.tme ? 0x10u : 0u) | (st.prim.abe ? 0x20u : 0u) | (st.linearFilter ? 0x40u : 0u) |
+                            (st.prim.fst ? 0x80u : 0u) | (static_cast<uint32_t>(c.tex0.psm) << 8) | (static_cast<uint32_t>(c.frame.psm) << 16) | (static_cast<uint32_t>(c.tex0.tfx) << 24);
+    Voce &vc = s_voci[chiave];
+    ++vc.prim;
+    const uint32_t fbp = GSInternal::framePageBaseToBlock(c.frame.fbp);
+    const uint32_t zbp = GSInternal::framePageBaseToBlock(c.zbuf.zbp);
+    const uint32_t fbw = std::max<uint32_t>(c.frame.fbw, 1u);
+    const auto letturaF = m_readVramFuncs[c.frame.psm & 0x3Fu];
+    const auto letturaZ = m_readVramFuncs[c.zbuf.psm & 0x3Fu];
+    const auto scritturaF = m_writeVramFuncs[c.frame.psm & 0x3Fu];
+    const auto scritturaZ = m_writeVramFuncs[c.zbuf.psm & 0x3Fu];
+    int bx0 = 100000, by0 = 100000, bx1 = -100000, by1 = -100000;
+    for (uint32_t i = 0; i < batch.vertexCount; ++i)
+    {
+        const int vx = static_cast<int>(batch.vertices[i].x) - (c.xyoffset.ofx >> 4);
+        const int vy = static_cast<int>(batch.vertices[i].y) - (c.xyoffset.ofy >> 4);
+        bx0 = std::min(bx0, vx - 2);
+        bx1 = std::max(bx1, vx + 2);
+        by0 = std::min(by0, vy - 2);
+        by1 = std::max(by1, vy + 2);
+    }
+    bx0 = std::max<int>(bx0, c.scissor.x0);
+    by0 = std::max<int>(by0, c.scissor.y0);
+    bx1 = std::min<int>(bx1, c.scissor.x1);
+    by1 = std::min<int>(by1, c.scissor.y1);
+    for (int yy = by0; yy <= by1; ++yy)
+        for (int xx = bx0; xx <= bx1; ++xx)
+        {
+            const uint32_t x = static_cast<uint32_t>(xx), y = static_cast<uint32_t>(yy);
+            const uint32_t A = letturaF(m_vram, fbp, fbw, x, y);
+            const uint32_t B = letturaF(m_vramCopia.data(), fbp, fbw, x, y);
+            if (A != B)
+            {
+                ++vc.pixel;
+                int massimo = 0;
+                for (int s = 0; s < 32; s += 8)
+                    massimo = std::max(massimo, std::abs(static_cast<int>((A >> s) & 0xFFu) - static_cast<int>((B >> s) & 0xFFu)));
+                if (massimo > 3)
+                {
+                    if (vc.diversi++ == 0u)
+                    {
+                        vc.x = static_cast<int>(x);
+                        vc.y = static_cast<int>(y);
+                        vc.a = A;
+                        vc.b = B;
+                    }
+                }
+                scritturaF(m_vramCopia.data(), fbp, fbw, x, y, A);
+            }
+            if (c.zbuf.zbp != c.frame.fbp)
+            {
+                const uint32_t ZA = letturaZ(m_vram, zbp, fbw, x, y);
+                const uint32_t ZB = letturaZ(m_vramCopia.data(), zbp, fbw, x, y);
+                if (ZA != ZB)
+                {
+                    if (std::abs(static_cast<long long>(ZA) - static_cast<long long>(ZB)) > 2)
+                        ++vc.diversiZ;
+                    scritturaZ(m_vramCopia.data(), zbp, fbw, x, y, ZA);
+                }
+            }
+        }
+    if (++s_tot % 4000u == 0u)
+    {
+        std::printf("[sor] GS confronto dopo %llu primitive (tipo|tme10|abe20|lin40|fst80, tpsm, fpsm, tfx):\n", static_cast<unsigned long long>(s_tot));
+        for (const auto &kv : s_voci)
+            std::printf("[sor]   %02x t%02x f%02x x%u: prim %llu, ritocchi %llu, diversi %llu, Z %llu, primo (%d,%d) veloce %08x vecchio %08x\n", kv.first & 0xFFu, (kv.first >> 8) & 0xFFu, (kv.first >> 16) & 0xFFu, kv.first >> 24,
+                        static_cast<unsigned long long>(kv.second.prim), static_cast<unsigned long long>(kv.second.pixel), static_cast<unsigned long long>(kv.second.diversi), static_cast<unsigned long long>(kv.second.diversiZ), kv.second.x, kv.second.y, kv.second.a, kv.second.b);
+        std::fflush(stdout);
+    }
+}
