+    static void segnaRettangolo(Pagine &p, uint32_t base, uint32_t passo, uint32_t larg, uint32_t alt, int xa, int ya, int xb, int yb)
+    {
+        for (int r = ya / static_cast<int>(alt); r <= yb / static_cast<int>(alt); ++r)
+            for (int k = xa / static_cast<int>(larg); k <= xb / static_cast<int>(larg); ++k)
+                p.segna(base + static_cast<uint32_t>(r) * passo + static_cast<uint32_t>(k));
+    }
+
+    // Quali bit di un pixel tocca un formato: se non si sovrappongono, due primitive non si danno fastidio.
+    static uint32_t bitDi(uint8_t psm)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT24:
+        case GS_PSM_Z24:
+            return 0x00FFFFFFu;
+        case GS_PSM_T8H:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
+            return 0xFF000000u;
+        default:
+            return 0xFFFFFFFFu;
+        }
+    }
+
+    static void aggiungi(Pagine &a, const Pagine &b)
+    {
+        for (int i = 0; i < 8; ++i)
+            a.bit[i] |= b.bit[i];
+    }
+
+    void zoneDi(const GSPrimitiveBatch &b, Zone &z) const
+    {
+        const GSDrawState &st = b.state;
+        const GSContext &c = st.context;
+        const int n = st.prim.type == GS_PRIM_SPRITE ? 2 : st.prim.type == GS_PRIM_POINT ? 1 : 3;
+        const int ofx = c.xyoffset.ofx >> 4, ofy = c.xyoffset.ofy >> 4;
+        float x0 = 1e9f, x1 = -1e9f, y0 = 1e9f, y1 = -1e9f, u0 = 1e9f, u1 = -1e9f, v0 = 1e9f, v1 = -1e9f;
+        bool texturaIntera = false;
+        for (int i = 0; i < n; ++i)
+        {
+            const GSVertex &p = b.vertices[static_cast<size_t>(i)];
+            x0 = std::min(x0, p.x - static_cast<float>(ofx));
+            x1 = std::max(x1, p.x - static_cast<float>(ofx));
+            y0 = std::min(y0, p.y - static_cast<float>(ofy));
+            y1 = std::max(y1, p.y - static_cast<float>(ofy));
+            if (!st.prim.tme)
+                continue;
+            float u, v;
+            if (st.prim.fst)
+            {
+                u = static_cast<float>(p.u) / 16.0f;
+                v = static_cast<float>(p.v) / 16.0f;
+            }
+            else
+            {
+                if (p.q <= 1.0e-8f)
+                    texturaIntera = true;
+                const float q = std::abs(p.q) > 1.0e-8f ? p.q : 1.0f;
+                u = p.s / q * static_cast<float>(st.textureWidth);
+                v = p.t / q * static_cast<float>(st.textureHeight);
+            }
+            u0 = std::min(u0, u);
+            u1 = std::max(u1, u);
+            v0 = std::min(v0, v);
+            v1 = std::max(v1, v);
+        }
+        const bool sprite = st.prim.type == GS_PRIM_SPRITE;
+        const int xa = std::max<int>(static_cast<int>(std::floor(x0)) - (sprite ? 0 : 1), c.scissor.x0);
+        const int xb = std::min<int>(static_cast<int>(std::ceil(x1)) + (sprite ? -1 : 1), c.scissor.x1);
+        const int ya = std::max<int>(static_cast<int>(std::floor(y0)) - (sprite ? 0 : 1), c.scissor.y0);
+        const int yb = std::min<int>(static_cast<int>(std::ceil(y1)) + (sprite ? -1 : 1), c.scissor.y1);
+        if (xa > xb || ya > yb)
+        {
+            z.vuota = true;
+            return;
+        }
+        const uint32_t fbw = std::max<uint32_t>(c.frame.fbw, 1u);
+        uint32_t largF, altF;
+        paginaDi(c.frame.psm, largF, altF);
+        {
+            // I formati a 16 bit e con tavolozza scrivono in tutto il pixel a 32 bit: bitDi li tratta cosi'.
+            const bool trentadue = c.frame.psm == GS_PSM_CT32 || c.frame.psm == GS_PSM_CT24 || c.frame.psm == GS_PSM_Z32 || c.frame.psm == GS_PSM_Z24;
+            const uint32_t bitF = trentadue ? (bitDi(c.frame.psm) & ~c.frame.fbmsk) : 0xFFFFFFFFu;
+            Pagine f;
+            segnaRettangolo(f, c.frame.fbp, fbw, largF, altF, xa, ya, xb, yb);
+            if (bitF & 0xFF000000u)
+                aggiungi(z.scriveAlto, f);
+            if (bitF & 0x00FFFFFFu)
+                aggiungi(z.scriveBasso, f);
+        }
+        if (!c.zbuf.zmask)
+        {
+            uint32_t largZ, altZ;
+            paginaDi(c.zbuf.psm, largZ, altZ);
+            Pagine f;
+            segnaRettangolo(f, c.zbuf.zbp, fbw, largZ, altZ, xa, ya, xb, yb);
+            const uint32_t bitZ = bitDi(c.zbuf.psm);
+            if (bitZ & 0xFF000000u)
+                aggiungi(z.scriveAlto, f);
+            if (bitZ & 0x00FFFFFFu)
+                aggiungi(z.scriveBasso, f);
+        }
+        if (!st.prim.tme)
+            return;
+        const GSTex0Reg &t = c.tex0;
+        const int largT = st.textureWidth, altT = st.textureHeight;
+        // Fuori dalla texture si ripete: si considera tutta.
+        if (u0 < -1.0f || v0 < -1.0f || u1 > static_cast<float>(largT) + 1.0f || v1 > static_cast<float>(altT) + 1.0f)
+            texturaIntera = true;
+        int ua, ub, va, vb;
+        if (texturaIntera)
+        {
+            ua = 0;
+            va = 0;
+            ub = largT - 1;
+            vb = altT - 1;
+        }
+        else
+        {
+            // L'ultima riga e l'ultima colonna dichiarate non si leggono davvero (i campioni cadono prima).
+            const int margine = st.linearFilter ? 0 : 1;
+            ua = std::max(static_cast<int>(u0) - (1 - margine), 0);
+            va = std::max(static_cast<int>(v0) - (1 - margine), 0);
+            ub = std::max(static_cast<int>(u1) - margine, ua);
+            vb = std::max(static_cast<int>(v1) - margine, va);
+        }
+        uint32_t larg, alt;
+        paginaDi(t.psm, larg, alt);
+        // Una texture che comincia a meta' pagina sconfina nella pagina dopo.
+        if (t.tbp0 % 32u != 0u)
+        {
+            ub += static_cast<int>(larg);
+            vb += static_cast<int>(alt);
+        }
+        const uint32_t passo = std::max<uint32_t>((static_cast<uint32_t>(t.tbw) * 64u) / larg, 1u);
+        {
+            Pagine f;
+            segnaRettangolo(f, t.tbp0 / 32u, passo, larg, alt, ua, va, ub, vb);
+            const uint32_t bitT = bitDi(t.psm);
+            if (bitT & 0xFF000000u)
+                aggiungi(z.leggeAlto, f);
+            if (bitT & 0x00FFFFFFu)
+                aggiungi(z.leggeBasso, f);
+            segnaRettangolo(z.leggeLarga, t.tbp0 / 32u, passo, larg, alt, std::max(ua - 1, 0), std::max(va - 1, 0), std::min(ub + 1, largT - 1 + (t.tbp0 % 32u != 0u ? static_cast<int>(larg) : 0)), std::min(vb + 1, altT - 1 + (t.tbp0 % 32u != 0u ? static_cast<int>(alt) : 0)));
+        }
+        if (sprite && !st.linearFilter && t.tbp0 == c.frame.fbp * 32u && t.tbw == c.frame.fbw &&
+            (c.frame.psm == GS_PSM_CT32 || c.frame.psm == GS_PSM_CT24) &&
+            (t.psm == GS_PSM_CT32 || t.psm == GS_PSM_CT24 || t.psm == GS_PSM_T8H || t.psm == GS_PSM_T4HL || t.psm == GS_PSM_T4HH) &&
+            static_cast<int>(u0) == static_cast<int>(x0) && static_cast<int>(v0) == static_cast<int>(y0) &&
+            static_cast<int>(u1) - static_cast<int>(u0) == static_cast<int>(x1) - static_cast<int>(x0) &&
+            static_cast<int>(v1) - static_cast<int>(v0) == static_cast<int>(y1) - static_cast<int>(y0))
+            z.suSeStessa = true;
+    }
+
+    static bool toccano(const Pagine &a, const Pagine &b)
+    {
+        for (int i = 0; i < 8; ++i)
+            if ((a.bit[i] & b.bit[i]) != 0u)
+                return true;
+        return false;
+    }
+};
+
+namespace
+{
+    int s_dumpVb = -1;
+    int s_dumpOra = 0;
+    bool s_dumpAttivo = false;
+    uint64_t s_dumpN = 0;
+    float s_dx0, s_dy0, s_dx1, s_dy1, s_du0, s_dv0, s_du1, s_dv1;
+    char s_dumpRiga[400] = {};
+    char s_dumpVia = '?';
+    void dumpChiudiRiga()
+    {
+        if (s_dumpN != 0u)
+            std::printf("[gsd] %s n=%llu via=%c xy=%.0f,%.0f-%.0f,%.0f uv=%.1f,%.1f-%.1f,%.1f\n", s_dumpRiga, static_cast<unsigned long long>(s_dumpN), s_dumpVia, s_dx0, s_dy0, s_dx1, s_dy1, s_du0, s_dv0, s_du1, s_dv1);
+        s_dumpN = 0u;
+    }
+    void dumpEvento(const char *t, uint32_t a, uint32_t b)
+    {
+        if (!s_dumpAttivo)
+            return;
+        dumpChiudiRiga();
+        std::printf("[gsd] -- %s %x %x\n", t, a, b);
+    }
+    void dumpPrim(const GSPrimitiveBatch &b, char via)
+    {
+        if (!s_dumpAttivo)
+            return;
+        const GSDrawState &st = b.state;
+        const GSContext &c = st.context;
+        char riga[400];
+        std::snprintf(riga, sizeof(riga), "t%d fbp=%x fbw=%u fpsm=%x msk=%x zbp=%x zm=%d test=%llx tme=%d tbp=%x tbw=%u tpsm=%x %dx%d cbp=%x cpsm=%x csa=%u tcc=%u tfx=%u abe=%d a=%llx clamp=%llx lin=%d fst=%d sc=%d,%d-%d,%d fba=%llx",
+                      static_cast<int>(st.prim.type), c.frame.fbp, c.frame.fbw, c.frame.psm, c.frame.fbmsk, c.zbuf.zbp, c.zbuf.zmask ? 1 : 0, static_cast<unsigned long long>(c.test), st.prim.tme ? 1 : 0,
+                      st.prim.tme ? c.tex0.tbp0 : 0u, st.prim.tme ? c.tex0.tbw : 0u, st.prim.tme ? c.tex0.psm : 0u, st.prim.tme ? st.textureWidth : 0, st.prim.tme ? st.textureHeight : 0, st.prim.tme ? c.tex0.cbp : 0u, st.prim.tme ? c.tex0.cpsm : 0u, st.prim.tme ? c.tex0.csa : 0u, c.tex0.tcc, c.tex0.tfx,
+                      st.prim.abe ? 1 : 0, static_cast<unsigned long long>(c.alpha), static_cast<unsigned long long>(c.clamp), st.linearFilter ? 1 : 0, st.prim.fst ? 1 : 0, c.scissor.x0, c.scissor.y0, c.scissor.x1, c.scissor.y1, static_cast<unsigned long long>(c.fba));
+        if (std::strcmp(riga, s_dumpRiga) != 0 || via != s_dumpVia)
+        {
+            dumpChiudiRiga();
+            std::strcpy(s_dumpRiga, riga);
+            s_dumpVia = via;
+            s_dx0 = s_dy0 = s_du0 = s_dv0 = 1e9f;
+            s_dx1 = s_dy1 = s_du1 = s_dv1 = -1e9f;
+        }
+        const int n = st.prim.type == GS_PRIM_SPRITE ? 2 : st.prim.type == GS_PRIM_POINT ? 1 : 3;
+        for (int i = 0; i < n; ++i)
+        {
+            const GSVertex &p = b.vertices[static_cast<size_t>(i)];
+            s_dx0 = std::min(s_dx0, p.x);
+            s_dy0 = std::min(s_dy0, p.y);
+            s_dx1 = std::max(s_dx1, p.x);
+            s_dy1 = std::max(s_dy1, p.y);
+            const float u = st.prim.fst ? static_cast<float>(p.u) / 16.0f : (std::abs(p.q) > 1e-8f ? p.s / p.q * static_cast<float>(st.textureWidth) : 0.0f);
+            const float vv = st.prim.fst ? static_cast<float>(p.v) / 16.0f : (std::abs(p.q) > 1e-8f ? p.t / p.q * static_cast<float>(st.textureHeight) : 0.0f);
+            s_du0 = std::min(s_du0, u);
+            s_dv0 = std::min(s_dv0, vv);
+            s_du1 = std::max(s_du1, u);
+            s_dv1 = std::max(s_dv1, vv);
+        }
+        ++s_dumpN;
+    }
+    void dumpVblank()
+    {
+        static const char *e = std::getenv("SOR_GSDUMP");
+        if (!e)
+            return;
+        ++s_dumpOra;
+        if (s_dumpVb < 0)
+            s_dumpVb = std::atoi(e);
+        if (s_dumpAttivo)
+        {
+            dumpChiudiRiga();
+            std::printf("[gsd] FINE\n");
+            std::fflush(stdout);
+        }
+        s_dumpAttivo = s_dumpOra == s_dumpVb;
+        if (s_dumpAttivo)
+            std::printf("[gsd] INIZIO vb=%d\n", s_dumpOra);
+    }
+}
