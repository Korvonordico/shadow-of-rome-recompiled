+// sor: quello che il disegno veloce prepara una volta per stato (ogni thread ha il suo).
+struct GSVeloceStato
+{
+    const GSDrawState *st = nullptr;
+    uint64_t seq = 0;
+    uint8_t *vram = nullptr;
+    const uint8_t *vramTex = nullptr; // da dove si leggono le texture: la VRAM, o una sua foto
