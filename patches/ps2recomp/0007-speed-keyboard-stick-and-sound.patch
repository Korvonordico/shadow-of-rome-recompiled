+    // Salti: flag = 1 se il primo operando va letto vecchio, 2 se il secondo (scrittura della coppia prima).
+    template <int COND>
+    const Op *fnCond(Ctx &c, const Op *o)
+    {
+        const int16_t x = static_cast<int16_t>((o->flag & 1) ? c.viVecchio : c.st->vi[o->a]);
+        const int16_t y = static_cast<int16_t>((o->flag & 2) ? c.viVecchio : c.st->vi[o->b]);
+        switch (COND)
+        {
+        case 0: c.preso = x == y; break;
+        case 1: c.preso = x != y; break;
+        case 2: c.preso = x < 0; break;
+        case 3: c.preso = x > 0; break;
+        case 4: c.preso = x <= 0; break;
+        default: c.preso = x >= 0; break;
+        }
+        return o + 1;
+    }
+    const Op *fnSeSalto(Ctx &c, const Op *o)
+    {
+        if (c.preso)
+        {
+            // Guardia contro i cicli infiniti: l'interprete ne fermerebbe uno dopo 65536 cicli.
+            if (++c.salti > (1u << 22))
+                return nullptr;
+            return c.ops + o->imm;
+        }
+        return o + 1;
+    }
