+    // Forme FMAC dell'upper: (op o speciale) -> tipo e sorgente del secondo operando. Falso se non e' una.
+    bool formaFmac(uint8_t op, int &tipo, int &sorg)
+    {
+        if (op <= 0x0Fu)
+        {
+            static constexpr int tipi[4] = {ADD, SUB, MADD, MSUB};
+            tipo = tipi[op >> 2];
+            sorg = op & 3;
+            return true;
+        }
+        if (op >= 0x18u && op <= 0x1Bu) { tipo = MUL; sorg = op & 3; return true; }
+        switch (op)
+        {
+        case 0x1C: tipo = MUL; sorg = Q; return true;
+        case 0x1E: tipo = MUL; sorg = I; return true;
+        case 0x20: tipo = ADD; sorg = Q; return true;
+        case 0x21: tipo = MADD; sorg = Q; return true;
+        case 0x22: tipo = ADD; sorg = I; return true;
+        case 0x23: tipo = MADD; sorg = I; return true;
+        case 0x24: tipo = SUB; sorg = Q; return true;
+        case 0x25: tipo = MSUB; sorg = Q; return true;
+        case 0x26: tipo = SUB; sorg = I; return true;
+        case 0x27: tipo = MSUB; sorg = I; return true;
+        case 0x28: tipo = ADD; sorg = VEC; return true;
+        case 0x29: tipo = MADD; sorg = VEC; return true;
+        case 0x2A: tipo = MUL; sorg = VEC; return true;
+        case 0x2C: tipo = SUB; sorg = VEC; return true;
+        case 0x2D: tipo = MSUB; sorg = VEC; return true;
+        default: return false;
+        }
+    }
+    uint8_t specialeUpper(uint32_t u) { return static_cast<uint8_t>((u & 3u) | ((u >> 4) & 0x7Cu)); }
+    bool upperLeggeQ(uint32_t u)
+    {
+        const uint8_t op = u & 0x3Fu;
+        const uint8_t x = op >= 0x3Cu ? specialeUpper(u) : op;
+        return x == 0x1C || x == 0x20 || x == 0x21 || x == 0x24 || x == 0x25;
+    }
+    enum class Lower { Nessuno, Salto, Cond, Fm, Fc, Fs, Altro };
+    Lower tipoLower(uint32_t l)
+    {
+        const uint8_t hi = (l >> 25) & 0x7Fu;
+        if (hi == 0x20u) return Lower::Salto;
+        if (hi >= 0x28u && hi <= 0x2Fu) return Lower::Cond;
+        if (hi == 0x10u || hi == 0x12u || hi == 0x13u || hi == 0x1Cu) return Lower::Fc;
+        if (hi == 0x18u || hi == 0x1Au || hi == 0x1Bu) return Lower::Fm;
+        if (hi == 0x14u || hi == 0x16u || hi == 0x17u || hi == 0x15u || hi == 0x11u) return Lower::Fs;
+        return Lower::Altro;
+    }
+    bool saltoNonNoto(uint32_t l)
+    {
+        const uint8_t hi = (l >> 25) & 0x7Fu;
+        return hi == 0x21u || hi == 0x24u || hi == 0x25u;
+    }
+}
+
+struct VU1Programma
+{
+    std::vector<Op> ops;
+    int32_t partenza = 0;
+    bool buono = false;
+};
+
+namespace
+{
+    struct Cache
+    {
+        std::unordered_map<uint64_t, std::unique_ptr<VU1Programma>> programmi;
+        uint64_t generazione = ~0ull;
+        std::vector<VU1Programma *> perPc = std::vector<VU1Programma *>(0x4000u / 8u, nullptr);
+    };
+    Cache &cache()
+    {
+        static Cache c;
+        return c;
+    }
+}
+
+// Ricompila un programma raggiungibile dall'ingresso pc. Vero se ci e' riuscito.
+bool VU1Interpreter::sorTraduci(VU1Programma &p, const uint8_t *code, uint32_t codeSize, uint32_t entrata, const std::vector<uint32_t> &capi, const std::vector<uint8_t> &visti)
+{
+    VU1State &st = m_state;
+    const auto parola = [code](uint32_t pc, bool sopra)
+    {
+        uint32_t v;
+        std::memcpy(&v, code + pc + (sopra ? 4u : 0u), 4);
+        return v;
+    };
+    std::vector<int32_t> inizio(0x4000u / 8u, -1);
+    std::vector<std::pair<size_t, uint32_t>> daLegare;
+
+    // Un flag MAC serve solo se qualcosa nel programma lo legge.
+    bool serveMac = false;
+    for (uint32_t i = 0; i < visti.size(); ++i)
+        if (visti[i] && !(parola(i * 8u, true) & 0x80000000u) && tipoLower(parola(i * 8u, false)) == Lower::Fm)
+            serveMac = true;
+
+    const auto aggiungi = [&p](Op o) -> Op &
+    {
+        p.ops.push_back(o);
+        return p.ops.back();
+    };
+    const auto isCapo = [&capi](uint32_t pc)
+    {
+        return std::binary_search(capi.begin(), capi.end(), pc);
+    };
+
+    for (const uint32_t capo : capi)
+    {
+        inizio[capo / 8u] = static_cast<int32_t>(p.ops.size());
+        size_t opCicli = p.ops.size();
+        {
+            Op o;
+            o.fn = fnCicli;
+            aggiungi(o);
+        }
+
+        // Modello dei tempi, con le regole di calculatePairReadyCycle e markPairWrites.
+        uint64_t ciclo = 0;
+        uint64_t prontoVf[32][4] = {};
+        uint64_t prontoVi[16] = {};
+        uint64_t prontoAcc[4] = {};
+        uint64_t prontoQ = 0;
+        bool qInCorso = false;
+        struct Attesa
+        {
+            uint64_t pronto;
+            Fn fn;
+            uint8_t slot;
+        };
+        std::vector<Attesa> attese;
+        uint8_t slotClip = 0, slotMac = 0;
+
+        const auto scaduti = [&](uint64_t fino)
+        {
+            std::stable_sort(attese.begin(), attese.end(), [](const Attesa &a, const Attesa &b)
+                             { return a.pronto < b.pronto; });
+            size_t n = 0;
+            for (; n < attese.size() && attese[n].pronto <= fino; ++n)
+            {
+                Op o;
+                o.fn = attese[n].fn;
+                o.slot = attese[n].slot;
+                aggiungi(o);
+            }
+            attese.erase(attese.begin(), attese.begin() + static_cast<long>(n));
+            if (qInCorso && prontoQ <= fino)
+                qInCorso = false;
+        };
+
+        // Controlla che chi segue il blocco non legga un valore ancora in arrivo: scrivendolo a fine
+        // blocco lo vedrebbe prima della macchina vera.
+        const auto controllaUscita = [&](uint32_t pc) -> bool
+        {
+            for (const Attesa &a : attese)
+            {
+                if (a.pronto <= ciclo)
+                    continue;
+                const uint64_t resto = a.pronto - ciclo;
+                for (uint64_t i = 0; i < resto; ++i)
+                {
+                    const uint32_t q = pc + static_cast<uint32_t>(i) * 8u;
+                    if (q + 8u > codeSize)
+                        break;
+                    const uint32_t u = parola(q, true);
+                    const uint32_t l = parola(q, false);
+                    const Lower t = (u & 0x80000000u) ? Lower::Nessuno : tipoLower(l);
+                    if (a.fn == fnQVede && upperLeggeQ(u))
+                        return false;
+                    if (a.fn == fnClipVede && t == Lower::Fc)
+                        return false;
+                    if (a.fn == fnMacVede && t == Lower::Fm)
+                        return false;
+                }
+            }
+            return true;
+        };
+
+        const auto emettiUpper = [&](const DecodedInstructionPair &d) -> bool
+        {
+            const uint32_t u = d.upper;
+            const uint8_t op = u & 0x3Fu;
+            const uint8_t dest = DEST(u);
+            Op o;
+            o.dest = dest;
+            o.s = st.vf[FS(u)];
+            o.t = st.vf[FT(u)];
+            int tipo = 0, sorg = 0;
+            if (op < 0x30u)
+            {
+                o.d = st.vf[FD(u)];
+                const bool scartato = FD(u) == 0u || dest == 0u;
+                if (formaFmac(op, tipo, sorg))
+                {
+                    if (scartato && !serveMac)
+                        return true;
+                    o.fn = fnFmacPer(tipo, sorg, false);
+                }
+                else if (op >= 0x10u && op <= 0x13u)
+                    o.fn = fnMaxPer<true>(op & 3);
+                else if (op >= 0x14u && op <= 0x17u)
+                    o.fn = fnMaxPer<false>(op & 3);
+                else if (op == 0x1Du)
+                    o.fn = fnMaxPer<true>(I);
+                else if (op == 0x1Fu)
+                    o.fn = fnMaxPer<false>(I);
+                else if (op == 0x2Bu)
+                    o.fn = fnMaxPer<true>(VEC);
+                else if (op == 0x2Fu)
+                    o.fn = fnMaxPer<false>(VEC);
+                else if (op == 0x2Eu)
+                    o.fn = opm<true, false>;
+                else
+                    return false;
+                const bool fmacVera = formaFmac(op, tipo, sorg) || op == 0x2Eu;
+                if (fmacVera && serveMac && dest != 0u)
+                {
+                    o.flag = 1u;
+                    o.slot = slotMac;
+                    attese.push_back({ciclo + 4u, fnMacVede, slotMac});
+                    slotMac = (slotMac + 1u) & 15u;
+                }
+                if (scartato)
+                {
+                    static float scarto[4];
+                    o.d = scarto;
+                }
+                aggiungi(o);
+                return true;
+            }
+            if (op < 0x3Cu)
+                return false;
+            const uint8_t sp = specialeUpper(u);
+            if (sp == 0x2Fu || sp == 0x30u)
+                return true;
+            o.d = st.vf[FT(u)];
+            const bool scartato = FT(u) == 0u || dest == 0u;
+            bool perAcc = false;
+            if (formaFmac(sp, tipo, sorg))
+            {
+                o.fn = fnFmacPer(tipo, sorg, true);
+                perAcc = true;
+            }
+            else if (sp == 0x2Eu)
+            {
+                o.fn = opm<false, true>;
+                perAcc = true;
+            }
+            else if (sp == 0x10u) o.fn = fnItof<0>;
+            else if (sp == 0x11u) o.fn = fnItof<4>;
+            else if (sp == 0x12u) o.fn = fnItof<12>;
+            else if (sp == 0x13u) o.fn = fnItof<15>;
+            else if (sp == 0x14u) o.fn = fnFtoi<0>;
+            else if (sp == 0x15u) o.fn = fnFtoi<4>;
+            else if (sp == 0x16u) o.fn = fnFtoi<12>;
+            else if (sp == 0x17u) o.fn = fnFtoi<15>;
+            else if (sp == 0x1Du) o.fn = fnAbs;
+            else if (sp == 0x1Fu)
+            {
+                o.fn = fnClip;
+                o.slot = slotClip;
+                attese.push_back({ciclo + 4u, fnClipVede, slotClip});
+                slotClip = (slotClip + 1u) & 7u;
+                aggiungi(o);
+                return true;
+            }
+            else
+                return false;
+            if (perAcc)
+            {
+                if (serveMac && dest != 0u)
+                {
+                    o.flag = 1u;
+                    o.slot = slotMac;
+                    attese.push_back({ciclo + 4u, fnMacVede, slotMac});
+                    slotMac = (slotMac + 1u) & 15u;
+                }
+                aggiungi(o);
+                return true;
+            }
+            if (!scartato)
+                aggiungi(o);
+            return true;
+        };
+
+        // Falso se l'istruzione non e' fra quelle che si traducono.
+        const auto emettiLower = [&](const DecodedInstructionPair &d) -> bool
+        {
+            const uint32_t l = d.lower;
+            if (l == 0u || l == 0x8000033Cu)
+                return true;
+            const uint8_t hi = (l >> 25) & 0x7Fu;
+            const uint8_t vfT = FT(l), vfS = FS(l), viT = VIT(l), viS = VIS(l), viD = VID(l), dest = DEST(l);
+            Op o;
+            o.dest = dest;
+            uint8_t comp = 3u;
+            if (dest & 8u) comp = 0u;
+            else if (dest & 4u) comp = 1u;
+            else if (dest & 2u) comp = 2u;
+            switch (hi)
+            {
+            case 0x00:
+                if (vfT == 0u || dest == 0u)
+                    return true;
+                o.fn = fnLq; o.d = st.vf[vfT]; o.a = viS; o.imm = IMM11(l);
+                aggiungi(o);
+                return true;
+            case 0x01:
+                if (dest == 0u)
+                    return true;
+                o.fn = fnSq; o.s = st.vf[vfS]; o.a = viT; o.imm = IMM11(l);
+                aggiungi(o);
+                return true;
+            case 0x04:
+                if (viT == 0u)
+                    return true;
+                o.fn = fnIlw; o.a = viS; o.b = viT; o.imm = IMM11(l); o.bc = comp;
+                aggiungi(o);
+                return true;
+            case 0x05:
+                if (dest == 0u)
+                    return true;
+                o.fn = fnIsw; o.a = viS; o.b = viT; o.imm = IMM11(l);
+                aggiungi(o);
+                return true;
+            case 0x08:
+            case 0x09:
+            {
+                if (viT == 0u)
+                    return true;
+                const int16_t imm = static_cast<int16_t>((l & 0x7FFu) | ((l >> 10) & 0x7800u));
+                o.fn = fnIaddi; o.a = viS; o.b = viT; o.imm = hi == 0x08u ? imm : -imm;
+                aggiungi(o);
+                return true;
+            }
+            case 0x10: o.fn = fnFceq; o.imm = static_cast<int32_t>(l & 0xFFFFFFu); aggiungi(o); return true;
+            case 0x12: o.fn = fnFcand; o.imm = static_cast<int32_t>(l & 0xFFFFFFu); aggiungi(o); return true;
+            case 0x13: o.fn = fnFcor; o.imm = static_cast<int32_t>(l & 0xFFFFFFu); aggiungi(o); return true;
+            case 0x1C:
+                if (viT != 0u) { o.fn = fnFcget; o.b = viT; aggiungi(o); }
+                return true;
+            case 0x18:
+                if (viT != 0u) { o.fn = fnFmeq; o.a = viS; o.b = viT; aggiungi(o); }
+                return true;
+            case 0x1A:
+                if (viT != 0u) { o.fn = fnFmand; o.a = viS; o.b = viT; aggiungi(o); }
+                return true;
+            case 0x1B:
+                if (viT != 0u) { o.fn = fnFmor; o.a = viS; o.b = viT; aggiungi(o); }
+                return true;
+            case 0x40:
+                break;
+            default:
+                return false;
+            }
+            const uint8_t f = l & 0x3Fu;
+            if (f == 0x30u || f == 0x31u || f == 0x34u || f == 0x35u)
+            {
+                if (viD == 0u)
+                    return true;
+                o.fn = f == 0x30u ? fnIadd : f == 0x31u ? fnIsub : f == 0x34u ? fnIand : fnIor;
+                o.a = viS; o.b = viT; o.bc = viD;
+                aggiungi(o);
+                return true;
+            }
+            if (f == 0x32u)
+            {
+                if (viT == 0u)
+                    return true;
+                o.fn = fnIaddi; o.a = viS; o.b = viT;
+                o.imm = static_cast<int16_t>(static_cast<int32_t>((l >> 6) & 0x1Fu) << 27 >> 27);
+                aggiungi(o);
+                return true;
+            }
+            if (f < 0x3Cu)
+                return false;
+            const uint8_t sp = static_cast<uint8_t>((l & 3u) | ((l >> 4) & 0x7Cu));
+            switch (sp)
+            {
+            case 0x30:
+                if (vfT != 0u && dest != 0u) { o.fn = fnMove; o.d = st.vf[vfT]; o.s = st.vf[vfS]; aggiungi(o); }
+                return true;
+            case 0x31:
+                if (vfT != 0u && dest != 0u) { o.fn = fnMr32; o.d = st.vf[vfT]; o.s = st.vf[vfS]; aggiungi(o); }
+                return true;
+            case 0x34: o.fn = fnLqPasso<1, true>; o.a = viS; o.d = (vfT != 0u && dest != 0u) ? st.vf[vfT] : nullptr; aggiungi(o); return true;
+            case 0x36: o.fn = fnLqPasso<-1, false>; o.a = viS; o.d = (vfT != 0u && dest != 0u) ? st.vf[vfT] : nullptr; aggiungi(o); return true;
+            case 0x35: o.fn = fnSqPasso<1, true>; o.a = viT; o.s = st.vf[vfS]; aggiungi(o); return true;
+            case 0x37: o.fn = fnSqPasso<-1, false>; o.a = viT; o.s = st.vf[vfS]; aggiungi(o); return true;
+            case 0x38:
+            case 0x39:
+            case 0x3A:
+            {
+                o.fn = sp == 0x38u ? fnDiv : sp == 0x39u ? fnSqrt : fnRsqrt;
+                o.s = st.vf[vfS]; o.t = st.vf[vfT];
+                o.a = (l >> 21) & 3u; o.b = (l >> 23) & 3u;
+                aggiungi(o);
+                prontoQ = ciclo + (sp == 0x3Au ? 13u : 7u);
+                qInCorso = true;
+                attese.push_back({prontoQ, fnQVede, 0u});
+                return true;
+            }
+            case 0x3B:
+                return true; // WAITQ: lo fa il modello dei tempi
+            case 0x3C:
+                if (viT != 0u) { o.fn = fnMtir; o.s = st.vf[vfS]; o.b = viT; o.bc = (l >> 21) & 3u; aggiungi(o); }
+                return true;
+            case 0x3D:
+                if (vfT != 0u && dest != 0u) { o.fn = fnMfir; o.d = st.vf[vfT]; o.a = viS; aggiungi(o); }
+                return true;
+            case 0x3E:
+                if (viT != 0u) { o.fn = fnIlwr; o.a = viS; o.b = viT; o.bc = comp; aggiungi(o); }
+                return true;
+            case 0x3F:
+                if (dest != 0u) { o.fn = fnIswr; o.a = viS; o.b = viT; aggiungi(o); }
+                return true;
+            case 0x68:
+                if (viT != 0u) { o.fn = fnXtop; o.b = viT; aggiungi(o); }
+                return true;
+            case 0x69:
+                if (viT != 0u) { o.fn = fnXitop; o.b = viT; aggiungi(o); }
+                return true;
+            case 0x6C:
+                o.fn = [](Ctx &c, const Op *x) -> const Op *
+                { c.vu->sorKickSubito(static_cast<uint32_t>(static_cast<uint16_t>(c.st->vi[x->a]))); return x + 1; };
+                o.a = viS;
+                aggiungi(o);
+                return true;
+            default:
+                return false;
+            }
+        };
+
+        const auto calcolaStallo = [&](const DecodedInstructionPair &d)
+        {
+            uint64_t r = ciclo;
+            const InstructionUsage *usi[2] = {&d.upperUsage, &d.lowerUsage};
+            for (const InstructionUsage *us : usi)
+            {
+                for (uint32_t i = 0; i < us->vfReadCount; ++i)
+                    for (uint32_t c = 0; c < 4u; ++c)
+                        if (us->vfRead[i].lanes & (1u << (3u - c)))
+                            r = std::max(r, prontoVf[us->vfRead[i].reg][c]);
+                for (uint32_t v = 1; v < 16u; ++v)
+                    if (us->viRead & (1u << v))
+                        r = std::max(r, prontoVi[v]);
+                for (uint32_t c = 0; c < 4u; ++c)
+                    if (us->accRead & (1u << (3u - c)))
+                        r = std::max(r, prontoAcc[c]);
+            }
+            if ((d.lowerUsage.pipeline == PipelineFdiv || d.lowerUsage.waitQ) && qInCorso)
+                r = std::max(r, prontoQ);
+            return r;
+        };
+        const auto segnaScritture = [&](const DecodedInstructionPair &d)
+        {
+            const VfAccess lw = d.lowerUsage.vfWrite;
+            if (lw.reg != 0u && d.suppressedLowerVf != lw.reg)
+            {
+                const uint32_t lat = d.lowerUsage.vfLatency ? d.lowerUsage.vfLatency : d.lowerUsage.latency;
+                for (uint32_t c = 0; c < 4u; ++c)
+                    if (lw.lanes & (1u << (3u - c)))
+                        prontoVf[lw.reg][c] = ciclo + lat;
+            }
+            const VfAccess uw = d.upperUsage.vfWrite;
+            if (uw.reg != 0u)
+            {
+                const uint32_t lat = d.upperUsage.vfLatency ? d.upperUsage.vfLatency : d.upperUsage.latency;
+                for (uint32_t c = 0; c < 4u; ++c)
+                    if (uw.lanes & (1u << (3u - c)))
+                        prontoVf[uw.reg][c] = ciclo + lat;
+            }
+            for (uint32_t v = 1; v < 16u; ++v)
+                if (d.lowerUsage.viWrite & (1u << v))
+                    prontoVi[v] = ciclo + (d.lowerUsage.viLatency ? d.lowerUsage.viLatency : d.lowerUsage.latency);
+            for (uint32_t c = 0; c < 4u; ++c)
+                if (d.upperUsage.accWrite & (1u << (3u - c)))
+                    prontoAcc[c] = ciclo + kAccForwardLatency;
+        };
+
+        // Una coppia intera. Per i salti scrive solo la condizione: il salto vero va dopo lo slot.
+        const auto emettiCoppia = [&](uint32_t pc, bool prossimaLeggeVecchio, uint8_t regVecchio) -> bool
+        {
+            const DecodedInstructionPair d = decodeInstructionPair(code, pc);
+            if (d.upperUsage.reserved || d.lowerUsage.reserved || d.dBit || d.tBit)
+                return false;
+            ciclo = calcolaStallo(d);
+            scaduti(ciclo);
+            if (prossimaLeggeVecchio)
+            {
+                Op o;
+                o.fn = fnViVecchio;
+                o.a = regVecchio;
+                aggiungi(o);
+            }
+            if (d.iBit)
+            {
+                if (!emettiUpper(d))
+                    return false;
+                float imm;
+                std::memcpy(&imm, &d.lower, 4);
+                imm = scalare(imm);
+                Op o;
+                o.fn = fnSetI;
+                std::memcpy(&o.imm, &imm, 4);
+                aggiungi(o);
+            }
+            else if (d.upperVfShadowReg != 0u)
+            {
+                Op o;
+                o.fn = fnSalvaOmbra;
+                o.s = st.vf[d.upperVfShadowReg];
+                aggiungi(o);
+                if (!emettiUpper(d))
+                    return false;
+                Op sc;
+                sc.fn = fnScambiaOmbra;
+                sc.d = st.vf[d.upperVfShadowReg];
+                aggiungi(sc);
+                if (!emettiLower(d))
+                    return false;
+                Op ri;
+                ri.fn = fnRiprendiOmbra;
+                ri.d = st.vf[d.upperVfShadowReg];
+                aggiungi(ri);
+            }
+            else
+            {
+                if (!emettiUpper(d))
+                    return false;
+                if (!(tipoLower(d.lower) == Lower::Salto || tipoLower(d.lower) == Lower::Cond) && !emettiLower(d))
+                    return false;
+            }
+            segnaScritture(d);
+            ciclo += 1u;
+            return true;
+        };
+
+        uint32_t pc = capo;
+        for (;;)
+        {
+            if (pc + 8u > codeSize)
+                return false;
+            const uint32_t u = parola(pc, true);
+            const uint32_t l = parola(pc, false);
+            const bool iBit = (u & 0x80000000u) != 0u;
+            const bool eBit = (u & 0x40000000u) != 0u;
+            const Lower t = iBit ? Lower::Nessuno : tipoLower(l);
+            if (!iBit && saltoNonNoto(l))
+                return false;
+            if (t == Lower::Fs)
+                return false;
+
+            // La scrittura VI della coppia prima di un salto condizionato non si vede ancora.
+            bool leggeVecchio = false;
+            uint8_t regVecchio = 0u;
+            const uint32_t pcDopo = pc + 8u;
+            if (pcDopo + 8u <= codeSize && !eBit && t != Lower::Salto && t != Lower::Cond && !isCapo(pcDopo))
+            {
+                const uint32_t uDopo = parola(pcDopo, true);
+                const uint32_t lDopo = parola(pcDopo, false);
+                if (!(uDopo & 0x80000000u) && tipoLower(lDopo) == Lower::Cond)
+                {
+                    const DecodedInstructionPair d = decodeInstructionPair(code, pc);
+                    if (d.lowerUsage.delaysNextBranchRead && d.lowerUsage.viWrite != 0u)
+                    {
+                        for (uint32_t v = 1; v < 16u; ++v)
+                            if (d.lowerUsage.viWrite & (1u << v))
+                                regVecchio = static_cast<uint8_t>(v);
+                        const bool usaS = VIS(lDopo) == regVecchio;
+                        const bool usaT = VIT(lDopo) == regVecchio;
+                        if (usaS || usaT)
+                            leggeVecchio = true;
+                    }
+                }
+            }
+            if (t == Lower::Cond && isCapo(pc))
+            {
+                // Un salto subito dopo un altro salto: la regola della lettura vecchia dipenderebbe
+                // da dove si arriva. Si controlla la coppia prima, se puo' cadere qui.
+                if (pc >= 8u)
+                {
+                    const DecodedInstructionPair d = decodeInstructionPair(code, pc - 8u);
+                    if (d.lowerUsage.delaysNextBranchRead && d.lowerUsage.viWrite != 0u)
+                        return false;
+                }
+            }
+
+            if (t == Lower::Salto || t == Lower::Cond)
+            {
+                if (eBit)
+                    return false;
+                if (!emettiCoppia(pc, false, 0u))
+                    return false;
+                const int16_t imm = IMM11(l);
+                const uint32_t bersaglio = (pc + 8u + static_cast<int32_t>(imm) * 8) & 0x3FFFu;
+                const uint8_t hi = (l >> 25) & 0x7Fu;
+                if (t == Lower::Cond)
+                {
+                    Op o;
+                    switch (hi)
+                    {
+                    case 0x28: o.fn = fnCond<0>; break;
+                    case 0x29: o.fn = fnCond<1>; break;
+                    case 0x2C: o.fn = fnCond<2>; break;
+                    case 0x2D: o.fn = fnCond<3>; break;
+                    case 0x2E: o.fn = fnCond<4>; break;
+                    case 0x2F: o.fn = fnCond<5>; break;
+                    default: return false;
+                    }
+                    o.a = VIS(l);
+                    o.b = VIT(l);
+                    // Se la coppia prima ha scritto uno dei due registri, va letto il valore di prima.
+                    if (pc >= 8u && !isCapo(pc))
+                    {
+                        const DecodedInstructionPair prima = decodeInstructionPair(code, pc - 8u);
+                        if (prima.lowerUsage.delaysNextBranchRead)
+                        {
+                            for (uint32_t v = 1; v < 16u; ++v)
+                                if (prima.lowerUsage.viWrite & (1u << v))
+                                {
+                                    if (VIS(l) == v) o.flag |= 1u;
+                                    if (VIT(l) == v) o.flag |= 2u;
+                                }
+                        }
+                    }
+                    aggiungi(o);
+                }
+                // Lo slot del salto
+                const uint32_t slot = pc + 8u;
+                if (slot + 8u > codeSize || isCapo(slot))
+                    return false;
+                const uint32_t uS = parola(slot, true);
+                const uint32_t lS = parola(slot, false);
+                if ((uS & 0x40000000u) || (!(uS & 0x80000000u) && (tipoLower(lS) == Lower::Salto || tipoLower(lS) == Lower::Cond || saltoNonNoto(lS) || tipoLower(lS) == Lower::Fs)))
+                    return false;
+                if (!emettiCoppia(slot, false, 0u))
+                    return false;
+                // Fine del blocco: quello che e' in arrivo diventa visibile qui (controllato sopra).
+                if (!controllaUscita(bersaglio))
+                    return false;
+                if (t == Lower::Cond && !controllaUscita(slot + 8u))
+                    return false;
+                scaduti(~0ull);
+                {
+                    Op o;
+                    o.fn = t == Lower::Cond ? fnSeSalto : fnSalto;
+                    daLegare.push_back({p.ops.size(), bersaglio});
+                    aggiungi(o);
+                }
+                if (t == Lower::Cond)
+                {
+                    Op o;
+                    o.fn = fnSalto;
+                    daLegare.push_back({p.ops.size(), slot + 8u});
+                    aggiungi(o);
+                }
+                break;
+            }
+            if (eBit)
+            {
+                if (!emettiCoppia(pc, false, 0u))
+                    return false;
+                const uint32_t slot = pc + 8u;
+                if (slot + 8u > codeSize || isCapo(slot))
+                    return false;
+                const uint32_t uS = parola(slot, true);
+                const uint32_t lS = parola(slot, false);
+                if ((uS & 0x40000000u) || (!(uS & 0x80000000u) && (tipoLower(lS) == Lower::Salto || tipoLower(lS) == Lower::Cond || saltoNonNoto(lS) || tipoLower(lS) == Lower::Fs)))
+                    return false;
+                if (!emettiCoppia(slot, false, 0u))
+                    return false;
+                scaduti(~0ull);
+                Op o;
+                o.fn = fnFine;
+                o.imm = static_cast<int32_t>(slot + 8u);
+                aggiungi(o);
+                break;
+            }
+            if (!emettiCoppia(pc, leggeVecchio, regVecchio))
+                return false;
+            pc += 8u;
+            if (isCapo(pc))
+            {
+                if (!controllaUscita(pc))
+                    return false;
+                scaduti(~0ull);
+                Op o;
+                o.fn = fnSalto;
+                daLegare.push_back({p.ops.size(), pc});
+                aggiungi(o);
+                break;
+            }
+        }
+        p.ops[opCicli].imm = static_cast<int32_t>(ciclo);
+    }
+    p.partenza = inizio[entrata / 8u];
+
+    for (const auto &[indice, bersaglio] : daLegare)
+    {
+        if (inizio[bersaglio / 8u] < 0)
+            return false;
+        p.ops[indice].imm = inizio[bersaglio / 8u];
+    }
+    return true;
+}
+
+void VU1Interpreter::sorKickSubito(uint32_t qword)
+{
+    // Il pacchetto parte subito: i programmi di questo gioco non toccano i dati dopo XGKICK.
+    startXgkick(qword);
+    while (m_xgkick.active)
+    {
+        m_xgkick.cycleCredit = 2u;
+        progressXgkick();
+    }
+}
+
+bool VU1Interpreter::sorEseguiVeloce(uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize, PS2Memory *memory)
+{
+    static const bool s_spento = std::getenv("SOR_VU1LENTO") != nullptr;
+    if (s_spento || m_unit != Unit::VU1 || !memory || vuCode != memory->getVU1Code() || (m_state.pc & 7u) != 0u)
+        return false;
+    Cache &ch = cache();
+    const uint64_t gen = memory->getVU1CodeGeneration();
+    if (ch.generazione != gen)
+    {
+        std::fill(ch.perPc.begin(), ch.perPc.end(), nullptr);
+        ch.generazione = gen;
+    }
+    VU1Programma *prog = ch.perPc[m_state.pc / 8u];
+    if (!prog)
+    {
+        // Trova tutto il codice raggiungibile e ne fa l'impronta: lo stesso programma ricaricato
+        // (succede centinaia di volte a fotogramma) non si traduce di nuovo.
+        const uint32_t entrata = m_state.pc;
+        std::vector<uint8_t> visti(0x4000u / 8u, 0u), capo(0x4000u / 8u, 0u);
+        std::vector<uint32_t> pila{entrata};
+        capo[entrata / 8u] = 1u;
+        bool traducibile = true;
+        while (!pila.empty() && traducibile)
+        {
+            uint32_t pc = pila.back();
+            pila.pop_back();
+            for (;;)
+            {
+                if (pc + 8u > codeSize)
+                {
+                    traducibile = false;
+                    break;
+                }
+                if (visti[pc / 8u])
+                {
+                    capo[pc / 8u] = 1u;
+                    break;
+                }
+                visti[pc / 8u] = 1u;
+                uint32_t l, u;
+                std::memcpy(&l, vuCode + pc, 4);
+                std::memcpy(&u, vuCode + pc + 4u, 4);
+                if (u & 0x40000000u)
+                {
+                    if (pc + 16u > codeSize)
+                    {
+                        traducibile = false;
+                        break;
+                    }
+                    visti[(pc + 8u) / 8u] = 1u;
+                    break;
+                }
+                if (!(u & 0x80000000u))
+                {
+                    const Lower t = tipoLower(l);
+                    if (saltoNonNoto(l))
+                    {
+                        traducibile = false;
+                        break;
+                    }
+                    if (t == Lower::Salto || t == Lower::Cond)
+                    {
+                        const uint32_t bersaglio = (pc + 8u + static_cast<int32_t>(IMM11(l)) * 8) & 0x3FFFu;
+                        if (pc + 16u > codeSize)
+                        {
+                            traducibile = false;
+                            break;
+                        }
+                        visti[(pc + 8u) / 8u] = 1u;
+                        capo[bersaglio / 8u] = 1u;
+                        pila.push_back(bersaglio);
+                        if (t == Lower::Salto)
+                            break;
+                        capo[(pc + 16u) / 8u] = 1u;
+                        pila.push_back(pc + 16u);
+                        break;
+                    }
+                }
+                pc += 8u;
+            }
+        }
+        uint64_t impronta = 0xCBF29CE484222325ull ^ entrata;
+        std::vector<uint32_t> capi;
+        for (uint32_t i = 0; i < 0x4000u / 8u; ++i)
+        {
+            if (visti[i])
+            {
+                uint64_t v;
+                std::memcpy(&v, vuCode + i * 8u, 8);
+                impronta = (impronta ^ v) * 0x100000001B3ull;
+                impronta = (impronta ^ i) * 0x100000001B3ull;
+            }
+            if (capo[i])
+                capi.push_back(i * 8u);
+        }
+        auto &posto = ch.programmi[impronta];
+        if (!posto)
+        {
+            posto = std::make_unique<VU1Programma>();
+            posto->buono = traducibile && sorTraduci(*posto, vuCode, codeSize, entrata, capi, visti);
+            std::printf("[sor] VU1 veloce: ingresso 0x%x, %zu blocchi, %zu operazioni: %s\n", entrata, capi.size(), posto->ops.size(),
+                        posto->buono ? "tradotto" : "resta all'interprete");
+            std::fflush(stdout);
+        }
+        prog = posto.get();
+        ch.perPc[entrata / 8u] = prog;
+    }
+    if (!prog->buono)
+    {
+        ++g_sorVu1Lenti;
+        return false;
+    }
+    Ctx c;
+    c.st = &m_state;
+    c.dati = vuData;
+    c.mascheraDati = dataSize - 1u;
+    c.ops = prog->ops.data();
+    c.vu = this;
+    c.clipLavoro = m_state.clip;
+    const uint32_t csr = _mm_getcsr();
+    _mm_setcsr(0xFFC0u); // verso lo zero, FTZ, DAZ, eccezioni mascherate
+    m_state.vf[0][0] = m_state.vf[0][1] = m_state.vf[0][2] = 0.0f;
+    m_state.vf[0][3] = 1.0f;
+    const Op *o = c.ops + prog->partenza;
+    do
+        o = o->fn(c, o);
+    while (o);
+    _mm_setcsr(csr);
+    m_workingClip = m_state.clip;
+    m_cycle += c.cicli;
+    m_state.cycles = m_cycle;
+    g_sorVu1Cicli += c.cicli;
+    ++g_sorVu1Run;
+    return true;
+}
