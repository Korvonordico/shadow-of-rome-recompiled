+        bool fC32, zZ24, f16, testAlfa, date, dateLegge, abe, pabe, fba, zmask, nebbia;
+        bool fC24, semplice; // semplice: niente test, niente profondita', niente nebbia, formato a 32 bit
+        uint32_t (*leggiF)(uint8_t *, uint32_t, uint32_t, uint32_t, uint32_t);
+        void (*scriviF)(uint8_t *, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
+        uint32_t (*leggiZf)(uint8_t *, uint32_t, uint32_t, uint32_t, uint32_t);
+        void (*scriviZf)(uint8_t *, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
