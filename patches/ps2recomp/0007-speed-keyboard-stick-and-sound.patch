+    uint32_t primOra = 0u;
+    uint32_t statoOra = 0u;
+    uint32_t primNelSegmento = 0u;
+    uint32_t clutOra = 0u;
+    GSDrawState ultimoStato{};
+    bool statoNuovo = true;
+    bool flushAtteso = false;
+    bool serieSola = false;
