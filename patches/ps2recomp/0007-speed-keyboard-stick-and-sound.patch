+    // Larghezza e altezza di una pagina in pixel per un formato.
+    void paginaDi(uint8_t psm, uint32_t &larg, uint32_t &alt)
+    {
+        larg = 64u;
+        alt = 32u;
+        switch (psm)
+        {
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            alt = 64u;
+            break;
+        case GS_PSM_T8:
+            larg = 128u;
+            alt = 64u;
+            break;
+        case GS_PSM_T4:
+            larg = 128u;
+            alt = 128u;
+            break;
+        default:
+            break;
+        }
+    }
