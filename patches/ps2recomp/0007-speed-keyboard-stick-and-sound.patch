+    template <class C>
+    static void girando(C &&condizione)
+    {
+        int giri = 0;
+        while (!condizione())
+        {
+            if (++giri < 4000)
+                _mm_pause();
+            else
+                std::this_thread::yield();
+        }
+    }
+
+    void giro(uint32_t id)
+    {
+        GSVeloceStato *stato = cpu.NuovoStatoVeloce();
+        int vuoti = 0;
+        for (;;)
+        {
+            // Il segmento su cui si lavora adesso. Nessun thread aspetta gli altri: chi resta indietro (il sistema
+            // puo' fermare un thread in ogni momento) trova il lavoro gia' fatto e passa al segmento dopo.
+            const uint32_t mio = segFatti.load(std::memory_order_acquire);
+            if (mio == segChiusi.load(std::memory_order_acquire))
+            {
+                Cronometro cr(g_sorBandaVuoto[id]);
+                if (++vuoti < 4000)
+                {
+                    _mm_pause();
+                }
+                else if (vuoti < 8000)
+                {
+                    std::this_thread::yield();
+                }
+                else
+                {
+                    std::unique_lock<std::mutex> lock(mutexSonno);
+                    dormono.fetch_add(1u, std::memory_order_acq_rel);
+                    svegliati.wait_for(lock, std::chrono::milliseconds(2), [&]()
+                                       { return segChiusi.load(std::memory_order_acquire) != mio; });
+                    dormono.fetch_sub(1u, std::memory_order_acq_rel);
+                }
+                continue;
+            }
+            vuoti = 0;
+            Segmento &s = segmenti[mio & (kSegmenti - 1u)];
+            // Le versioni della CLUT di questo segmento: la VRAM sotto non cambia fino alla sua fine.
+            {
+                uint32_t atteso = mio;
+                if (clutGuardia.compare_exchange_strong(atteso, mio + 1u, std::memory_order_acq_rel))
+                {
+                    uint32_t ver = s.clutPrimo;
+                    for (const CaricoClut &c : s.carichi)
+                    {
+                        std::array<uint16_t, 512> &nuova = versioniClut[(ver + 1u) & (kClut - 1u)];
+                        nuova = versioniClut[ver & (kClut - 1u)];
+                        cpu.CaricaClutIn(nuova, c.tex0, c.texclut);
+                        ++ver;
+                    }
+                    clutFatta.store(mio + 1u, std::memory_order_release);
+                }
+                else
+                {
+                    girando([&]()
+                            { return static_cast<int32_t>(clutFatta.load(std::memory_order_acquire) - (mio + 1u)) >= 0; });
+                }
+            }
+            // Le bande libere, una alla volta. Il numero del segmento sta insieme a quello della banda.
+            for (;;)
+            {
+                uint64_t v = lavoro.load(std::memory_order_acquire);
+                if (static_cast<uint32_t>(v >> 32) != mio)
+                    break;
+                const uint32_t i = static_cast<uint32_t>(v);
+                if (i >= s.nBande)
+                    break;
+                if (!lavoro.compare_exchange_weak(v, v + 1u, std::memory_order_acq_rel))
+                    continue;
+                const uint32_t b = s.bandeUsate[i];
+                const int yLo = static_cast<int>(b * kRigheBanda);
+                const int yHi = yLo + static_cast<int>(kRigheBanda) - 1;
+                for (const uint32_t ip : s.liste[b])
+                {
+                    const Primitiva &p = primitive[ip & (kPrimitive - 1u)];
+                    cpu.DisegnaVeloce(stati[p.stato & (kStati - 1u)], p.v, static_cast<uint64_t>(p.stato) + 1u, *stato, yLo, yHi, versioniClut[p.clut & (kClut - 1u)].data(), p.clut, p.foto ? foto.get() : nullptr);
+                }
+                bandeFinite.fetch_add(1u, std::memory_order_acq_rel);
+            }
+            g_sorBandaPixel[id] = stato->pixelFatti;
+            // Fine del segmento: appena tutte le bande sono finite, uno solo fa l'operazione che lo chiude.
+            {
+                Cronometro cr(g_sorBandaAttesa[id]);
+                const uint32_t bande = s.nBande;
+                girando([&]()
+                        { return bandeFinite.load(std::memory_order_acquire) >= bande || segFatti.load(std::memory_order_acquire) != mio; });
+                uint32_t atteso = mio;
+                if (segFatti.load(std::memory_order_acquire) == mio && chiude.compare_exchange_strong(atteso, mio + 1u, std::memory_order_acq_rel))
+                {
+                    // Il codice originale e i disegni da soli usano la CLUT condivisa.
+                    {
+                        const uint32_t ultima = s.clutPrimo + static_cast<uint32_t>(s.carichi.size());
+                        cpu.ImpostaClut(versioniClut[ultima & (kClut - 1u)], ultima);
+                    }
+                    s.carichi.clear();
+                    esegui(s.chiusura, s.extra);
+                    s.extra = nullptr;
+                    for (uint32_t i = 0; i < s.nBande; ++i)
+                        s.liste[s.bandeUsate[i]].clear();
+                    s.nBande = 0u;
+                    primLibere.store(s.primFine, std::memory_order_release);
+                    statiLiberi.store(s.statoFine, std::memory_order_release);
+                    bandeFinite.store(0u, std::memory_order_release);
+                    lavoro.store(static_cast<uint64_t>(mio + 1u) << 32, std::memory_order_release);
+                    segFatti.store(mio + 1u, std::memory_order_release);
+                }
+                else
+                {
+                    girando([&]()
+                            { return segFatti.load(std::memory_order_acquire) != mio; });
+                }
+            }
+        }
+    }
