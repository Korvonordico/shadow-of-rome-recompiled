+        const float den = std::sqrt(std::fabs(scalare(o->t[o->b])));
+        const float r = den != 0.0f ? num / den
+                                    : (std::signbit(num) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max());
+        c.qAttesa = normRisultato(r);
+        return o + 1;
+    }
