+
+    // Quello che serve per una riga: gli indirizzi si fanno con due letture di tabella.
+    struct Riga
+    {
+        const uint16_t *colF, *colZ;
+        uint32_t pagF, pagZ;
+        int y;
+        Riga(const Uscita &U, int yy)
