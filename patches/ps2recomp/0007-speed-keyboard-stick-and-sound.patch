+#pragma once
+
+// sor: il chip del suono della PS2 (SPU2). I driver del gioco (LIBSD, MODHSYN, SNDDRVHD) girano davvero
+// nell'IOP e scrivono questi registri: qui ci sono le 48 voci ADPCM, gli inviluppi, i trasferimenti DMA
+// e il miscuglio finale a 48 kHz. Il riverbero non c'e'.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    class IopSpu2
+    {
+    public:
+        IopSpu2();
+        void reset();
+
+        [[nodiscard]] uint16_t read16(uint32_t phys) const;
+        void write16(uint32_t phys, uint16_t value);
+
+        // Un trasferimento DMA verso (o dal) chip. ram e' la RAM dell'IOP; le parole sono da 32 bit.
+        // Torna false se e' un trasferimento continuo (ADMA): l'interruzione arriva quando finisce.
+        bool dma(int core, uint8_t *ram, uint32_t ramSize, uint32_t indirizzo, uint32_t parole, bool versoChip);
+
+        // Avanza il suono fino all'ora vera.
+        void orologio();
+
+        // Interruzioni da consegnare (numero, -1 se nessuna).
+        int prendiInterruzione();
+
+    private:
+        struct Voce
+        {
+            uint32_t ssa = 0, lsa = 0, nax = 0;
+            uint16_t volL = 0, volR = 0, pitch = 0, adsr1 = 0, adsr2 = 0;
+            int32_t livello = 0;
+            int32_t volXL = 0, volXR = 0;
+            int contatore = 0;
+            uint8_t fase = 0; // 0 spenta, 1 attacco, 2 decadimento, 3 sostegno, 4 rilascio
+            bool lsaManuale = false, lsaNuova = false;
+            uint32_t passo = 0;
+            int16_t blocco[28] = {};
+            int indice = 28;
+            uint8_t flag = 0;
+            int32_t prev1 = 0, prev2 = 0;
+            int32_t storia[4] = {};
+        };
+        struct Adma
+        {
+            bool attivo = false;
+            uint8_t *ram = nullptr;
+            uint32_t ramSize = 0, indirizzo = 0, resto = 0;
+            int16_t l[256] = {}, r[256] = {};
+            int posizione = 256;
+        };
+        struct Core
+        {
+            std::array<Voce, 24> voci;
+            uint32_t endx = 0;
+            uint32_t tsa = 0;
+            uint32_t irqa = 0;
+            Adma adma;
+        };
+
+        void tastoOn(int core, uint32_t voci);
+        void tastoOff(int core, uint32_t voci);
+        void decodifica(int core, Voce &v);
+        void generaUno(int32_t &outL, int32_t &outR);
+        void controllaIrq(int core, uint32_t da, uint32_t quanti);
+        [[nodiscard]] uint16_t reg(uint32_t offset) const { return m_reg[offset >> 1u]; }
+
+        std::vector<uint16_t> m_ram;
+        std::vector<uint16_t> m_reg;
+        std::array<Core, 2> m_core;
+        uint32_t m_irqInAttesa = 0;
+        int64_t m_inizioNs = 0;
+        uint64_t m_generati = 0;
+        uint32_t m_conta = 0;
+        // Per il registro delle prove
+        uint64_t m_contaKon = 0, m_contaDma = 0, m_contaAdma = 0, m_contaIrq = 0;
+    };
+}
+
+// Per l'uscita audio del programma: prende fino a n coppie di campioni, torna quante.
+size_t sorSpu2Prendi(int16_t *coppie, size_t n);
