+    // Legge un texel di un formato preciso. Sta in una variabile locale: il compilatore tiene tutto nei registri.
+    template <PixelStorageMode P>
+    struct Lettore
+    {
+        using Tr = PixelStorageTraits<P>;
+        using PaginaT = std::array<std::array<uint16_t, Tr::PageExtent().x>, Tr::PageExtent().y>;
+        const PaginaT *t;
+        const u8 *vram;
+        TexturePageCache *cache;
+        uint32_t basePag, passo;
+        const uint32_t *pal;
+        GSTexaReg texa;
+
+        explicit Lettore(const VS &S)
+            : t(&tabella<P>()[S.tbp % BLOCKS_PER_PAGE]), vram(S.vramTex), cache(S.cache), basePag(S.tbp / BLOCKS_PER_PAGE),
+              passo((S.tbw * 64u) / Tr::PageExtent().x), pal(S.pal), texa(S.st->texa) {}
+
+        inline uint32_t operator()(uint32_t x, uint32_t y) const
+        {
+            constexpr uint32_t W = Tr::PageExtent().x, H = Tr::PageExtent().y;
+            const uint32_t pagina = basePag + (y / H) * passo + x / W;
+            const uint32_t pix = pagina * static_cast<uint32_t>(Tr::PixelsPerPage()) + (*t)[y % H][x % W];
+            const uint32_t bit = pix * static_cast<uint32_t>(UnpackedBitWidth(P)) + static_cast<uint32_t>(Tr::BitOffset());
+            using PackedT = typename Tr::PackedT;
+            const uint32_t byte = (bit / 8u) & static_cast<uint32_t>(MEMORY_SIZE - sizeof(PackedT));
+            const u8 *sorg = cache ? cache->Resolve(vram, byte) : vram + byte;
+            PackedT v;
+            std::memcpy(&v, sorg, sizeof(PackedT));
+            if constexpr (P == C32)
+                return v;
+            else if constexpr (P == C24)
+                return applyTexa(texa, GS_PSM_CT24, v & 0x00FFFFFFu);
+            else if constexpr (P == C16)
+                return applyTexa(texa, GS_PSM_CT16, Rgba5551ToRgba8888(static_cast<u16>(v)));
+            else if constexpr (P == P8 || P == P8H)
+                return pal[static_cast<uint8_t>(v)];
+            else
+                return pal[(static_cast<uint32_t>(v) >> (bit % 8u)) & 0x0Fu];
+        }
+
+        struct DiRiga
+        {
+            const Lettore &L;
+            const uint16_t *col;
+            uint32_t pagRiga;
+            inline uint32_t operator()(uint32_t x) const
+            {
+                constexpr uint32_t W = Tr::PageExtent().x;
+                const uint32_t pix = (pagRiga + x / W) * static_cast<uint32_t>(Tr::PixelsPerPage()) + col[x % W];
+                const uint32_t bit = pix * static_cast<uint32_t>(UnpackedBitWidth(P)) + static_cast<uint32_t>(Tr::BitOffset());
+                using PackedT = typename Tr::PackedT;
+                const uint32_t byte = (bit / 8u) & static_cast<uint32_t>(MEMORY_SIZE - sizeof(PackedT));
+                PackedT v;
+                std::memcpy(&v, L.vram + byte, sizeof(PackedT));
+                if constexpr (P == C32)
+                    return v;
+                else if constexpr (P == C24)
+                    return applyTexa(L.texa, GS_PSM_CT24, v & 0x00FFFFFFu);
+                else if constexpr (P == C16)
+                    return applyTexa(L.texa, GS_PSM_CT16, Rgba5551ToRgba8888(static_cast<u16>(v)));
+                else if constexpr (P == P8 || P == P8H)
+                    return L.pal[static_cast<uint8_t>(v)];
+                else
+                    return L.pal[(static_cast<uint32_t>(v) >> (bit % 8u)) & 0x0Fu];
+            }
+        };
+        static constexpr bool kDiRiga = true;
+        inline DiRiga riga(uint32_t y) const
+        {
+            constexpr uint32_t H = Tr::PageExtent().y;
+            return DiRiga{*this, (*t)[y % H].data(), basePag + (y / H) * passo};
+        }
+    };
+
+    // Per i formati rari (Z usata come texture, C16S): la via con il puntatore a funzione.
+    struct LettoreRaro
+    {
+        const VS &S;
+        explicit LettoreRaro(const VS &s) : S(s) {}
+        inline uint32_t operator()(uint32_t x, uint32_t y) const { return S.leggiTex(S, static_cast<int>(x), static_cast<int>(y)); }
+        struct DiRiga
+        {
+            const LettoreRaro &L;
+            uint32_t y;
+            inline uint32_t operator()(uint32_t x) const { return L(x, y); }
+        };
+        static constexpr bool kDiRiga = true;
+        inline DiRiga riga(uint32_t y) const { return DiRiga{*this, y}; }
+    };
+
+    template <PixelStorageMode P, const typename PixelStorageTraits<P>::PageLookupTableT &TAB>
+    uint32_t texCruda(const VS &S, int u, int v)
+    {
+        return PixelStorageTraits<P>::Read(TAB, S.vramTex, S.tbp, S.tbw, static_cast<u32>(u), static_cast<u32>(v), S.cache);
+    }
+    uint32_t tex16s(const VS &S, int u, int v) { return applyTexa(S.st->texa, GS_PSM_CT16S, Rgba5551ToRgba8888(static_cast<u16>(texCruda<C16S, PageTableC16S>(S, u, v)))); }
+    uint32_t texZ32(const VS &S, int u, int v) { return applyTexa(S.st->texa, GS_PSM_Z32, texCruda<Z32, PageTableZ32>(S, u, v)); }
+    uint32_t texZ24(const VS &S, int u, int v) { return applyTexa(S.st->texa, GS_PSM_Z24, texCruda<Z24, PageTableZ32>(S, u, v)); }
+    uint32_t texZ16(const VS &S, int u, int v) { return applyTexa(S.st->texa, GS_PSM_Z16, Rgba5551ToRgba8888(static_cast<u16>(texCruda<Z16, PageTableZ16>(S, u, v)))); }
+    uint32_t texZ16s(const VS &S, int u, int v) { return applyTexa(S.st->texa, GS_PSM_Z16S, Rgba5551ToRgba8888(static_cast<u16>(texCruda<Z16S, PageTableZ16S>(S, u, v)))); }
+    uint32_t texNulla(const VS &, int, int) { return 0xFFFF00FFu; }
+
+    inline uint32_t bilineare(uint32_t c00, uint32_t c10, uint32_t c01, uint32_t c11, int fx, int fy)
+    {
+        const __m128i z = _mm_setzero_si128();
+        const __m128i a = _mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(c00)), z);
+        const __m128i b = _mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(c10)), z);
+        const __m128i c = _mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(c01)), z);
+        const __m128i d = _mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(c11)), z);
+        const __m128i fX = _mm_set1_epi16(static_cast<short>(fx));
+        const __m128i iX = _mm_set1_epi16(static_cast<short>(256 - fx));
+        const __m128i fY = _mm_set1_epi16(static_cast<short>(fy));
+        const __m128i iY = _mm_set1_epi16(static_cast<short>(256 - fy));
+        const __m128i r = _mm_set1_epi16(128);
+        const __m128i su = _mm_srli_epi16(_mm_add_epi16(_mm_add_epi16(_mm_mullo_epi16(a, iX), _mm_mullo_epi16(b, fX)), r), 8);
+        const __m128i gi = _mm_srli_epi16(_mm_add_epi16(_mm_add_epi16(_mm_mullo_epi16(c, iX), _mm_mullo_epi16(d, fX)), r), 8);
+        const __m128i ris = _mm_srli_epi16(_mm_add_epi16(_mm_add_epi16(_mm_mullo_epi16(su, iY), _mm_mullo_epi16(gi, fY)), r), 8);
+        return static_cast<uint32_t>(_mm_cvtsi128_si32(_mm_packus_epi16(ris, z)));
+    }
+
+    // I dati della texture che non cambiano nella primitiva.
+    struct Campionatore
+    {
+        int texW, texH;
+        uint8_t wrapU, wrapV;
+        uint16_t minU, maxU, minV, maxV;
+        bool lineare;
+        explicit Campionatore(const VS &S)
+            : texW(S.texW), texH(S.texH), wrapU(S.wrapU), wrapV(S.wrapV), minU(S.minU), maxU(S.maxU), minV(S.minV), maxV(S.maxV), lineare(S.lineare) {}
+        inline int u(int c) const { return wrapTextureCoordinate(c, texW, wrapU, minU, maxU); }
+        inline int v(int c) const { return wrapTextureCoordinate(c, texH, wrapV, minV, maxV); }
+    };
+
+    template <class L>
+    inline uint32_t campiona(const L &leggi, const Campionatore &C, float texU, float texV)
+    {
+        if (!C.lineare)
+            return leggi(static_cast<uint32_t>(C.u(static_cast<int>(texU))), static_cast<uint32_t>(C.v(static_cast<int>(texV))));
+        const float su = texU - 0.5f;
+        const float sv = texV - 0.5f;
+        const int u0 = static_cast<int>(std::floor(su));
+        const int v0 = static_cast<int>(std::floor(sv));
+        const int fx = static_cast<int>((su - static_cast<float>(u0)) * 256.0f);
+        const int fy = static_cast<int>((sv - static_cast<float>(v0)) * 256.0f);
+        const uint32_t ua = static_cast<uint32_t>(C.u(u0));
+        const uint32_t va = static_cast<uint32_t>(C.v(v0));
+        const uint32_t c00 = leggi(ua, va);
+        if (fx == 0 && fy == 0)
+            return c00;
+        const uint32_t ub = static_cast<uint32_t>(C.u(u0 + 1));
+        const uint32_t vb = static_cast<uint32_t>(C.v(v0 + 1));
+        return bilineare(c00, leggi(ub, va), leggi(ua, vb), leggi(ub, vb), fx, fy);
+    }
+
+    // Colore della texture con quello del vertice (combineTexture).
+    struct Combinatore
+    {
+        uint8_t tfx;
+        bool tcc;
+        const GSTex0Reg *tex0;
+        explicit Combinatore(const VS &S) : tfx(S.tfx), tcc(S.tcc), tex0(&S.st->context.tex0) {}
+        inline uint32_t operator()(uint32_t t, uint32_t c) const
+        {
+            const uint32_t va = c & 0xFF000000u;
+            if (tfx == 0u)
+            {
+                const __m128i z = _mm_setzero_si128();
+                const __m128i tt = _mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(t)), z);
+                const __m128i cc = _mm_unpacklo_epi8(_mm_cvtsi32_si128(static_cast<int>(c)), z);
+                const __m128i m = _mm_srli_epi16(_mm_mullo_epi16(tt, cc), 7);
+                const uint32_t r = static_cast<uint32_t>(_mm_cvtsi128_si32(_mm_packus_epi16(m, z)));
+                return tcc ? r : ((r & 0x00FFFFFFu) | va);
+            }
+            if (tfx == 1u)
+                return tcc ? t : ((t & 0x00FFFFFFu) | va);
+            const TextureCombineResult o = combineTexture(*tex0, static_cast<uint8_t>(c), static_cast<uint8_t>(c >> 8), static_cast<uint8_t>(c >> 16), static_cast<uint8_t>(c >> 24),
+                                                          static_cast<uint8_t>(t), static_cast<uint8_t>(t >> 8), static_cast<uint8_t>(t >> 16), static_cast<uint8_t>(t >> 24));
+            return pack32(o.r, o.g, o.b, o.a);
+        }
+    };
