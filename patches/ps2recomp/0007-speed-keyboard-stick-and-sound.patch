+    const Op *fnClip(Ctx &c, const Op *o)
+    {
+        uint32_t w, v[3];
+        std::memcpy(&w, o->t + 3, 4);
+        std::memcpy(v, o->s, 12);
+        const int32_t lim = (w & 0x7F800000u) != 0u ? static_cast<int32_t>(w & 0x7FFFFFFFu) : 0x007FFFFF;
+        uint32_t f = 0u;
+        if (oltre(v[0], 0u, lim)) f |= 0x01u;
+        if (oltre(v[0], 0x80000000u, lim)) f |= 0x02u;
+        if (oltre(v[1], 0u, lim)) f |= 0x04u;
+        if (oltre(v[1], 0x80000000u, lim)) f |= 0x08u;
+        if (oltre(v[2], 0u, lim)) f |= 0x10u;
+        if (oltre(v[2], 0x80000000u, lim)) f |= 0x20u;
+        c.clipLavoro = ((c.clipLavoro << 6) | f) & 0xFFFFFFu;
+        c.clipAttesa[o->slot] = c.clipLavoro;
+        return o + 1;
+    }
