diff --git a/ps2xIOP/src/emulator/core/iop_spu2.cpp b/ps2xIOP/src/emulator/core/iop_spu2.cpp
new file mode 100644
index 0000000..8ec58c3
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.cpp
@@ -0,0 +1,607 @@
+#include "iop_spu2.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace
+{
+    constexpr uint32_t kRamParole = 1u << 20u; // 2 MB, a parole da 16 bit
+    constexpr uint32_t kRegParole = 0x800u / 2u;
+    constexpr uint32_t kFreq = 48000u;
+    constexpr int kIrqSpu = 9;
+
+    // Coda dei campioni: scrive il thread del gioco, legge il thread dell'audio.
+    constexpr size_t kCoda = 1u << 14u; // circa 340 ms
+    int16_t g_coda[kCoda * 2u];
+    std::atomic<size_t> g_testa{0u}, g_fondo{0u};
+
+    void metti(int16_t l, int16_t r)
+    {
+        const size_t t = g_testa.load(std::memory_order_relaxed);
+        if (t - g_fondo.load(std::memory_order_acquire) >= kCoda)
+            return; // piena: si perde
+        g_coda[(t & (kCoda - 1u)) * 2u] = l;
+        g_coda[(t & (kCoda - 1u)) * 2u + 1u] = r;
+        g_testa.store(t + 1u, std::memory_order_release);
+    }
+
+    int64_t adessoNs()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    constexpr int kFiltro0[5] = {0, 60, 115, 98, 122};
+    constexpr int kFiltro1[5] = {0, 0, -52, -55, -60};
+
+    // Un passo di inviluppo con la formula del chip.
+    inline void passoInviluppo(int32_t &livello, int &contatore, int rate, bool esponenziale, bool scende)
+    {
+        if (rate >= 0x7F)
+            return;
+        if (--contatore > 0)
+            return;
+        const int shift = rate >> 2;
+        int passo = scende ? (-8 + (rate & 3)) : (7 - (rate & 3));
+        int cicli = 1 << std::max(0, shift - 11);
+        passo = passo * (1 << std::max(0, 11 - shift));
+        if (esponenziale && !scende && livello > 0x6000)
+            cicli *= 4;
+        if (esponenziale && scende)
+            passo = static_cast<int>((static_cast<int64_t>(passo) * livello) / 0x8000);
+        contatore = cicli;
+        livello = std::clamp(livello + passo, 0, 0x7FFF);
+    }
+
+    inline int32_t volumeFisso(uint16_t r)
+    {
+        // 15 bit con segno, raddoppiati
+        return static_cast<int32_t>(static_cast<int16_t>(static_cast<uint16_t>(r << 1u)));
+    }
+
+    inline void aggiornaVolume(uint16_t r, int32_t &corrente, int &contatore)
+    {
+        if ((r & 0x8000u) == 0u)
+        {
+            corrente = volumeFisso(r);
+            return;
+        }
+        // Scivolata: bit 14 esponenziale, bit 13 scende, 7 bit di velocita'
+        passoInviluppo(corrente, contatore, r & 0x7Fu, (r & 0x4000u) != 0u, (r & 0x2000u) != 0u);
+    }
+
+    FILE *g_wav = nullptr;
+}
+
+size_t sorSpu2Prendi(int16_t *coppie, size_t n)
+{
+    size_t f = g_fondo.load(std::memory_order_relaxed);
+    const size_t disponibili = g_testa.load(std::memory_order_acquire) - f;
+    const size_t quanti = std::min(n, disponibili);
+    for (size_t i = 0; i < quanti; ++i)
+    {
+        coppie[i * 2u] = g_coda[((f + i) & (kCoda - 1u)) * 2u];
+        coppie[i * 2u + 1u] = g_coda[((f + i) & (kCoda - 1u)) * 2u + 1u];
+    }
+    g_fondo.store(f + quanti, std::memory_order_release);
+    return quanti;
+}
+
+namespace ps2x::iop::detail
+{
+    IopSpu2::IopSpu2() : m_ram(kRamParole), m_reg(kRegParole)
+    {
+        if (const char *e = std::getenv("SOR_AUDIO_PCM"))
+            g_wav = std::fopen(e, "wb");
+    }
+
+    void IopSpu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        std::fill(m_reg.begin(), m_reg.end(), uint16_t{0});
+        m_core = {};
+        m_irqInAttesa = 0u;
+        m_inizioNs = 0;
+        m_generati = 0u;
+    }
+
+    uint16_t IopSpu2::read16(uint32_t phys) const
+    {
+        const uint32_t o = phys & 0x7FEu;
+        if (o < 0x760u)
+        {
+            const int c = (o >> 10u) & 1;
+            const uint32_t r = o & 0x3FFu;
+            const Core &core = m_core[static_cast<size_t>(c)];
+            if (r < 0x180u)
+            {
+                const Voce &v = core.voci[r >> 4u];
+                switch (r & 0xFu)
+                {
+                case 0xAu:
+                    return static_cast<uint16_t>(v.livello);
+                case 0xCu:
+                    return static_cast<uint16_t>(v.volXL);
+                case 0xEu:
+                    return static_cast<uint16_t>(v.volXR);
+                default:
+                    break;
+                }
+            }
+            else if (r >= 0x1C0u && r < 0x2E0u)
+            {
+                const uint32_t i = (r - 0x1C0u) / 12u;
+                const Voce &v = core.voci[i];
+                switch ((r - 0x1C0u) % 12u)
+                {
+                case 8u:
+                    return static_cast<uint16_t>((v.nax >> 16u) & 0xFu);
+                case 10u:
+                    return static_cast<uint16_t>(v.nax);
+                default:
+                    break;
+                }
+            }
+            else if (r == 0x340u)
+                return static_cast<uint16_t>(core.endx);
+            else if (r == 0x342u)
+                return static_cast<uint16_t>(core.endx >> 16u);
+            else if (r == 0x1A8u)
+                return static_cast<uint16_t>((core.tsa >> 16u) & 0xFu);
+            else if (r == 0x1AAu)
+                return static_cast<uint16_t>(core.tsa);
+        }
+        return m_reg[o >> 1u];
+    }
+
+    void IopSpu2::write16(uint32_t phys, uint16_t value)
+    {
+        const uint32_t o = phys & 0x7FEu;
+        m_reg[o >> 1u] = value;
+        if (o >= 0x760u)
+            return;
+        const int c = (o >> 10u) & 1;
+        const uint32_t r = o & 0x3FFu;
+        Core &core = m_core[static_cast<size_t>(c)];
+        if (r < 0x180u)
+        {
+            Voce &v = core.voci[r >> 4u];
+            switch (r & 0xFu)
+            {
+            case 0x0u:
+                v.volL = value;
+                break;
+            case 0x2u:
+                v.volR = value;
+                break;
+            case 0x4u:
+                v.pitch = value;
+                break;
+            case 0x6u:
+                v.adsr1 = value;
+                break;
+            case 0x8u:
+                v.adsr2 = value;
+                break;
+            case 0xAu:
+                v.livello = value & 0x7FFFu;
+                break;
+            default:
+                break;
+            }
+            return;
+        }
+        if (r >= 0x1C0u && r < 0x2E0u)
+        {
+            const uint32_t i = (r - 0x1C0u) / 12u;
+            Voce &v = core.voci[i];
+            switch ((r - 0x1C0u) % 12u)
+            {
+            case 0u:
+                v.ssa = (v.ssa & 0xFFFFu) | (static_cast<uint32_t>(value & 0xFu) << 16u);
+                break;
+            case 2u:
+                v.ssa = (v.ssa & 0xF0000u) | value;
+                break;
+            case 4u:
+                v.lsa = (v.lsa & 0xFFFFu) | (static_cast<uint32_t>(value & 0xFu) << 16u);
+                v.lsaManuale = v.lsaNuova = true;
+                break;
+            case 6u:
+                v.lsa = (v.lsa & 0xF0000u) | value;
+                v.lsaManuale = v.lsaNuova = true;
+                break;
+            case 8u:
+                v.nax = (v.nax & 0xFFFFu) | (static_cast<uint32_t>(value & 0xFu) << 16u);
+                v.indice = 28;
+                break;
+            case 10u:
+                v.nax = (v.nax & 0xF0000u) | value;
+                v.indice = 28;
+                break;
+            default:
+                break;
+            }
+            return;
+        }
+        switch (r)
+        {
+        case 0x19Cu:
+            core.irqa = (core.irqa & 0xFFFFu) | (static_cast<uint32_t>(value & 0xFu) << 16u);
+            break;
+        case 0x19Eu:
+            core.irqa = (core.irqa & 0xF0000u) | value;
+            break;
+        case 0x19Au: // ATTR: togliere il bit 6 spegne la richiesta
+            if ((value & 0x40u) == 0u)
+                m_reg[(0x344u + (static_cast<uint32_t>(c) << 10u)) >> 1u] &= static_cast<uint16_t>(~0x40u);
+            break;
+        case 0x1A0u:
+            tastoOn(c, value);
+            break;
+        case 0x1A2u:
+            tastoOn(c, static_cast<uint32_t>(value & 0xFFu) << 16u);
+            break;
+        case 0x1A4u:
+            tastoOff(c, value);
+            break;
+        case 0x1A6u:
+            tastoOff(c, static_cast<uint32_t>(value & 0xFFu) << 16u);
+            break;
+        case 0x1A8u:
+            core.tsa = (core.tsa & 0xFFFFu) | (static_cast<uint32_t>(value & 0xFu) << 16u);
+            break;
+        case 0x1AAu:
+            core.tsa = (core.tsa & 0xF0000u) | value;
+            break;
+        case 0x1ACu: // trasferimento a mano
+            controllaIrq(c, core.tsa, 1u);
+            m_ram[core.tsa & (kRamParole - 1u)] = value;
+            core.tsa = (core.tsa + 1u) & (kRamParole - 1u);
+            break;
+        case 0x340u:
+            core.endx &= ~static_cast<uint32_t>(value);
+            break;
+        case 0x342u:
+            core.endx &= ~(static_cast<uint32_t>(value & 0xFFu) << 16u);
+            break;
+        default:
+            break;
+        }
+    }
+
+    void IopSpu2::tastoOn(int core, uint32_t voci)
+    {
+        Core &c = m_core[static_cast<size_t>(core)];
+        for (uint32_t i = 0; i < 24u; ++i)
+        {
+            if ((voci & (1u << i)) == 0u)
+                continue;
+            Voce &v = c.voci[i];
+            v.nax = v.ssa;
+            v.livello = 0;
+            v.contatore = 0;
+            v.fase = 1u;
+            v.passo = 0u;
+            v.indice = 28;
+            v.flag = 0u;
+            v.prev1 = v.prev2 = 0;
+            std::memset(v.storia, 0, sizeof(v.storia));
+            v.lsaManuale = v.lsaNuova;
+            v.lsaNuova = false;
+            c.endx &= ~(1u << i);
+            ++m_contaKon;
+        }
+    }
+
+    void IopSpu2::tastoOff(int core, uint32_t voci)
+    {
+        Core &c = m_core[static_cast<size_t>(core)];
+        for (uint32_t i = 0; i < 24u; ++i)
+        {
+            if ((voci & (1u << i)) != 0u && c.voci[i].fase != 0u)
+            {
+                c.voci[i].fase = 4u;
+                c.voci[i].contatore = 0;
+            }
+        }
+    }
+
+    void IopSpu2::controllaIrq(int core, uint32_t da, uint32_t quanti)
+    {
+        // IRQA vale per tutti e due i core sul chip vero se l'indirizzo letto coincide.
+        for (int k = 0; k < 2; ++k)
+        {
+            const uint32_t attr = reg(0x19Au + (static_cast<uint32_t>(k) << 10u));
+            if ((attr & 0x40u) == 0u)
+                continue;
+            const uint32_t a = m_core[static_cast<size_t>(k)].irqa;
+            if (((a - da) & (kRamParole - 1u)) < quanti)
+            {
+                m_reg[(0x344u + (static_cast<uint32_t>(k) << 10u)) >> 1u] |= 0x40u;
+                m_irqInAttesa |= 1u << kIrqSpu;
+                ++m_contaIrq;
+            }
+        }
+        (void)core;
+    }
+
+    void IopSpu2::decodifica(int core, Voce &v)
+    {
+        const uint32_t base = v.nax & (kRamParole - 8u);
+        controllaIrq(core, base, 8u);
+        const uint16_t testa = m_ram[base];
+        int shift = testa & 0xFu;
+        if (shift > 12)
+            shift = 9;
+        int filtro = (testa >> 4u) & 7;
+        if (filtro > 4)
+            filtro = 4;
+        v.flag = static_cast<uint8_t>(testa >> 8u);
+        if ((v.flag & 4u) != 0u && !v.lsaManuale)
+            v.lsa = base;
+        const int f0 = kFiltro0[filtro], f1 = kFiltro1[filtro];
+        for (int i = 0; i < 28; ++i)
+        {
+            const uint16_t parola = m_ram[(base + 1u + static_cast<uint32_t>(i) / 4u) & (kRamParole - 1u)];
+            const int nibble = (parola >> ((i & 3) * 4)) & 0xF;
+            int32_t s = static_cast<int16_t>(static_cast<uint16_t>(nibble << 12)) >> shift;
+            s += (v.prev1 * f0 + v.prev2 * f1 + 32) >> 6;
+            s = std::clamp(s, -32768, 32767);
+            v.blocco[i] = static_cast<int16_t>(s);
+            v.prev2 = v.prev1;
+            v.prev1 = s;
+        }
+        v.nax = (base + 8u) & (kRamParole - 1u);
+        v.indice = 0;
+    }
+
+    void IopSpu2::generaUno(int32_t &outL, int32_t &outR)
+    {
+        int32_t uscitaL = 0, uscitaR = 0;
+        for (int c = 0; c < 2; ++c)
+        {
+            Core &core = m_core[static_cast<size_t>(c)];
+            const uint32_t b = static_cast<uint32_t>(c) << 10u;
+            const uint32_t mixL = reg(0x188u + b) | (static_cast<uint32_t>(reg(0x18Au + b)) << 16u);
+            const uint32_t mixR = reg(0x190u + b) | (static_cast<uint32_t>(reg(0x192u + b)) << 16u);
+            int64_t l = 0, r = 0;
+            for (uint32_t i = 0; i < 24u; ++i)
+            {
+                Voce &v = core.voci[i];
+                if (v.fase == 0u)
+                    continue;
+                // Inviluppo
+                {
+                    const uint16_t a1 = v.adsr1, a2 = v.adsr2;
+                    switch (v.fase)
+                    {
+                    case 1u:
+                        passoInviluppo(v.livello, v.contatore, (a1 >> 8u) & 0x7Fu, (a1 & 0x8000u) != 0u, false);
+                        if (v.livello >= 0x7FFF)
+                        {
+                            v.fase = 2u;
+                            v.contatore = 0;
+                        }
+                        break;
+                    case 2u:
+                    {
+                        passoInviluppo(v.livello, v.contatore, ((a1 >> 4u) & 0xFu) << 2u, true, true);
+                        if (v.livello <= static_cast<int32_t>(((a1 & 0xFu) + 1u) * 0x800u))
+                        {
+                            v.fase = 3u;
+                            v.contatore = 0;
+                        }
+                        break;
+                    }
+                    case 3u:
+                        passoInviluppo(v.livello, v.contatore, (a2 >> 6u) & 0x7Fu, (a2 & 0x8000u) != 0u, (a2 & 0x4000u) != 0u);
+                        break;
+                    default:
+                        passoInviluppo(v.livello, v.contatore, (a2 & 0x1Fu) << 2u, (a2 & 0x20u) != 0u, true);
+                        if (v.livello <= 0)
+                        {
+                            v.fase = 0u;
+                            continue;
+                        }
+                        break;
+                    }
+                }
+                // Voce: i campioni nuovi che servono
+                v.passo += std::min<uint32_t>(v.pitch, 0x3FFFu);
+                while (v.passo >= 0x1000u)
+                {
+                    v.passo -= 0x1000u;
+                    if (v.indice >= 28)
+                    {
+                        // Il blocco appena finito aveva la fine?
+                        if ((v.flag & 1u) != 0u)
+                        {
+                            core.endx |= 1u << i;
+                            v.nax = v.lsa;
+                            if ((v.flag & 2u) == 0u)
+                            {
+                                v.fase = 0u;
+                                v.livello = 0;
+                                break;
+                            }
+                        }
+                        decodifica(c, v);
+                    }
+                    v.storia[0] = v.storia[1];
+                    v.storia[1] = v.storia[2];
+                    v.storia[2] = v.storia[3];
+                    v.storia[3] = v.blocco[v.indice++];
+                }
+                if (v.fase == 0u)
+                    continue;
+                // Interpolazione cubica fra gli ultimi quattro campioni
+                const float t = static_cast<float>(v.passo) / 4096.0f;
+                const float p0 = static_cast<float>(v.storia[0]), p1 = static_cast<float>(v.storia[1]);
+                const float p2 = static_cast<float>(v.storia[2]), p3 = static_cast<float>(v.storia[3]);
+                const float s = p1 + 0.5f * t * (p2 - p0 + t * (2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3 + t * (3.0f * (p1 - p2) + p3 - p0)));
+                const int32_t campione = (static_cast<int32_t>(s) * v.livello) >> 15;
+                aggiornaVolume(v.volL, v.volXL, v.contatore);
+                aggiornaVolume(v.volR, v.volXR, v.contatore);
+                if ((mixL & (1u << i)) != 0u)
+                    l += (campione * v.volXL) >> 15;
+                if ((mixR & (1u << i)) != 0u)
+                    r += (campione * v.volXR) >> 15;
+            }
+            // Flusso PCM continuo (ADMA)
+            Adma &a = core.adma;
+            if (a.attivo)
+            {
+                if (a.posizione >= 256)
+                {
+                    if (a.resto == 0u)
+                    {
+                        a.attivo = false;
+                    }
+                    else
+                    {
+                        const uint32_t quanti = std::min<uint32_t>(a.resto, 1024u);
+                        std::memset(a.l, 0, sizeof(a.l));
+                        std::memset(a.r, 0, sizeof(a.r));
+                        if (a.indirizzo + quanti <= a.ramSize)
+                        {
+                            std::memcpy(a.l, a.ram + a.indirizzo, std::min<uint32_t>(quanti, 512u));
+                            if (quanti > 512u)
+                                std::memcpy(a.r, a.ram + a.indirizzo + 512u, quanti - 512u);
+                        }
+                        a.indirizzo += quanti;
+                        a.resto -= quanti;
+                        a.posizione = 0;
+                        // Il chip ha un po' di memoria: il DMA finisce quando l'ultimo blocco e' entrato, non
+                        // quando e' stato suonato. Cosi' il driver fa in tempo a mandare il pezzo dopo.
+                        if (a.resto == 0u)
+                            m_irqInAttesa |= 1u << (c == 0 ? 4u : 8u);
+                    }
+                }
+                if (a.attivo)
+                {
+                    const uint32_t bv = static_cast<uint32_t>(c) * 0x28u;
+                    l += (a.l[a.posizione] * volumeFisso(reg(0x768u + bv))) >> 15;
+                    r += (a.r[a.posizione] * volumeFisso(reg(0x76Au + bv))) >> 15;
+                    ++a.posizione;
+                }
+            }
+            // Volume generale del core, e l'uscita del core 0 entra nel core 1
+            const uint32_t bv = static_cast<uint32_t>(c) * 0x28u;
+            const uint16_t mL = reg(0x760u + bv), mR = reg(0x762u + bv);
+            const int32_t volL = (mL & 0x8000u) ? 0x7FFF : volumeFisso(mL);
+            const int32_t volR = (mR & 0x8000u) ? 0x7FFF : volumeFisso(mR);
+            uscitaL += static_cast<int32_t>((std::clamp<int64_t>(l, -32768, 32767) * volL) >> 15);
+            uscitaR += static_cast<int32_t>((std::clamp<int64_t>(r, -32768, 32767) * volR) >> 15);
+        }
+        outL = std::clamp(uscitaL, -32768, 32767);
+        outR = std::clamp(uscitaR, -32768, 32767);
+    }
+
+    bool IopSpu2::dma(int core, uint8_t *ram, uint32_t ramSize, uint32_t indirizzo, uint32_t parole, bool versoChip)
+    {
+        Core &c = m_core[static_cast<size_t>(core)];
+        const uint32_t bytes = parole * 4u;
+        m_contaDma += bytes;
+        const uint32_t admas = reg(0x1B0u + (static_cast<uint32_t>(core) << 10u));
+        if (versoChip && (admas & (1u << static_cast<uint32_t>(core))) != 0u)
+        {
+            ++m_contaAdma;
+            c.adma.attivo = true;
+            c.adma.ram = ram;
+            c.adma.ramSize = ramSize;
+            c.adma.indirizzo = indirizzo & (ramSize - 1u);
+            c.adma.resto = bytes;
+            return false;
+        }
+        const uint32_t fisico = indirizzo & 0x1FFFFFu;
+        const uint32_t mezze = bytes / 2u;
+        if (fisico + bytes > ramSize)
+            return true;
+        controllaIrq(core, c.tsa, mezze);
+        for (uint32_t i = 0; i < mezze; ++i)
+        {
+            const uint32_t pos = (c.tsa + i) & (kRamParole - 1u);
+            if (versoChip)
+                std::memcpy(&m_ram[pos], ram + fisico + i * 2u, 2u);
+            else
+                std::memcpy(ram + fisico + i * 2u, &m_ram[pos], 2u);
+        }
+        c.tsa = (c.tsa + mezze) & (kRamParole - 1u);
+        return true;
+    }
+
+    void IopSpu2::orologio()
+    {
+        if ((++m_conta & 15u) != 0u)
+            return;
+        const int64_t ora = adessoNs();
+        if (m_inizioNs == 0)
+            m_inizioNs = ora;
+        const uint64_t dovuti = static_cast<uint64_t>(ora - m_inizioNs) / 1000u * kFreq / 1000000u + 4800u; // 100 ms di anticipo
+        uint64_t mancano = dovuti > m_generati ? dovuti - m_generati : 0u;
+        if (mancano > 2400u)
+        {
+            // Il gioco e' rimasto fermo (caricamento): non si recupera tutto.
+            m_generati += mancano - 2400u;
+            mancano = 2400u;
+        }
+        static int64_t s_ultimoRapporto = ora;
+        static int s_picco = 0;
+        static uint64_t s_somma = 0, s_n = 0;
+        static const bool s_rapporto = std::getenv("SOR_TEMPI") != nullptr;
+        for (uint64_t i = 0; i < mancano; ++i)
+        {
+            int32_t l, r;
+            generaUno(l, r);
+            metti(static_cast<int16_t>(l), static_cast<int16_t>(r));
+            if (g_wav)
+            {
+                const int16_t due[2] = {static_cast<int16_t>(l), static_cast<int16_t>(r)};
+                std::fwrite(due, 2, 2, g_wav);
+            }
+            if (s_rapporto)
+            {
+                s_picco = std::max(s_picco, std::abs(l));
+                s_somma += static_cast<uint64_t>(static_cast<int64_t>(l) * l);
+                ++s_n;
+            }
+        }
+        m_generati += mancano;
+        if (s_rapporto && ora - s_ultimoRapporto >= 1000000000)
+        {
+            s_ultimoRapporto = ora;
+            int attive = 0;
+            for (const Core &c : m_core)
+                for (const Voce &v : c.voci)
+                    attive += v.fase != 0u ? 1 : 0;
+            std::printf("[spu] voci %d kon %llu dma %llu adma %llu irq %llu picco %d rms %.0f campioni/s %llu\n", attive, static_cast<unsigned long long>(m_contaKon),
+                        static_cast<unsigned long long>(m_contaDma), static_cast<unsigned long long>(m_contaAdma), static_cast<unsigned long long>(m_contaIrq), s_picco,
+                        s_n ? std::sqrt(static_cast<double>(s_somma) / static_cast<double>(s_n)) : 0.0, static_cast<unsigned long long>(s_n));
+            std::fflush(stdout);
+            if (g_wav)
+                std::fflush(g_wav);
+            s_picco = 0;
+            s_somma = 0;
+            s_n = 0;
+        }
+    }
+
+    int IopSpu2::prendiInterruzione()
+    {
+        if (m_irqInAttesa == 0u)
+            return -1;
+        const int n = __builtin_ctz(m_irqInAttesa);
+        m_irqInAttesa &= m_irqInAttesa - 1u;
+        // Le fini del DMA continuo usano gli stessi numeri degli altri trasferimenti.
+        if (n == 4)
+            return 0x24;
+        if (n == 8)
+            return 0x28;
+        return n;
+    }
+}
