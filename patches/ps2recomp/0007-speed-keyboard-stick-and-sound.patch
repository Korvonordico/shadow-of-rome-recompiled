+                                { giro(i); });
+    }
+
+    void esegui(Tipo tipo, Extra *e)
+    {
+        ++g_sorGsTipi[static_cast<uint32_t>(tipo)];
+        Cronometro cr(g_sorGsTipiUs[static_cast<uint32_t>(tipo)]);
+        switch (tipo)
+        {
+        case Tipo::Immagine:
+            cpu.UploadImage(e->dati.data(), static_cast<uint32_t>(e->dati.size()));
+            break;
+        case Tipo::Foto:
+            if (!foto)
+            {
+                auto nuova = std::make_unique<uint8_t[]>(vramSize);
+                std::memcpy(nuova.get(), vram, vramSize);
+                foto = std::move(nuova);
+            }
+            else
+                for (uint32_t i = 0; i < 8u; ++i)
+                {
+                    uint64_t resto = e->pagine.bit[i];
+                    while (resto != 0u)
+                    {
+                        const uint32_t p = i * 64u + static_cast<uint32_t>(__builtin_ctzll(resto));
+                        resto &= resto - 1u;
+                        std::memcpy(foto.get() + p * 8192u, vram + p * 8192u, 8192u);
+                    }
+                }
+            break;
+        case Tipo::Trasferimento:
+            cpu.BeginTransfer(e->trasferimento);
+            break;
+        case Tipo::Pulizia:
+            cpu.ClearFramebuffer(e->contesto, e->rgba);
+            break;
+        case Tipo::Lento:
+            if (e->flush)
+                cpu.TextureFlush();
+            cpu.Submit(e->batch);
+            break;
+        case Tipo::VeloceSolo:
+            cpu.DisegnaVeloceSolo(e->batch, e->flush);
+            break;
+        case Tipo::ScriviVram:
+            cpu.WriteVram(e->psm, e->base, e->bw, e->x, e->y, e->valore);
+            break;
+        case Tipo::Azzera:
+            cpu.Reset();
+            break;
+        case Tipo::Copia:
+        {
+            int libera = 0;
+            {
+                std::lock_guard<std::mutex> lock(mutexCopie);
+                while (libera == copiaUltima || libera == copiaInLettura)
+                    ++libera;
+            }
+            if (!copie[libera])
+                copie[libera] = std::make_unique<uint8_t[]>(vramSize);
+            std::memcpy(copie[libera].get(), vram, vramSize);
+            {
+                std::lock_guard<std::mutex> lock(mutexCopie);
+                copiaUltima = libera;
+            }
+            copieFatte.fetch_add(1u, std::memory_order_release);
