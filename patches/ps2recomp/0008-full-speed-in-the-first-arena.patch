+// sor: il filo del gioco (solo lui aspetta) e quello del VIF.
+namespace
+{
+    thread_local bool t_sorThreadGioco = false;
+    // Il thread del gioco che aspetta il VIF: dorme, cosi' il suo core lavora per chi disegna.
+    std::mutex s_sorAttesaMutex;
+    std::condition_variable s_sorAttesaSveglia;
+    std::atomic<uint32_t> s_sorAttende{0u};
+    // I registri che non hanno a che fare con VIF1, VU1 e GS: non serve aspettare.
+    inline bool sorRegistroLibero(uint32_t a)
+    {
+        return (a >= 0x10000000u && a < 0x10002000u) || // timer
+               a == 0x10003010u ||                      // GIF_MODE: si limita a stare nel registro
+               (a >= 0x1000A000u && a < 0x1000A100u) || // il canale DMA del GIF: va in coda anche lui
+               (a >= 0x10009000u && a < 0x10009100u) || // il canale DMA di VIF1
+               (a >= 0x1000B000u && a < 0x1000D500u) || // i canali di IPU, SIF e scratchpad
+               (a >= 0x1000E000u && a < 0x1000F600u);   // DMAC e interruzioni
+    }
+}
+
+void PS2Memory::sorAvvisaThreadGioco()
+{
+    t_sorThreadGioco = true;
+}
+
+void PS2Memory::sorVifAspetta(uint32_t chi) const
+{
+    if (!t_sorThreadGioco || m_sorVifInCorso.load(std::memory_order_acquire) == 0u)
+        return;
+    extern uint64_t g_sorEeFermoUs;
+    const auto t0 = std::chrono::steady_clock::now();
+    int giri = 0;
+    while (m_sorVifInCorso.load(std::memory_order_acquire) != 0u)
+    {
+        if (++giri < 2000)
+            _mm_pause();
+        else
+            std::this_thread::yield();
+    }
+    g_sorEeFermoUs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count());
+}
+
+void sorThreadIdeale(int core); // pc/sor_prove.cpp
+
+void PS2Memory::sorVifGiro()
+{
+    sorThreadIdeale(0);
+    for (;;)
+    {
+        PendingTransfer p;
+        {
+            std::unique_lock<std::mutex> lock(m_sorVifMutex);
+            m_sorVifSveglia.wait(lock, [this]()
+                                 { return !m_sorVifCoda.empty(); });
+            p = std::move(m_sorVifCoda.front());
+            m_sorVifCoda.pop_front();
+        }
+        if (p.vblank)
+        {
+            m_sorVblankFn();
+            m_sorVblankInCoda.fetch_sub(1u, std::memory_order_seq_cst);
+            m_sorVifInCorso.fetch_sub(1u, std::memory_order_release);
+            if (s_sorAttende.load(std::memory_order_seq_cst) != 0u)
+            {
+                std::lock_guard<std::mutex> lock(s_sorAttesaMutex);
+                s_sorAttesaSveglia.notify_all();
+            }
+            continue;
+        }
+        if (p.versoGif)
+        {
+            m_seenGifCopy = true;
+            m_gifCopyCount.fetch_add(1, std::memory_order_relaxed);
+            submitGifPacket(GifPathId::Path3, p.chainData.data(), static_cast<uint32_t>(p.chainData.size()), false);
+        }
+        else
+            processVIF1Data(p.chainData.data(), static_cast<uint32_t>(p.chainData.size()));
+        if (m_gifArbiter)
+            m_gifArbiter->drain();
+        m_sorVifInCorso.fetch_sub(1u, std::memory_order_release);
+    }
+}
+
+// Mette in coda i trasferimenti verso VIF1. Torna false se devono girare sul thread del gioco.
+bool PS2Memory::sorVifAccoda(std::vector<PendingTransfer> &lista, bool versoGif)
+{
+    static const bool s_sincrono = std::getenv("SOR_VIFSINCRONO") != nullptr;
+    if (s_sincrono || !t_sorThreadGioco)
+        return false;
+    for (auto &p : lista)
+    {
+        p.versoGif = versoGif;
+        if (p.chainData.empty() && p.qwc > 0)
+        {
+            // Una catena e' gia' copiata; qui si copia anche il trasferimento semplice, perche' il gioco si
+            // puo' riprendere la sua memoria appena crede che il DMA sia finito.
+            uint32_t srcPhys = 0;
+            try
+            {
+                srcPhys = translateAddress(p.srcAddr);
+            }
+            catch (const std::exception &)
+            {
+                continue;
+            }
+            const uint64_t bytes = static_cast<uint64_t>(p.qwc) * 16ull;
+            const uint8_t *base = p.fromScratchpad ? m_scratchpad : m_rdram;
+            const uint32_t limite = p.fromScratchpad ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+            p.chainData.resize(bytes);
+            uint64_t fatti = 0;
+            while (fatti < bytes)
+            {
+                if (srcPhys >= limite)
+                    srcPhys = 0;
+                const uint64_t pezzo = std::min<uint64_t>(bytes - fatti, limite - srcPhys);
+                std::memcpy(p.chainData.data() + fatti, base + srcPhys, pezzo);
+                fatti += pezzo;
+                srcPhys += static_cast<uint32_t>(pezzo);
+            }
+        }
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_sorVifMutex);
+        for (auto &p : lista)
+        {
+            if (p.chainData.empty())
+                continue;
+            m_sorVifInCorso.fetch_add(1u, std::memory_order_acq_rel);
+            m_sorVifCoda.push_back(std::move(p));
+        }
+    }
+    m_sorVifSveglia.notify_one();
+    if (!m_sorVifPartito)
+    {
+        m_sorVifPartito = true;
+        m_sorVifThread = std::thread([this]()
+                                     { sorVifGiro(); });
+        m_sorVifThread.detach();
+    }
+    return true;
+}
+
+void PS2Memory::sorVifVblank()
+{
+    if (!m_sorVblankFn)
+        return;
+    if (!m_sorVifPartito || !t_sorThreadGioco)
+    {
+        sorVifAspetta(12u);
+        m_sorVblankFn();
+        return;
+    }
+    // Il gioco non deve correre piu' di due vblank davanti al thread del VIF.
+    extern uint64_t g_sorEeRitmoUs;
+    if (m_sorVblankInCoda.load(std::memory_order_acquire) >= 2u)
+    {
+        const auto t0 = std::chrono::steady_clock::now();
+        {
+            std::unique_lock<std::mutex> lock(s_sorAttesaMutex);
+            s_sorAttende.store(1u, std::memory_order_seq_cst);
+            while (!s_sorAttesaSveglia.wait_for(lock, std::chrono::milliseconds(2), [this]()
+                                                { return m_sorVblankInCoda.load(std::memory_order_seq_cst) < 2u; }))
+            {
+            }
+            s_sorAttende.store(0u, std::memory_order_seq_cst);
+        }
+        g_sorEeRitmoUs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count());
+    }
+    PendingTransfer p;
+    p.vblank = true;
+    m_sorVblankInCoda.fetch_add(1u, std::memory_order_acq_rel);
+    m_sorVifInCorso.fetch_add(1u, std::memory_order_acq_rel);
+    {
+        std::lock_guard<std::mutex> lock(m_sorVifMutex);
+        m_sorVifCoda.push_back(std::move(p));
+    }
+    m_sorVifSveglia.notify_one();
+}
