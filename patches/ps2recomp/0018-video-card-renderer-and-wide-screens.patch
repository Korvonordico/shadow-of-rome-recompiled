+#pragma once
+#include <cstdint>
+
+struct GSRegisters;
+
+// Mirror of the game's GS traffic to PCSX2's GS on the video card (sor-gs.dll). No-ops when it is off.
+bool sorGpuMirrorOn();
+// True while PCSX2's GS draws the picture inside the game's window: the CPU drawing and its presentation are
+// skipped then (SOR_GPU_CPU_DRAW=1 keeps them, for side-by-side tests).
+bool sorGpuDrawsWindow();
+// Pictures PCSX2's GS has shown so far (its own thread); false with an older sor-gs.dll.
+bool sorGpuFramesShown(uint64_t &shown);
+void sorGpuMirrorGif(const uint8_t *data, uint32_t sizeBytes);
+void sorGpuMirrorReg(uint8_t reg, uint64_t value);
+void sorGpuMirrorImage(uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir, const uint8_t *data,
+                       uint32_t sizeBytes);
+void sorGpuMirrorVblank(const GSRegisters *priv);
+// Closes PCSX2's GS cleanly (also at exit, by itself): call it before std::_Exit.
+void sorGpuMirrorClose();
