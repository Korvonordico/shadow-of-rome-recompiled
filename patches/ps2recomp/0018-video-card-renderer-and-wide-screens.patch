     return false;
 }
 
+static bool sorSprInterleaveOn()
+{   // sor: SOR_SHADOWFIX=0 brings back the old (wrong) sceDmaSendI behaviour
+    static const bool on = [] { const char *e = std::getenv("SOR_SHADOWFIX"); return !(e && e[0] == '0'); }();
+    return on;
+}
+
 bool PS2Memory::tryProcessScratchpadDma(uint32_t channelBase, uint32_t chcr)
 {
     static constexpr uint32_t kSprFromChannel = 0x1000D000u;
@@ -1798,6 +1804,54 @@ bool PS2Memory::tryProcessScratchpadDma(uint32_t channelBase, uint32_t chcr)
         return false;
 
     const uint32_t mode = (chcr >> 2u) & 0x3u;
+    if (mode == 2u && sorSprInterleaveOn())
+    {   // sor: interleave mode. Copy TQWC qwords, then skip SQWC qwords on the main-memory side (D_SQWC).
+        uint32_t qwcLeft = m_ioRegisters[channelBase + 0x20u] & 0xFFFFu;
+        const uint32_t sqwcReg = m_ioRegisters.count(0x1000E030u) ? m_ioRegisters[0x1000E030u] : 0u;
+        uint32_t tqwc = (sqwcReg >> 16u) & 0xFFu;
+        const uint32_t skip = sqwcReg & 0xFFu;
+        if (tqwc == 0u)
+            tqwc = qwcLeft;
+        uint32_t madr = m_ioRegisters[channelBase + 0x10u] & 0x7FFFFFF0u;
+        uint32_t sadr = m_ioRegisters[channelBase + 0x80u] & 0x3FF0u;
+        const bool fromSpr = channelBase == kSprFromChannel;
+        while (qwcLeft != 0u)
+        {
+            const uint32_t n = std::min(tqwc, qwcLeft);
+            qwcLeft -= n;
+            for (uint32_t i = 0; i < n; ++i)
+            {
+                uint32_t mainOffset = 0u;
+                try
+                {
+                    mainOffset = translateAddress(madr + i * 16u);
+                }
+                catch (const std::exception &)
+                {
+                    return false;
+                }
+                if (mainOffset > PS2_RAM_SIZE - 16u)
+                    return false;
+                const uint32_t so = (sadr + i * 16u) & (PS2_SCRATCHPAD_SIZE - 16u);
+                if (fromSpr)
+                {
+                    std::memcpy(m_rdram + mainOffset, m_scratchpad + so, 16u);
+                    markModified(mainOffset, 16u);
+                }
+                else
+                {
+                    std::memcpy(m_scratchpad + so, m_rdram + mainOffset, 16u);
+                }
+            }
+            sadr = (sadr + n * 16u) & 0x3FF0u;
+            madr = (madr + (n + skip) * 16u) & 0x7FFFFFF0u;
+        }
+        m_ioRegisters[channelBase + 0x10u] = madr;
+        m_ioRegisters[channelBase + 0x20u] = 0u;
+        m_ioRegisters[channelBase + 0x80u] = sadr;
+        completeDmacChannel(channelBase, fromSpr ? 8u : 9u);
+        return true;
+    }
     if (mode != 0u)
         return false;
 
