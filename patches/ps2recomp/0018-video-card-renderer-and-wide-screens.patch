+// Mirror of everything the game sends to the GS, forwarded to PCSX2's GS (sor-gs.dll), which draws it on the video
+// card. Turned on by a file named "gpu" next to sor.exe (or SOR_GPU=1); without it nothing changes.
+// SPDX-License-Identifier: GPL-3.0+
+#include "runtime/gs/gs_pcsx2_mirror.h"
+#include "runtime/ps2_memory.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
+
+extern "C" void *GetWindowHandle(void); // raylib
+extern std::atomic<uint32_t> g_sorVblankUs; // EeScheduler.cpp: 20000 PAL, 16667 NTSC
+// VSYNC: the screen's pace (sor-gs.dll's sorgs_pace), read by the game's clock (EeScheduler.cpp); 0 = the game's own.
+static std::atomic<long long (*)(unsigned int)> s_sorPaceFn{nullptr};
+int64_t sorGsPaceNs(uint32_t nominalUs)
+{
+    const auto f = s_sorPaceFn.load(std::memory_order_relaxed);
+    return f ? static_cast<int64_t>(f(nominalUs)) : 0;
+}
+
+namespace
+{
+    using OpenFn = int (*)(void *, float, int);
+    using RegsFn = void *(*)();
+    using GifFn = void (*)(const void *, unsigned int);
+    using VsyncFn = void (*)(unsigned int);
+    using SnapFn = void (*)(const char *);
+
+    std::recursive_mutex s_lock;
+    int s_state = 0; // 0 unknown, 1 on, -1 off
+    bool s_opened = false;
+    OpenFn s_open = nullptr;
+    RegsFn s_regs = nullptr;
+    GifFn s_gif = nullptr;
+    VsyncFn s_vsync = nullptr;
+    SnapFn s_snap = nullptr;
+    using CloseFn = void (*)();
+    CloseFn s_close = nullptr;
+    using ShownFn = unsigned long long (*)();
+    ShownFn s_shownFn = nullptr;
+    void (*s_wideFn)(int) = nullptr; // sor-gs.dll's sorgs_wide: 1 wide, 0 4:3 (widescreen only)
+    float s_upscale = 1.0f;
+    int s_renderer = 1;
+    int s_attach = 0; // 1: draw inside the game's window; 0: a window of its own (side by side, for tests)
+    std::atomic<bool> s_drawsWindow{false}; // read without the lock, at every draw
+    unsigned long long s_dropped = 0;
+    std::string s_dir;
+    unsigned s_field = 0;
+    unsigned long long s_frames = 0;
+    std::vector<uint8_t> s_buf;
+
+    bool enabledUnlocked()
+    {
+        if (s_state != 0)
+            return s_state > 0;
+        s_state = -1;
+#if defined(_WIN32)
+        char exe[MAX_PATH] = {};
+        GetModuleFileNameA(nullptr, exe, MAX_PATH);
+        std::string dir(exe);
+        dir = dir.substr(0, dir.find_last_of("\\/") + 1);
+        s_dir = dir;
+        bool on = false;
+        // The player's choice in the launcher (launcher.ini, passed at Play): "cpu", the port's own drawing as in
+        // 0.0.7, or "gpu <scale>", PCSX2's GS inside the game's window. It counts over the tests' gpu file.
+        if (const char *g = std::getenv("SOR_GRAPHICS"))
+        {
+            float up = 0.0f;
+            int api = 1; // optional: "gpu <scale> <api>", 1 DX11, 2 DX12, 3 Vulkan, 4 OpenGL
+            if (std::sscanf(g, "gpu %f %d", &up, &api) < 1 || up < 1.0f)
+            {
+                std::fprintf(stderr, "[gpu] graphics: the processor (SOR_GRAPHICS=%s)\n", g);
+                return false;
+            }
+            on = true;
+            s_upscale = up;
+            s_renderer = (api >= 1 && api <= 4) ? api : 1;
+            s_attach = 1;
+        }
+        else
+        {
+            if (const char *e = std::getenv("SOR_GPU"))
+                on = e[0] == '1';
+            if (FILE *f = std::fopen((dir + "gpu").c_str(), "rb"))
+            {
+                on = true;
+                char line[64] = {};
+                if (std::fgets(line, sizeof(line), f)) // optional: "<upscale> <renderer> <attach>"
+                    std::sscanf(line, "%f %d %d", &s_upscale, &s_renderer, &s_attach);
+                std::fclose(f);
+            }
+        }
+        if (!on)
+            return false;
+        HMODULE dll = LoadLibraryA((dir + "sor-gs.dll").c_str());
+        if (!dll)
+        {
+            std::fprintf(stderr, "[gpu] sor-gs.dll not found (%lu)\n", GetLastError());
+            return false;
+        }
+        s_open = reinterpret_cast<OpenFn>(GetProcAddress(dll, "sorgs_open"));
+        s_regs = reinterpret_cast<RegsFn>(GetProcAddress(dll, "sorgs_regs"));
+        s_gif = reinterpret_cast<GifFn>(GetProcAddress(dll, "sorgs_gif"));
+        s_vsync = reinterpret_cast<VsyncFn>(GetProcAddress(dll, "sorgs_vsync"));
+        s_snap = reinterpret_cast<SnapFn>(GetProcAddress(dll, "sorgs_snapshot"));
+        s_close = reinterpret_cast<CloseFn>(GetProcAddress(dll, "sorgs_close"));
+        s_shownFn = reinterpret_cast<ShownFn>(GetProcAddress(dll, "sorgs_frames_shown"));
+        s_wideFn = reinterpret_cast<void (*)(int)>(GetProcAddress(dll, "sorgs_wide"));
+        s_sorPaceFn.store(reinterpret_cast<long long (*)(unsigned int)>(GetProcAddress(dll, "sorgs_pace")));
+        if (!s_open || !s_regs || !s_gif || !s_vsync)
+            return false;
+        s_state = 1;
+        std::fprintf(stderr, "[gpu] sor-gs.dll loaded, upscale %.1f renderer %d\n", s_upscale, s_renderer);
+        return true;
+#else
+        return false;
+#endif
+    }
+
+    bool readyUnlocked()
+    {
+        if (!enabledUnlocked())
+            return false;
+        if (!s_opened)
+        {
+            void *hwnd = s_attach ? GetWindowHandle() : nullptr;
+            if (s_attach && !hwnd)
+            {
+                ++s_dropped;
+                return false;
+            }
+            if (!s_open(hwnd, s_upscale, s_renderer))
+            {
+                std::fprintf(stderr, "[gpu] sorgs_open failed, back to the CPU drawing\n");
+                s_state = -1;
+                return false;
+            }
+            s_opened = true;
+            s_drawsWindow.store(s_attach != 0 && !std::getenv("SOR_GPU_CPU_DRAW"), std::memory_order_release);
+            std::atexit(sorGpuMirrorClose);
+            std::fprintf(stderr, "[gpu] PCSX2 GS open (%llu packets before the window)\n", s_dropped);
+        }
+        return true;
+    }
+
+    void put64(uint64_t v) { const size_t n = s_buf.size(); s_buf.resize(n + 8); std::memcpy(&s_buf[n], &v, 8); }
+
+    // GIFtag: nloop, eop=1, flg, nreg, regs.
+    void tag(uint32_t nloop, uint32_t flg, uint32_t nreg, uint64_t regs)
+    {
+        put64(static_cast<uint64_t>(nloop & 0x7FFFu) | (1ull << 15) | (static_cast<uint64_t>(flg & 3u) << 58) |
+              (static_cast<uint64_t>(nreg & 15u) << 60));
+        put64(regs);
+    }
+}
+
+bool sorGpuMirrorOn()
+{
+    std::lock_guard<std::recursive_mutex> lk(s_lock);
+    return enabledUnlocked();
+}
+
+bool sorGpuDrawsWindow()
+{
+    return s_drawsWindow.load(std::memory_order_acquire);
+}
+
+bool sorGpuFramesShown(uint64_t &shown)
+{
+    if (!s_drawsWindow.load(std::memory_order_acquire) || !s_shownFn)
+        return false;
+    shown = s_shownFn();
+    return true;
+}
+
+void sorGpuMirrorGif(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::lock_guard<std::recursive_mutex> lk(s_lock);
+    if (!data || sizeBytes < 16 || !readyUnlocked())
+        return;
+    s_gif(data, sizeBytes / 16u);
+}
+
+void sorGpuMirrorReg(uint8_t reg, uint64_t value)
+{
+    std::lock_guard<std::recursive_mutex> lk(s_lock);
+    if (!readyUnlocked())
+        return;
+    s_buf.clear();
+    tag(1, 0, 1, 0xE); // PACKED, A+D
+    put64(value);
+    put64(reg);
+    s_gif(s_buf.data(), static_cast<unsigned>(s_buf.size() / 16));
+}
+
+void sorGpuMirrorImage(uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir, const uint8_t *data,
+                       uint32_t sizeBytes)
+{
+    std::lock_guard<std::recursive_mutex> lk(s_lock);
+    if (!data || !sizeBytes || !readyUnlocked())
+        return;
+    s_buf.clear();
+    tag(4, 0, 1, 0xE);
+    put64(bitbltbuf); put64(0x50);
+    put64(trxpos); put64(0x51);
+    put64(trxreg); put64(0x52);
+    put64(trxdir); put64(0x53);
+    const uint32_t qwc = (sizeBytes + 15u) / 16u;
+    tag(qwc, 2, 0, 0); // IMAGE
+    const size_t n = s_buf.size();
+    s_buf.resize(n + static_cast<size_t>(qwc) * 16u, 0);
+    std::memcpy(&s_buf[n], data, sizeBytes);
+    s_gif(s_buf.data(), static_cast<unsigned>(s_buf.size() / 16));
+}
+
+void sorGpuMirrorVblank(const GSRegisters *priv)
+{
+    std::lock_guard<std::recursive_mutex> lk(s_lock);
+    if (!priv || !readyUnlocked())
+        return;
+    uint8_t *r = static_cast<uint8_t *>(s_regs());
+    // SMODE1 and SYNCV are written by the PS2 BIOS (SetGsCrt), which the recompiled game never runs: without them
+    // PCSX2 takes the screen for a VESA mode and shows nothing. Same values as the BIOS: PAL 0x740836504,
+    // NTSC 0x740834504 (only CMOD, the colour standard, matters to PCSX2), VFP odd = interlaced.
+    const bool pal = g_sorVblankUs.load(std::memory_order_relaxed) == 20000u;
+    const uint64_t smode1 = priv->smode1 ? priv->smode1 : (pal ? 0x740836504ull : 0x740834504ull);
+    const uint64_t syncv = priv->syncv ? priv->syncv
+                                       : (pal ? (1ull | (5ull << 10) | (33ull << 20) | (5ull << 32) | (576ull << 42) | (5ull << 53))
+                                              : (1ull | (6ull << 10) | (26ull << 20) | (6ull << 32) | (480ull << 42) | (6ull << 53)));
+    // The game copies each finished frame into the display buffer with the alpha channel masked, so the display
+    // keeps the alpha left there before: on the PS2 the movies leave 0x80 (opaque, x2 = 1.0 with PMODE.MMOD 0).
+    // Here the movies are skipped and that alpha stays 0, which PCSX2 shows as a black screen (the CPU drawing
+    // ignores it). So with circuit 1 alone and MMOD 0, the same picture: constant alpha 1.0 (MMOD 1, ALP 0xFF).
+    uint64_t pmode = priv->pmode;
+    if ((pmode & 0x23ull) == 0x01ull)
+        pmode = (pmode & ~0xFF00ull) | 0x20ull | 0xFF00ull;
+    const uint64_t v[15] = {pmode, smode1, priv->smode2, priv->srfsh, priv->synch1, priv->synch2,
+                            syncv, priv->dispfb1, priv->display1, priv->dispfb2, priv->display2, priv->extbuf,
+                            priv->extdata, priv->extwrite, priv->bgcolor};
+    static bool s_told = false;
+    if (!s_told && priv->pmode)
+    {
+        s_told = true;
+        std::fprintf(stderr, "[gpu] display: pmode %llx smode2 %llx dispfb1 %llx display1 %llx dispfb2 %llx display2 %llx\n",
+                     (unsigned long long)priv->pmode, (unsigned long long)priv->smode2, (unsigned long long)priv->dispfb1,
+                     (unsigned long long)priv->display1, (unsigned long long)priv->dispfb2, (unsigned long long)priv->display2);
+    }
+    for (int i = 0; i < 15; ++i)
+        std::memcpy(r + i * 0x10, &v[i], 8);
+    const uint64_t csr = priv->csr.load(std::memory_order_relaxed);
+    std::memcpy(r + 0x1000, &csr, 8);
+    std::memcpy(r + 0x1010, &priv->imr, 8);
+    s_field ^= 1u;
+    // Widescreen: the films, the pause menu and the title menus stay 4:3 with black bars (they call sorFourThree(),
+    // pc/main_sor.cpp), and so do the game's own scenes (a camera view with no gameplay camera in it for a quarter
+    // of a second: sorCameraView without sorWideCamera). The rest is wide once the gameplay camera has made 8 views
+    // after them: talks and tutorial pages freeze the game with the wide view on screen and make no view, so they
+    // stay wide. Wide again a quarter of a second after the last 4:3 view, so that a menu does not flash.
+    {
+        extern bool sorWidescreenOn();
+        extern std::atomic<unsigned> g_sorWideCamera;
+        extern std::atomic<unsigned> g_sorFourThree;
+        extern std::atomic<unsigned> g_sorCameraAny;
+        static unsigned s_seen = 0, s_seen43 = 0, s_seenAny = 0, s_uses = 0;
+        static unsigned long long s_last43 = 0, s_lastGame = 0;
+        static int s_sent = -1;
+        static unsigned s_secGame = 0, s_secOther = 0, s_sec43 = 0;
+        const unsigned m = g_sorFourThree.load(std::memory_order_relaxed);
+        const unsigned n = g_sorWideCamera.load(std::memory_order_relaxed);
+        const unsigned a = g_sorCameraAny.load(std::memory_order_relaxed);
+        const bool four = m != s_seen43, game = n != s_seen, other = a != s_seenAny && !game;
+        s_seen43 = m;
+        s_seen = n;
+        s_seenAny = a;
+        if (four) { s_last43 = s_frames; s_uses = 0; ++s_sec43; }
+        else if (game) { s_lastGame = s_frames; if (s_uses < 1000u) ++s_uses; ++s_secGame; }
+        else if (other) { ++s_secOther; if (s_frames - s_lastGame >= 15) s_uses = 0; }
+        const int wide = sorWidescreenOn() && s_uses >= 8 && s_frames - s_last43 >= 15 ? 1 : 0;
+        static const bool s_tempi = std::getenv("SOR_TEMPI") != nullptr;
+        if (s_wideFn && sorWidescreenOn() && wide != s_sent)
+        {
+            s_sent = wide;
+            s_wideFn(wide);
+            if (s_tempi)
+            {
+                std::printf("[wide] frame %llu: %s\n", s_frames, wide ? "wide" : "4:3");
+                std::fflush(stdout);
+            }
+        }
+        if (s_tempi && sorWidescreenOn() && s_frames % 60 == 59)
+        {   // each second: frames with the gameplay camera, with another camera only, with a 4:3 view
+            std::printf("[wide] second %llu: game %u, other %u, 4:3 %u, %s\n", s_frames / 60, s_secGame, s_secOther, s_sec43, wide ? "wide" : "4:3");
+            s_secGame = s_secOther = s_sec43 = 0;
+        }
+    }
+    s_vsync(s_field);
+    ++s_frames; // the GS window pumps its own messages on its own thread (sor-gs.dll)
+    // test: SOR_GPU_SNAP_EVERY=300 -> gpu-300.png, gpu-600.png... next to sor.exe
+    static const unsigned long long s_every = std::getenv("SOR_GPU_SNAP_EVERY") ? std::strtoull(std::getenv("SOR_GPU_SNAP_EVERY"), nullptr, 10) : 0;
+    if (s_snap && s_every && s_frames % s_every == 0)
+        s_snap((s_dir + "gpu-" + std::to_string(s_frames) + ".png").c_str());
+}
+
+void sorGpuMirrorClose()
+{
+    std::lock_guard<std::recursive_mutex> lk(s_lock);
+    if (!s_opened || !s_close)
+        return;
+    s_opened = false;
+    s_drawsWindow.store(false, std::memory_order_release);
+    s_state = -1;
+    s_close();
+}
