diff --git a/pcsx2/GS/SorGsTimes.h b/pcsx2/GS/SorGsTimes.h
new file mode 100644
index 0000000..0a5f2e6
--- /dev/null
+++ b/pcsx2/GS/SorGsTimes.h
@@ -0,0 +1,24 @@
+#pragma once
+// sor-gs timing (10/11/2026): where a picture loses its time on the GS thread. Plain counters: only the GS thread
+// writes them (the DX12 device, the texture pool, GSRenderer::VSync) and reads them (sor-gs/SorGS.cpp, after each
+// picture; SOR_TEMPI=1, the launcher's SPEED TESTS > TIMINGS, prints them). Defined in GSDevice.cpp.
+#include <chrono>
+#include <cstdint>
+
+struct SorGsTimes
+{
+	int64_t fence_wait_ns = 0; // GSDevice12::WaitForFence: the CPU waiting for the GPU to finish older work
+	uint32_t fence_waits = 0;  // ... the waits longer than 0.1 ms
+	int64_t present_ns = 0;    // the swap chain's Present call (DX12)
+	int64_t pipeline_ns = 0;   // draw pipelines new in this session (DX12 CreateTFXPipeline: from the cache or compiled)
+	uint32_t pipelines = 0;
+	int64_t surface_ns = 0;    // textures and render targets the pool did not have (GSDevice::FetchSurface)
+	uint32_t surfaces = 0;
+	double gpu_ms_total = 0.0; // GPU time PCSX2 read at each present (its timestamp queries; lags 1-3 pictures)
+};
+extern SorGsTimes g_sor_gs_times;
+
+inline int64_t SorGsNowNs()
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
