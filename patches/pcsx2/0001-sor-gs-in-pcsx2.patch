+// sor-gs debug view (Shadow of Rome port): binds the wire rasterizer state (made on first use from m_rs, so it is
+// the same in all but the fill mode) or puts the normal one back. Returns true if the wire state is now bound.
+bool GSDevice11::SetWireframe(bool on)
+{
+	static bool s_wire_failed = false;
+	if (on && !m_rs_wire && m_rs && !s_wire_failed)
+	{
+		D3D11_RASTERIZER_DESC rd;
+		m_rs->GetDesc(&rd);
+		rd.FillMode = D3D11_FILL_WIREFRAME;
+		if (FAILED(m_dev->CreateRasterizerState(&rd, m_rs_wire.put())))
+		{
+			Console.Error("D3D11: Failed to create the wireframe rasterizer state.");
+			m_rs_wire.reset();
+			s_wire_failed = true;
+		}
+	}
+	const bool wire = on && m_rs_wire;
+	m_ctx->RSSetState(wire ? m_rs_wire.get() : m_rs.get());
+	return wire;
+}
