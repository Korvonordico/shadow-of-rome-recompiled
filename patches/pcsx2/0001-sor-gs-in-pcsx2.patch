+		SorDrawHPO(GS_PRIM_CLASS primclass, bool tme_fst)
+		{
+			static const int s_mode2 = SorEnvDigit("SORGS_HALFPIXEL2", 0, 5, -1);
+			static const int s_parts = SorEnvDigit("SORGS_HALFPIXEL2_PARTS", 0, 7, 7);
+			static const int s_draws = SorEnvDigit("SORGS_HALFPIXEL2_DRAWS", 0, 4, 0);
+			const GSHalfPixelOffset global = GSConfig.UserHacks_HalfPixelOffset;
+			const bool triangle = primclass == GS_TRIANGLE_CLASS;
+			const bool is_3d = triangle && !tme_fst;
+			const bool pick = s_mode2 >= 0 && g_sor_hpo2_on && (s_draws == 0 ? is_3d : s_draws == 1 ? triangle : s_draws == 2 ? true :
+				s_draws == 3 ? primclass == GS_SPRITE_CLASS : !is_3d);
+			const GSHalfPixelOffset mode = pick ? static_cast<GSHalfPixelOffset>(s_mode2) : global;
+			s_sor_hpo_vs = (s_parts & 1) ? mode : global;
+			g_sor_hpo_tc = (s_parts & 2) ? mode : global;
+			s_sor_hpo_tex = (s_parts & 4) ? mode : global;
+		}
+		~SorDrawHPO() { SorResetHPO(); }
+	};
