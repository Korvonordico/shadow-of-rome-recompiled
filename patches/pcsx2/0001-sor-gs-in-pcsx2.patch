+// Shadow of Rome port (sor-gs.dll): there is no VM, so no disc serial; the DLL names the game in SORGS_SERIAL.
+static std::string SorSerial()
+{
+	std::string s = VMManager::GetDiscSerial();
+	if (s.empty())
+		if (const char* e = std::getenv("SORGS_SERIAL"))
+			s = e;
+	return s;
+}
