+// sor-gs (10/11/2026): every draw pipeline made in a session is written to cache/sor_tfx_pipelines.bin (its 32-byte
+// selector); at the next start they are all made at once, before the game draws. Before this, the first time a scene
+// used them cost 20-160 ms in the middle of play (49 pipelines at a scene start: 36-44 ms; 4 of them once: 157 ms),
+// even with PCSX2's pipeline cache on disk. At most 6000 kept; selectors whose pipeline cannot be made are skipped.
+static std::string SorTfxListPath()
+{
+	return Path::Combine(EmuFolders::Cache, "sor_tfx_pipelines.bin");
+}
+
+void GSDevice12::SorPreloadTfxPipelines()
+{
+	const std::string path = SorTfxListPath();
+	std::vector<PipelineSelector> list;
+	if (std::FILE* f = FileSystem::OpenCFile(path.c_str(), "rb"))
+	{
+		PipelineSelector p;
+		while (list.size() < 6000 && std::fread(&p, sizeof(p), 1, f) == 1)
+			list.push_back(p);
+		std::fclose(f);
+	}
+	const int64_t t0 = SorGsNowNs();
+	std::unordered_set<PipelineSelector, PipelineSelectorHash> kept;
+	u32 made = 0, failed = 0;
+	for (const PipelineSelector& p : list)
+	{
+		if (!kept.insert(p).second || m_tfx_pipelines.find(p) != m_tfx_pipelines.end())
+			continue;
+		ComPtr<ID3D12PipelineState> pipeline(CreateTFXPipeline(p));
+		if (!pipeline)
+		{
+			kept.erase(p);
+			failed++;
+			continue;
+		}
+		m_tfx_pipelines.emplace(p, std::move(pipeline));
+		made++;
+	}
+	// The list is written again without doubles or failures, then new ones are added at the end.
+	s_sor_tfx_list = FileSystem::OpenCFile(path.c_str(), "wb");
+	s_sor_tfx_listed = 0;
+	if (s_sor_tfx_list)
+	{
+		for (const auto& it : m_tfx_pipelines)
+			if (std::fwrite(&it.first, sizeof(it.first), 1, s_sor_tfx_list) == 1)
+				s_sor_tfx_listed++;
+		std::fflush(s_sor_tfx_list);
+	}
+	std::fprintf(stderr, "[sor-gs] draw pipelines made at start: %u in %.0f ms (%u could not be made, %u in the list)\n",
+		made, static_cast<double>(SorGsNowNs() - t0) / 1e6, failed, static_cast<u32>(list.size()));
+	std::fflush(stderr);
+}
+
 const ID3D12PipelineState* GSDevice12::GetTFXPipeline(const PipelineSelector& p)
 {
 	auto it = m_tfx_pipelines.find(p);
 	if (it != m_tfx_pipelines.end())
 		return it->second.get();
 
+	const int64_t sor_pipe0 = SorGsNowNs(); // sor-gs timing: a pipeline new in this session
 	ComPtr<ID3D12PipelineState> pipeline(CreateTFXPipeline(p));
+	g_sor_gs_times.pipeline_ns += SorGsNowNs() - sor_pipe0;
+	g_sor_gs_times.pipelines++;
+	if (pipeline && s_sor_tfx_list && s_sor_tfx_listed < 6000 && std::fwrite(&p, sizeof(p), 1, s_sor_tfx_list) == 1)
+	{
+		s_sor_tfx_listed++;
+		std::fflush(s_sor_tfx_list);
+	}
 	it = m_tfx_pipelines.emplace(p, std::move(pipeline)).first;
 	return it->second.get();
 }
