+static int SorEnvDigit(const char* name, int lo, int hi, int def)
+{
+	const char* v = std::getenv(name);
+	return (v && v[0] >= '0' + lo && v[0] <= '0' + hi) ? v[0] - '0' : def;
+}
+
+static void SorResetHPO()
+{
+	s_sor_hpo_vs = s_sor_hpo_tex = g_sor_hpo_tc = GSConfig.UserHacks_HalfPixelOffset;
+}
+
+namespace
+{
+	// Sets the modes for one draw and puts the global one back when the draw ends (any return path).
+	struct SorDrawHPO
